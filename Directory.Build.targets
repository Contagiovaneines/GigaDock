<Project>
  <Target Name="GigaDockSignBundle" BeforeTargets="GenerateSingleFileBundle" DependsOnTargets="PrepareForBundle"
          Condition="'$(GigaDockSigning)' == 'true' and '$(PublishSingleFile)' == 'true'">
    <Error Condition="'$(CodeSigningThumbprint)' == ''" Text="Informe o certificado (CodeSigningThumbprint)." />
    <PropertyGroup><GigaDockSignedDir>$(IntermediateOutputPath)signed-bundle\</GigaDockSignedDir></PropertyGroup>
    <ItemGroup>
      <GigaDockToSign Include="@(FilesToBundle)" Condition="'%(FilesToBundle.Extension)' == '.dll' and ($([System.String]::Copy('%(FilesToBundle.Filename)').StartsWith('DockWindows.')) or '%(FilesToBundle.Filename)' == 'GigaDock.Services' or '%(FilesToBundle.Filename)' == 'GigaDock-Setup' or '%(FilesToBundle.Filename)' == 'Ical.Net' or '%(FilesToBundle.Filename)' == 'NodaTime')" />
    </ItemGroup>
    <MakeDir Directories="$(GigaDockSignedDir)" />
    <Copy SourceFiles="@(GigaDockToSign)" DestinationFiles="@(GigaDockToSign->'$(GigaDockSignedDir)%(Filename)%(Extension)')" />
    <Exec Command="powershell.exe -ExecutionPolicy Bypass -Command &quot;$cert = Get-Item 'Cert:\CurrentUser\My\$(CodeSigningThumbprint)'; Set-AuthenticodeSignature -Certificate $cert -FilePath '$(GigaDockSignedDir)%(GigaDockToSign.Filename)%(GigaDockToSign.Extension)' -HashAlgorithm SHA256&quot;" Condition="'@(GigaDockToSign)' != ''" />
    <ItemGroup>
      <FilesToBundle Remove="@(GigaDockToSign)" />
      <FilesToBundle Include="@(GigaDockToSign->'$(GigaDockSignedDir)%(Filename)%(Extension)')"><RelativePath>%(GigaDockToSign.RelativePath)</RelativePath></FilesToBundle>
    </ItemGroup>
  </Target>
</Project>
