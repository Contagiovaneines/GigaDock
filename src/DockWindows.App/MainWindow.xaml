<Window x:Class="DockWindows.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:DockWindows.App.Converters"
        xmlns:vm="clr-namespace:DockWindows.App.ViewModels"
        xmlns:sections="clr-namespace:DockWindows.App.Views.Sections"
        Icon="Assets/gigadock.ico"
        Title="GigaDock"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="{Binding SempreNoTopo}"
        SizeToContent="WidthAndHeight"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Views/Themes/AreiaTheme.xaml"/></ResourceDictionary.MergedDictionaries>
        <conv:ColorToBrushConverter x:Key="ColorToBrushConverter"/>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InvertBoolToVis"/>

        <!-- Estilo base dos botões de item -->
        <Style x:Key="DockItemButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle">
                <Setter.Value>
                    <Style>
                        <Setter Property="Control.Template">
                            <Setter.Value>
                                <ControlTemplate>
                                    <Border BorderBrush="#58A6FF" BorderThickness="2" CornerRadius="12" Margin="-2"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ItemBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <Grid RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="ItemScale" ScaleX="1.0" ScaleY="1.0"/>
                                </Grid.RenderTransform>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding DataContext.EhAreia, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FAFFFFFF"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#E2D8C9"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2EFFFFFF"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#55FFFFFF"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ItemScale" Storyboard.TargetProperty="ScaleX"
                                                             To="1.18" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="ItemScale" Storyboard.TargetProperty="ScaleY"
                                                             To="1.18" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ItemScale" Storyboard.TargetProperty="ScaleX"
                                                             To="1.0" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="ItemScale" Storyboard.TargetProperty="ScaleY"
                                                             To="1.0" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions><Condition Binding="{Binding DataContext.EhAreia, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/><Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/></MultiDataTrigger.Conditions>
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FFFFFF"/><Setter TargetName="ItemBorder" Property="BorderBrush" Value="#B7A68C"/>
                            </MultiDataTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#4AFFFFFF"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ItemScale" Storyboard.TargetProperty="ScaleX"
                                                             To="0.95" Duration="0:0:0.08">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="ItemScale" Storyboard.TargetProperty="ScaleY"
                                                             To="0.95" Duration="0:0:0.08">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Context menu dos itens fixados -->
        <ContextMenu x:Key="ItemContextMenu" Background="#1E1E22" Foreground="#FFFFFF" BorderBrush="#33333A">
            <MenuItem Header="🚀 Abrir / Executar" Command="{Binding ExecutarCommand}" FontWeight="Bold"/>
            <MenuItem Header="📁 Abrir Local do Arquivo" Command="{Binding AbrirLocalCommand}"/>
            <Separator Background="#33333A"/>
            <MenuItem Header="⬅️ Mover para a Esquerda" Command="{Binding MoverEsquerdaCommand}"/>
            <MenuItem Header="➡️ Mover para a Direita" Command="{Binding MoverDireitaCommand}"/>
            <Separator Background="#33333A"/>
            <MenuItem Header="✏️ Editar Item..." Command="{Binding EditarCommand}"/>
            <MenuItem Header="🗑️ Desafixar do Ambiente" Command="{Binding RemoverCommand}"/>
        </ContextMenu>
    </ResourceDictionary>
    </Window.Resources>

    <!-- Container geral com margem compacta para renderizar o DropShadow suavemente -->
    <StackPanel Margin="{Binding MargemDock}" Name="MainGrid" VerticalAlignment="Bottom">
        
        <!-- Mascote percorre a borda superior da dock -->
        <sections:SectionMascotePokemonInline Visibility="{Binding MascotePokemon.Habilitado, Converter={StaticResource BoolToVis}}"
                                              HorizontalAlignment="Stretch" Margin="0,0,0,-2" />
                                              
        <Grid>
          
          <!-- OVERLAY DE ALERTA (PISCA QUANDO RECEBE CHAMADA/MSG) -->
          <Border x:Name="GlowAlertBorder" CornerRadius="{Binding RaioCantosDock}"
                  BorderThickness="2"
                  Padding="0"
                  Height="{Binding AlturaBarra}"
                  BorderBrush="{Binding CorAlerta, Converter={StaticResource ColorToBrushConverter}}"
                  Visibility="{Binding EstaEmAlerta, Converter={StaticResource BoolToVis}}"
                  IsHitTestVisible="False">
              <Border.Background>
                  <!-- Um leve gradiente colorido no fundo -->
                  <SolidColorBrush Color="{Binding CorAlertaMedia}" Opacity="0.15"/>
              </Border.Background>
              <Border.Style>
                  <Style TargetType="Border">
                      <Setter Property="Opacity" Value="0"/>
                      <Style.Triggers>
                          <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding EstaEmAlerta}" Value="True"/><Condition Binding="{Binding VisualAtivo}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Opacity" Value="0.78"/></MultiDataTrigger>
                          <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding EstaEmAlerta}" Value="True"/><Condition Binding="{Binding DataContext.AnimacoesAtivas, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/><Condition Binding="{Binding IsVisible, RelativeSource={RelativeSource Self}}" Value="True"/></MultiDataTrigger.Conditions>
                              <MultiDataTrigger.EnterActions>
                                  <BeginStoryboard Name="AlertAnim">
                                      <Storyboard RepeatBehavior="Forever">
                                          <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.58" To="0.82" Duration="0:0:1.0" AutoReverse="True">
                                              <DoubleAnimation.EasingFunction>
                                                  <SineEase EasingMode="EaseInOut"/>
                                              </DoubleAnimation.EasingFunction>
                                          </DoubleAnimation>
                                      </Storyboard>
                                  </BeginStoryboard>
                              </MultiDataTrigger.EnterActions>
                              <MultiDataTrigger.ExitActions>
                                  <RemoveStoryboard BeginStoryboardName="AlertAnim"/>
                              </MultiDataTrigger.ExitActions>
                          </MultiDataTrigger>
                      </Style.Triggers>
                  </Style>
              </Border.Style>
          </Border>

          <!-- Halo RGB: contorno nítido abaixo reutiliza o mesmo pincel animado. -->
            <Border x:Name="RainbowGlowBorder" IsHitTestVisible="False" CornerRadius="{Binding RaioCantosDock}"
                    Margin="-2" VerticalAlignment="Center" Height="{Binding AlturaBarra}"
                    BorderThickness="5"
                    Visibility="{Binding GlowRgbVisivel, Converter={StaticResource BoolToVis}}">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <LinearGradientBrush.RelativeTransform>
                            <RotateTransform x:Name="RainbowRotate" CenterX="0.5" CenterY="0.5" Angle="0"/>
                        </LinearGradientBrush.RelativeTransform>
                        <GradientStop Color="#FF3355" Offset="0.0"/>
                        <GradientStop Color="#FF20D6" Offset="0.14"/>
                        <GradientStop Color="#7044FF" Offset="0.28"/>
                        <GradientStop Color="#1677FF" Offset="0.42"/>
                        <GradientStop Color="#00EFFF" Offset="0.56"/>
                        <GradientStop Color="#30FF70" Offset="0.70"/>
                        <GradientStop Color="#FFF000" Offset="0.84"/>
                        <GradientStop Color="#FF3355" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Border.Effect>
                    <BlurEffect Radius="8" KernelType="Gaussian"/>
                </Border.Effect>
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsVisible, RelativeSource={RelativeSource Self}}" Value="True"/>
                                    <Condition Binding="{Binding AnimacoesAtivas}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <MultiDataTrigger.EnterActions>
                                    <BeginStoryboard Name="RainbowAnimation">
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="BorderBrush.RelativeTransform.Angle" From="0" To="360" Duration="0:0:3"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiDataTrigger.EnterActions>
                                <MultiDataTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="RainbowAnimation"/></MultiDataTrigger.ExitActions>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>

            <!-- BARRA PRINCIPAL FLUTUANTE (DOCK) -->
                <Border x:Name="DockBorder" CornerRadius="{Binding RaioCantosDock}"
                BorderThickness="1"
                Padding="0"
                Height="{Binding AlturaBarra}"
                Opacity="{Binding OpacidadeDock}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#50FFFFFF" Offset="0"/><GradientStop Color="#15FFFFFF" Offset="1"/></LinearGradientBrush></Setter.Value></Setter>
                    <Setter Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#85000000" Offset="0"/><GradientStop Color="#AA05050A" Offset="1"/></LinearGradientBrush></Setter.Value></Setter>
                    <Style.Triggers><DataTrigger Binding="{Binding EhAreia}" Value="True">
                        <Setter Property="Background" Value="{StaticResource AreiaDockBrush}"/>
                        <Setter Property="BorderBrush" Value="#D6C9B7"/>
                    </DataTrigger></Style.Triggers>
                </Style>
            </Border.Style>
            <Border.ContextMenu>
                <ContextMenu Background="#1E1E22" Foreground="#FFFFFF" BorderBrush="#33333A">
                    <MenuItem Header="Mudar de Ambiente" ItemsSource="{Binding Ambientes}">
                        <MenuItem.ItemContainerStyle>
                            <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                <Setter Property="Header" Value="{Binding Nome}"/>
                                <Setter Property="IsChecked" Value="{Binding EstaAtivo}"/>
                                <Setter Property="Command" Value="{Binding DataContext.TrocarAmbienteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <Setter Property="CommandParameter" Value="{Binding}"/>
                            </Style>
                        </MenuItem.ItemContainerStyle>
                    </MenuItem>
                    <Separator Background="#33333A"/>
                    <MenuItem Header="Ajustes e Personalização..." Command="{Binding AbrirAjustesCommand}" FontWeight="Bold"/>
                    <MenuItem Header="Sair do GigaDock" Command="{Binding SairCommand}"/>
                </ContextMenu>
            </Border.ContextMenu>
            <Border.Effect>
                <DropShadowEffect x:Name="DockShadow" BlurRadius="20" ShadowDepth="5" Direction="270" Color="{Binding CorSombraDock}" Opacity="{Binding SombraDockOpacity}"/>
            </Border.Effect>

            <Grid>
                

                <!-- Conteúdo da barra -->
                <Grid x:Name="DockContentGrid" Margin="10,0,10,0" VerticalAlignment="Center">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="ContentTransform" X="0" Y="0"/>
                    </Grid.RenderTransform>

                    <!-- A dock nunca ultrapassa a tela. Quando necessário, a roda
                         do mouse, gesto horizontal ou teclado navegam pelo conteúdo. -->
                    <ScrollViewer x:Name="DockSectionsScrollViewer"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled"
                                  PanningMode="HorizontalOnly"
                                  CanContentScroll="False"
                                  Focusable="True"
                                  PreviewMouseWheel="DockSectionsScrollViewer_OnPreviewMouseWheel"
                                  AutomationProperties.Name="Conteúdo da dock">
                        <StackPanel x:Name="SectionsContainer" Orientation="Horizontal" VerticalAlignment="Center"
                              RenderTransformOrigin="0.5,0.5">
                            <StackPanel.LayoutTransform>
                                <ScaleTransform ScaleX="{Binding EscalaUI}" ScaleY="{Binding EscalaUI}"/>
                            </StackPanel.LayoutTransform>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>

        <!-- Borda RGB acima da superfície: cor definida sem desfocar o conteúdo. -->
        <Border x:Name="RainbowOutlineBorder" IsHitTestVisible="False"
                CornerRadius="{Binding RaioCantosDock}" Height="{Binding AlturaBarra}"
                VerticalAlignment="Center" BorderThickness="2"
                BorderBrush="{Binding BorderBrush, ElementName=RainbowGlowBorder}"
                Visibility="{Binding GlowRgbVisivel, Converter={StaticResource BoolToVis}}"/>

        <Canvas x:Name="SeasonDecorationLayer" IsHitTestVisible="False" Height="{Binding AlturaBarra}" VerticalAlignment="Center" SizeChanged="Decoracao_OnSizeChanged"/>

        <!-- Contorno de alerta acima da dock e do RGB gamer. -->
        <Border IsHitTestVisible="False" CornerRadius="{Binding RaioCantosDock}" Height="{Binding AlturaBarra}" VerticalAlignment="Center" BorderThickness="2.5" BorderBrush="{Binding CorAlerta, Converter={StaticResource ColorToBrushConverter}}">
            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding EstaEmAlerta}" Value="True"/><Condition Binding="{Binding VisualAtivo}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></Border.Style>
        </Border>
    </Grid>
    </StackPanel>
</Window>











