<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>..\..\assets\gigadock.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\gigadock.ico" Link="Assets\gigadock.ico" />
    <ProjectReference Include="..\DockWindows.Core\DockWindows.Core.csproj" />
    <ProjectReference Include="..\DockWindows.Infrastructure\DockWindows.Infrastructure.csproj" />
  </ItemGroup>

</Project>


