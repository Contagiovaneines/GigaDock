<Window x:Class="DockWindows.App.Views.AjustesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:DockWindows.App.Converters"
        xmlns:models="clr-namespace:DockWindows.Core.Models;assembly=DockWindows.Core"
        xmlns:vm="clr-namespace:DockWindows.App.ViewModels"
        xmlns:views="clr-namespace:DockWindows.App.Views"
        Title="GigaDock — Ajustes e Configurações"
        Width="1080"
        Height="720"
        MinWidth="600"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="#101720"
        Foreground="#FFFFFF"
        FontFamily="Segoe UI"
        ResizeMode="CanResizeWithGrip"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
                <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="44" Height="24" VerticalAlignment="Center">
                                <Border x:Name="BgBorder" CornerRadius="12" Background="#21212B" BorderBrush="#2C2C36" BorderThickness="1"/>
                                <Border x:Name="Knob" Width="18" Height="18" CornerRadius="9" Background="#8E8E93" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0">
                                    <Border.RenderTransform>
                                        <TranslateTransform X="0" />
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BgBorder" Property="Background" Value="#0A84FF"/>
                                <Setter TargetName="BgBorder" Property="BorderBrush" Value="#0A84FF"/>
                                <Setter TargetName="Knob" Property="Background" Value="#FFFFFF"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="20" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                                                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="BgBorder" Property="BorderBrush" Value="#B3DCFF"/><Setter TargetName="BgBorder" Property="BorderThickness" Value="2"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
</ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <conv:ColorToBrushConverter x:Key="ColorToBrushConverter"/>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InvertBoolToVis"/>

        <!-- Estilo dos Botões da Barra Lateral de Navegação (Liquid Glass Sidebar SBR001) -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A0A0A8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="6,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" CornerRadius="8" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#18FFFFFF"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#25FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                                                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="BtnBorder" Property="BorderBrush" Value="#A6D5FF"/><Setter TargetName="BtnBorder" Property="BorderThickness" Value="2"/></Trigger>
</ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Tag" Value="True">
                    <Setter Property="Background" Value="#220A84FF"/>
                    <Setter Property="BorderBrush" Value="#4538BDF8"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo dos Botões Primários (Liquid Glass Button BTN003) -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0A84FF"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#60FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" CornerRadius="7" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#2997FF"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#90FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#0071E3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo dos Botões Secundários / Ícones -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#24242A"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#383842"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#32323A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo das Caixas de Texto -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#202026"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#383844"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ESTRUTURA PRINCIPAL EM 3 COLUNAS -->
    <Grid x:Name="LayoutRoot">
        <Grid.RowDefinitions><RowDefinition x:Name="CompactHeaderRow" Height="0"/><RowDefinition Height="*"/><RowDefinition x:Name="StackedDetailsRow" Height="0"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <!-- Coluna 1: Navegação Lateral -->
            <ColumnDefinition x:Name="NavigationColumn" Width="210"/>
            <!-- Coluna 2: Itens da Seção Selecionada -->
            <ColumnDefinition x:Name="MasterColumn" Width="290"/>
            <!-- Coluna 3: Edição e Detalhes do Item Selecionado -->
            <ColumnDefinition x:Name="DetailsColumn" Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ========================================================= -->
        <!-- COLUNA 1: NAVEGAÇÃO LATERAL                               -->
        <!-- ========================================================= -->
        <Border x:Name="NavigationPanel" Grid.Row="1" Grid.Column="0" Background="#121C28" BorderBrush="#26262C" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Cabeçalho do App -->
                    <RowDefinition Height="Auto"/>
                    <!-- Menu de Navegação -->
                    <RowDefinition Height="*"/>
                    <!-- Rodapé com Botão Concluir -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Cabeçalho: Identidade do GigaDock e Ambiente Ativo -->
                <Border Grid.Row="0" Padding="14,16,14,14" BorderBrush="#26262C" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="34" Height="34" CornerRadius="8" Background="#0A84FF" Margin="0,0,10,0">
                                <Image Source="/DockWindows.App;component/Assets/gigadock.ico" Width="26" Height="26"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="GigaDock" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock Text="{Binding AppVersao, StringFormat=Versão {0}}" FontSize="11" Foreground="#A9B8C9"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Indicador do Ambiente Ativo -->
                        <Border Margin="0,12,0,0" Padding="8,5" CornerRadius="6" Background="#1C1F26" BorderBrush="#2A303D" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Margin="0,0,7,0"
                                         Fill="{Binding AmbienteAtivo.CorHex, Converter={StaticResource ColorToBrushConverter}}"/>
                                <TextBlock Text="Ativo: " FontSize="11" Foreground="#A9B8C9"/>
                                <TextBlock Text="{Binding AmbienteAtivo.Nome}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Grupos de Navegação -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,10">
                        <!-- GRUPO PRINCIPAL -->
                        <TextBlock Text="PRINCIPAL" FontSize="10" FontWeight="Bold" Foreground="#92A6BC" Margin="16,8,0,4"/>

                                                <Button Style="{StaticResource NavButtonStyle}" Tag="{Binding EhSecaoAmbientes}" Command="{Binding NavegarCommand}" CommandParameter="Ambientes">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE7F4;" Margin="0,0,10,0" FontSize="16" VerticalAlignment="Center" Foreground="#0A84FF"/>
                                <TextBlock Text="Ambientes" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButtonStyle}" Tag="{Binding EhSecaoWidgets}" Command="{Binding NavegarCommand}" CommandParameter="Widgets">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE74C;" Margin="0,0,10,0" FontSize="16" VerticalAlignment="Center" Foreground="#FF9F0A"/>
                                <TextBlock Text="Widgets" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButtonStyle}" Tag="{Binding EhSecaoEspacadores}" Command="{Binding NavegarCommand}" CommandParameter="Espacadores">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE76F;" Margin="0,0,10,0" FontSize="16" VerticalAlignment="Center" Foreground="#32D74B"/>
                                <TextBlock Text="Divisores" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButtonStyle}" Tag="{Binding EhSecaoAparencia}" Command="{Binding NavegarCommand}" CommandParameter="Aparencia">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE790;" Margin="0,0,10,0" FontSize="16" VerticalAlignment="Center" Foreground="#BF5AF2"/>
                                <TextBlock Text="Aparência" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButtonStyle}" Tag="{Binding EhSecaoVisualizacoes}" Command="{Binding NavegarCommand}" CommandParameter="Visualizacoes">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="◫" Margin="0,0,10,0" FontSize="18" Foreground="#7EA8E5"/>
                                <TextBlock Text="Visualizações" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButtonStyle}" Tag="{Binding EhSecaoGeral}" Command="{Binding NavegarCommand}" CommandParameter="Geral">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE713;" Margin="0,0,10,0" FontSize="16" VerticalAlignment="Center" Foreground="#64D2FF"/>
                                <TextBlock Text="Geral" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButtonStyle}" Tag="{Binding EhSecaoUtilitarios}" Command="{Binding NavegarCommand}" CommandParameter="Utilitarios">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE90F;" Margin="0,0,10,0" FontSize="16" VerticalAlignment="Center" Foreground="#FF453A"/>
                                <TextBlock Text="Utilitários" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButtonStyle}" Tag="{Binding EhSecaoSobre}" Command="{Binding NavegarCommand}" CommandParameter="Sobre">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE946;" Margin="0,0,10,0" FontSize="16" VerticalAlignment="Center" Foreground="#94A3B8"/>
                                <TextBlock Text="Sobre" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- Rodapé -->
                <Border Grid.Row="2" Padding="12" BorderBrush="#26262C" BorderThickness="0,1,0,0">
                    <Button Style="{StaticResource PrimaryButtonStyle}" Content="Concluir e Fechar" Command="{Binding ConcluirCommand}" HorizontalAlignment="Stretch"/>
                </Border>
            </Grid>
        </Border>

        <!-- ========================================================= -->
        <!-- COLUNA 2: ITENS DA SEÇÃO (MASTER LIST)                    -->
        <!-- ========================================================= -->
        <Border x:Name="MasterPanel" Grid.Row="1" Grid.Column="1" Background="#152130" BorderBrush="#282830" BorderThickness="0,0,1,0">
            <Grid Margin="12,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 1. AMBIENTES (LISTA E CRUD) -->
                <StackPanel Grid.Row="0" Visibility="{Binding EhSecaoAmbientes, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Ambientes" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock Text="Selecione um ambiente para editar ou ativar" FontSize="11" Foreground="#A9B8C9" Margin="0,2,0,8"/>

                    <!-- Barra de Ações: + - Cima Baixo -->
                    <Border Background="#202026" CornerRadius="6" Padding="4" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="➕ Novo" Command="{Binding NovoAmbienteCommand}" Margin="2,0" ToolTip="Criar novo ambiente"/>
                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="➖ Excluir" Command="{Binding ExcluirAmbienteCommand}" Margin="2,0" ToolTip="Excluir ambiente selecionado"/>
                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="⬆️" Command="{Binding MoverAmbienteCimaCommand}" Margin="2,0" ToolTip="Mover para cima"/>
                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="⬇️" Command="{Binding MoverAmbienteBaixoCommand}" Margin="2,0" ToolTip="Mover para baixo"/>
                        </StackPanel>
                    </Border>

                    <Button Content="+ Biblioteca de Apps" Background="#0A84FF" Foreground="#FFFFFF" BorderThickness="0" FontSize="11" FontWeight="Bold" Padding="12,6" Command="{Binding AbrirGaleriaAppsCommand}" Cursor="Hand" Margin="0,0,0,10" ToolTip="Adicionar aplicativos instalados ao ambiente selecionado">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                    </Button>
                    <CheckBox Style="{StaticResource ToggleSwitchStyle}" Margin="0,0,0,10"
                              Content="Mostrar também apps abertos de outros ambientes"
                              ToolTip="Desligado: a dock mostra só os apps do ambiente ativo. Os outros continuam na barra de tarefas do Windows."
                              IsChecked="{Binding ExibirAppsAbertosNaoFixados}"/>
                </StackPanel>

                <ListBox Grid.Row="1" ItemsSource="{Binding Ambientes}"
                         SelectedValue="{Binding AmbienteSelecionado, Mode=TwoWay}"
                         SelectedValuePath="Model"
                         Background="Transparent" BorderThickness="0"
                         Visibility="{Binding EhSecaoAmbientes, Converter={StaticResource BoolToVis}}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,3"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Card" CornerRadius="8" Padding="10,8" Background="#202026" BorderBrush="#32323C" BorderThickness="1">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Card" Property="Background" Value="#2A2F3D"/>
                                                <Setter TargetName="Card" Property="BorderBrush" Value="#0A84FF"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Card" Property="Background" Value="#262630"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:EnvironmentViewModel}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="30" Height="30" CornerRadius="6"
                                        Background="{Binding CorHex, Converter={StaticResource ColorToBrushConverter}}" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding Icone}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Nome}" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                    <TextBlock Text="{Binding Itens.Count, StringFormat='{}{0} apps fixados'}" FontSize="11" Foreground="#A9B8C9"/>
                                </StackPanel>

                                <!-- Tag de Ativo -->
                                <Border Grid.Column="2" CornerRadius="4" Padding="6,2" Background="#0A84FF"
                                        Visibility="{Binding EstaAtivo, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center">
                                    <TextBlock Text="ATIVO" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                                                                                                <!-- 2. WIDGETS -->
                <StackPanel Grid.Row="0" Visibility="{Binding EhSecaoWidgets, Converter={StaticResource BoolToVis}}">
                    <StackPanel Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4" VerticalAlignment="Center">
                            <Border Background="#0A84FF" CornerRadius="8" Padding="6,4" Margin="0,0,12,0">
                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE721;" FontSize="16" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Widgets" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            
                            <Border Background="#21212B" CornerRadius="12" Padding="12,6" BorderBrush="#2C2C36" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="#636366" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding WidgetsAmbiente.Count, StringFormat='{}{0} de 9 ativos'}" FontSize="11" FontWeight="Bold" Foreground="#A9B8C9" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Button Content="+ Loja de Widgets" Background="#0A84FF" Foreground="#FFFFFF" BorderThickness="0" FontSize="11" FontWeight="Bold" Padding="12,6" Command="{Binding AbrirLojaWidgetsCommand}" Cursor="Hand" VerticalAlignment="Center">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="12"/></Style></Button.Resources>
                            </Button>
                        </StackPanel>
                        <TextBlock Text="Gerencie, reordene e personalize os widgets ativos exibidos na barra principal da dock." FontSize="12" Foreground="#A9B8C9" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Row="1" Visibility="{Binding EhSecaoWidgets, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <ListBox Grid.Row="0" ItemsSource="{Binding WidgetsAmbiente}"
                             SelectedItem="{Binding WidgetSelecionado, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Card" CornerRadius="12" Padding="12,16" Background="#16161C" BorderBrush="#1C1C22" BorderThickness="1">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Card" Property="Background" Value="#1C1C24"/>
                                                    <Setter TargetName="Card" Property="BorderBrush" Value="#252530"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Card" Property="Background" Value="#1A1A20"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type models:WidgetInstanceConfig}">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Drag Handles & Icon -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE700;" FontSize="14" Foreground="#333340" Margin="0,0,0,4"/>
                                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE700;" FontSize="14" Foreground="#333340"/>
                                    </StackPanel>
                                    
                                    <Border Grid.Column="1" Width="40" Height="40" CornerRadius="12" Background="#1C2E42" Margin="0,0,16,0" VerticalAlignment="Top">
                                        <TextBlock x:Name="IconeWidget" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE721;" FontSize="18" Foreground="#4AA1FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Details -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="{Binding Nome}" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,8,0"/>
                                            <Border Background="#252530" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                <TextBlock x:Name="Tag1" Text="Sistema" FontSize="9" Foreground="#A9B8C9"/>
                                            </Border>
                                            <Border Background="#252530" CornerRadius="4" Padding="6,2">
                                                <TextBlock x:Name="Tag2" Text="DirectX 12" FontSize="9" Foreground="#A9B8C9"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock x:Name="DescWidget" Text="Configurações avançadas deste widget (descrição simplificada)." FontSize="11" Foreground="#A9B8C9" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                        <Border Background="#202026" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left" BorderBrush="#2C2C36" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Formato, StringFormat='Formato: {0}'}" FontSize="10" Foreground="#C8C8CE" VerticalAlignment="Center"/>
                                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE70D;" FontSize="8" Foreground="#A9B8C9" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <Button Grid.Row="1" Grid.Column="2" HorizontalAlignment="Left" Margin="0,10,0,0" Content="Escolher estilo" Padding="8,4" Background="#253342" Foreground="White" Command="{Binding DataContext.EscolherEstiloWidgetCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                    <!-- Toggle -->
                                    <CheckBox Style="{StaticResource ToggleSwitchStyle}" Grid.Column="3" IsChecked="{Binding Visivel}" VerticalAlignment="Center" Margin="16,0,0,0"
                                              Command="{Binding DataContext.AlternarVisibilidadeWidgetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                              CommandParameter="{Binding}"/>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <!-- Relogio = 0 -->
                                    <DataTrigger Binding="{Binding Tipo}" Value="Relogio">
                                        <Setter TargetName="IconeWidget" Property="Text" Value="&#xE121;"/>
                                        <Setter TargetName="DescWidget" Property="Text" Value="Exibição de hora, fuso horário e data fluida."/>
                                        <Setter TargetName="Tag1" Property="Text" Value="Sistema"/>
                                    </DataTrigger>
                                    <!-- Pomodoro = 1 -->
                                    <DataTrigger Binding="{Binding Tipo}" Value="Pomodoro">
                                        <Setter TargetName="IconeWidget" Property="Text" Value="&#xE823;"/>
                                        <Setter TargetName="DescWidget" Property="Text" Value="Temporizador de foco de 25 minutos integrado."/>
                                        <Setter TargetName="Tag1" Property="Text" Value="Produtividade"/>
                                    </DataTrigger>
                                    <!-- GitHubContribuicoes = 6 -->
                                    <DataTrigger Binding="{Binding Tipo}" Value="GitHubContribuicoes">
                                        <Setter TargetName="IconeWidget" Property="Text" Value="&#xE90A;"/>
                                        <Setter TargetName="DescWidget" Property="Text" Value="Grade de atividade e sequência de commits diários."/>
                                        <Setter TargetName="Tag1" Property="Text" Value="Dev"/>
                                        <Setter TargetName="Tag2" Property="Text" Value="Web API"/>
                                    </DataTrigger>
                                    <!-- Clima = 7 -->
                                    <DataTrigger Binding="{Binding Tipo}" Value="Clima">
                                        <Setter TargetName="IconeWidget" Property="Text" Value="&#xE706;"/>
                                        <Setter TargetName="DescWidget" Property="Text" Value="Temperatura em tempo real e previsão de chuva."/>
                                        <Setter TargetName="Tag1" Property="Text" Value="Utilidade"/>
                                    </DataTrigger>
                                    <!-- WhatsAppNotificacoes = 8 -->
                                    <DataTrigger Binding="{Binding Tipo}" Value="WhatsAppNotificacoes">
                                        <Setter TargetName="IconeWidget" Property="Text" Value="&#xE8BD;"/>
                                        <Setter TargetName="DescWidget" Property="Text" Value="Notificações não lidas e atalho rápido."/>
                                        <Setter TargetName="Tag1" Property="Text" Value="Chat"/>
                                    </DataTrigger>
                                    <!-- TeamsStatus = 9 -->
                                    <DataTrigger Binding="{Binding Tipo}" Value="TeamsStatus">
                                        <Setter TargetName="IconeWidget" Property="Text" Value="&#xE716;"/>
                                        <Setter TargetName="DescWidget" Property="Text" Value="Status de presença em tempo real de reuniões."/>
                                        <Setter TargetName="Tag1" Property="Text" Value="Trabalho"/>
                                    </DataTrigger>
                                    <!-- OBSStudio = 11 -->
                                    <DataTrigger Binding="{Binding Tipo}" Value="OBSStudio">
                                        <Setter TargetName="IconeWidget" Property="Text" Value="&#xE714;"/>
                                        <Setter TargetName="DescWidget" Property="Text" Value="Inicie ou pare gravações na dock, com um clique."/>
                                        <Setter TargetName="Tag1" Property="Text" Value="Mídia"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    
                    
                </Grid>

                <!-- 3. ESPAÇADORES -->
                <StackPanel Grid.Row="0" Visibility="{Binding EhSecaoEspacadores, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Espaçadores" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock Text="Divisores visuais entre blocos do dock" FontSize="11" Foreground="#A9B8C9" Margin="0,2,0,8"/>

                    <Border Background="#202026" CornerRadius="6" Padding="4" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="➕ Adicionar" Command="{Binding NovoEspacadorCommand}" Margin="2,0"/>
                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="➖ Remover" Command="{Binding RemoverEspacadorCommand}" Margin="2,0"/>
                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="⬆️" Command="{Binding MoverEspacadorCimaCommand}" Margin="2,0"/>
                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="⬇️" Command="{Binding MoverEspacadorBaixoCommand}" Margin="2,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <ListBox Grid.Row="1" ItemsSource="{Binding Espacadores}"
                         SelectedItem="{Binding EspacadorSelecionado, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0"
                         Visibility="{Binding EhSecaoEspacadores, Converter={StaticResource BoolToVis}}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,3"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Card" CornerRadius="8" Padding="10,8" Background="#202026" BorderBrush="#32323C" BorderThickness="1">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Card" Property="Background" Value="#2A2F3D"/>
                                                <Setter TargetName="Card" Property="BorderBrush" Value="#0A84FF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:EspacadorConfig}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="↔️" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Nome}" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                    <TextBlock Text="{Binding Estilo, StringFormat='Estilo: {0}'}" FontSize="11" Foreground="#A9B8C9"/>
                                </StackPanel>

                                <TextBlock Grid.Column="2" Text="{Binding Largura, StringFormat='{}{0}px'}" FontSize="11" FontWeight="Bold" Foreground="#0A84FF" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 4. APARÊNCIA (TEMAS PRÉ-DEFINIDOS) -->
                <StackPanel Grid.Row="0" Visibility="{Binding EhSecaoAparencia, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Temas Visuais" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock Text="Escolha o estilo visual para o dock" FontSize="11" Foreground="#A9B8C9" Margin="0,2,0,10"/>
                </StackPanel>

                <ListBox Grid.Row="1" ItemsSource="{Binding TemasPredefinidos}"
                         SelectedItem="{Binding TemaSelecionado, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0"
                         Visibility="{Binding EhSecaoAparencia, Converter={StaticResource BoolToVis}}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,4"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Card" CornerRadius="8" Padding="10" Background="#202026" BorderBrush="#32323C" BorderThickness="1">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Card" Property="Background" Value="#282D3D"/>
                                                <Setter TargetName="Card" Property="BorderBrush" Value="#0A84FF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:TemaDefinicao}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Miniatura do tema -->
                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8"
                                        Background="{Binding CorMiniatura, Converter={StaticResource ColorToBrushConverter}}"
                                        BorderBrush="{Binding CorBordaMiniatura, Converter={StaticResource ColorToBrushConverter}}"
                                        BorderThickness="2" Margin="0,0,10,0"/>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Nome}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    <TextBlock Text="{Binding Descricao}" FontSize="11" Foreground="#A9B8C9" TextWrapping="Wrap" MaxHeight="32"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                </Grid>
        </Border>

        <!-- ========================================================= -->
        <!-- COLUNA 3: EDIÇÃO DO ITEM SELECIONADO                      -->
        <!-- ========================================================= -->
        <Border x:Name="DetailsPanel" Grid.Row="1" Grid.Column="2" Background="#101720">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,16">
                <!-- CONTEÚDO DINÂMICO CONFORME A SEÇÃO -->
                <Grid>
                    <!-- ================================================= -->
                    <!-- 1. PAINEL DE EDIÇÃO DO AMBIENTE                   -->
                    <!-- ================================================= -->
                    <StackPanel Visibility="{Binding EhSecaoAmbientes, Converter={StaticResource BoolToVis}}">
                        <!-- Título e Ação de Ativação -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding NomeAmbienteEditavel, StringFormat='Ambiente: {0}'}" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock Text="Configure a identidade, itens fixados e widgets deste ambiente" FontSize="11" Foreground="#A9B8C9" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" Content="Ativar na Barra"
                                    Command="{Binding AtivarAmbienteSelecionadoCommand}"
                                    Visibility="{Binding EstaAtivoAmbienteSelecionado, Converter={StaticResource InvertBoolToVis}}"/>
                        </Grid>

                        <!-- BLOCO: DADOS BÁSICOS DO AMBIENTE -->
                        <Border Background="#182432" BorderBrush="#2A3B50" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="IDENTIDADE VISUAL DO AMBIENTE" FontSize="11" FontWeight="Bold" Foreground="#92A6BC" Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Nome -->
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Nome do Ambiente:" FontSize="11" Foreground="#C8C8CE" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding NomeAmbienteEditavel, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>

                                    <!-- Ícone -->
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Ícone (Emoji):" FontSize="11" Foreground="#C8C8CE" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding IconeAmbienteEditavel, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Cor do Ambiente -->
                                <TextBlock Text="Cor de Destaque:" FontSize="11" Foreground="#C8C8CE" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBox Text="{Binding CorAmbienteEditavel, UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="0,0,10,0"/>
                                    <Button Width="22" Height="22" Margin="3,0" Background="#0078D4" Command="{Binding DefinirCorAmbienteCommand}" CommandParameter="#0078D4" BorderThickness="0" Cursor="Hand"/>
                                    <Button Width="22" Height="22" Margin="3,0" Background="#107C41" Command="{Binding DefinirCorAmbienteCommand}" CommandParameter="#107C41" BorderThickness="0" Cursor="Hand"/>
                                    <Button Width="22" Height="22" Margin="3,0" Background="#8764B8" Command="{Binding DefinirCorAmbienteCommand}" CommandParameter="#8764B8" BorderThickness="0" Cursor="Hand"/>
                                    <Button Width="22" Height="22" Margin="3,0" Background="#D83B01" Command="{Binding DefinirCorAmbienteCommand}" CommandParameter="#D83B01" BorderThickness="0" Cursor="Hand"/>
                                    <Button Width="22" Height="22" Margin="3,0" Background="#00B7C3" Command="{Binding DefinirCorAmbienteCommand}" CommandParameter="#00B7C3" BorderThickness="0" Cursor="Hand"/>
                                    <Button Width="22" Height="22" Margin="3,0" Background="#FFB900" Command="{Binding DefinirCorAmbienteCommand}" CommandParameter="#FFB900" BorderThickness="0" Cursor="Hand"/>
                                    <Button Width="22" Height="22" Margin="3,0" Background="#E74856" Command="{Binding DefinirCorAmbienteCommand}" CommandParameter="#E74856" BorderThickness="0" Cursor="Hand"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- BLOCO: INDICADOR DE APPS ABERTOS -->
                        <Border Background="#182432" BorderBrush="#2A3B50" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="INDICADOR DE APLICATIVOS ABERTOS" FontSize="11" FontWeight="Bold" Foreground="#92A6BC" Margin="0,0,0,8"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Estilo do Indicador -->
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Formato do Indicador:" FontSize="11" Foreground="#C8C8CE" Margin="0,0,0,4"/>
                                        <ComboBox SelectedValue="{Binding EstiloIndicadorAppsEditavel, Mode=TwoWay}"
                                                  SelectedValuePath="Content" Background="#202026" Foreground="#FFFFFF" Padding="6,4">
                                            <ComboBoxItem Content="Barra"/>
                                            <ComboBoxItem Content="Ponto"/>
                                            <ComboBoxItem Content="Pílula"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Cor do Indicador -->
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Cor do Indicador:" FontSize="11" Foreground="#C8C8CE" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding CorIndicadorAppsEditavel, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- BLOCO: APLICATIVOS E ITENS FIXADOS -->
                        <Border Background="#182432" BorderBrush="#2A3B50" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="APLICATIVOS E ATALHOS DO AMBIENTE" FontSize="11" FontWeight="Bold" Foreground="#92A6BC" Margin="0,0,0,8"/>

                                <!-- Barra com botões de adicionar -->
                                <WrapPanel Margin="0,0,0,10">
                                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="➕ App (.exe / .lnk)" Command="{Binding AdicionarAppExecutavelCommand}" Margin="0,0,6,6"/>
                                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="➕ Arquivo" Command="{Binding AdicionarArquivoCommand}" Margin="0,0,6,6"/>
                                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="➕ Pasta" Command="{Binding AdicionarPastaCommand}" Margin="0,0,6,6"/>
                                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="➕ Site / URL" Command="{Binding AdicionarSiteUrlCommand}" Margin="0,0,6,6"/>
                                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="➕ Coleção" Command="{Binding AdicionarColecaoAmbienteCommand}" Margin="0,0,6,6"/>
                                </WrapPanel>

                                <!-- Lista de Itens Fixados com Ações -->
                                <ListBox ItemsSource="{Binding ItensAmbiente}"
                                         SelectedItem="{Binding ItemSelecionado, Mode=TwoWay}"
                                         Background="Transparent" BorderThickness="0" MaxHeight="220">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0,2"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="ItemCard" CornerRadius="6" Padding="8,6" Background="#24242C" BorderBrush="#353540" BorderThickness="1">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="ItemCard" Property="Background" Value="#2E3445"/>
                                                                <Setter TargetName="ItemCard" Property="BorderBrush" Value="#0A84FF"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:ItemFixado}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="📌" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Titulo}" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                                    <TextBlock Text="{Binding CaminhoOuUrl}" FontSize="10" Foreground="#A9B8C9" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>

                                                <TextBlock Grid.Column="2" Text="{Binding Tipo}" FontSize="10" Foreground="#92A6BC" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- Controles do Item Selecionado -->
                                <Border Margin="0,10,0,0" Padding="8" Background="#16161B" CornerRadius="6"
                                        Visibility="{Binding ItemSelecionado, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Alternar Escopo (Ambiente vs Global) -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Escopo: " FontSize="11" Foreground="#A9B8C9" VerticalAlignment="Center"/>
                                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                                    Content="{Binding TextoEscopoItemSelecionado}"
                                                    Command="{Binding AlternarEscopoItemCommand}"
                                                    ToolTip="Clique para alternar entre Global e Exclusivo deste ambiente"/>
                                        </StackPanel>

                                        <!-- Botões de Ação do Item -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="⬆️" Command="{Binding MoverItemCimaCommand}" Margin="2,0"/>
                                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="⬇️" Command="{Binding MoverItemBaixoCommand}" Margin="2,0"/>
                                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="✏️" Command="{Binding EditarItemAmbienteCommand}" Margin="2,0"/>
                                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="❌" Command="{Binding RemoverItemAmbienteCommand}" Margin="2,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- BLOCO: WIDGETS DO AMBIENTE -->
                        <Border Background="#182432" BorderBrush="#2A3B50" BorderThickness="1" CornerRadius="12" Padding="18">
                            <StackPanel>
                                <TextBlock Text="WIDGETS HABILITADOS NO AMBIENTE" FontSize="11" FontWeight="Bold" Foreground="#92A6BC" Margin="0,0,0,10"/>
                                <CheckBox Style="{StaticResource ToggleSwitchStyle}" Content="Relógio Digital e Controles de Sistema" IsChecked="{Binding RelogioAmbienteHabilitado}" Margin="0,0,0,8"/>
                                <CheckBox Style="{StaticResource ToggleSwitchStyle}" Content="Pomodoro de Foco e Produtividade" IsChecked="{Binding PomodoroAmbienteHabilitado}" Margin="0,0,0,8"/>
                                <CheckBox Style="{StaticResource ToggleSwitchStyle}" Content="Calendário e Próximos Compromissos" IsChecked="{Binding CalendarioAmbienteHabilitado}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ================================================= -->
                    
                    <!-- 3. PAINEL DE EDIÇÃO DE ESPAÇADORES                -->
                    <!-- ================================================= -->
                    <StackPanel Visibility="{Binding EhSecaoEspacadores, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding EspacadorSelecionado.Nome, StringFormat='Espaçador: {0}'}" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock Text="Personalize a aparência dos divisores entre blocos da barra" FontSize="11" Foreground="#A9B8C9" Margin="0,2,0,14"/>

                        <Border Background="#182432" BorderBrush="#2A3B50" BorderThickness="1" CornerRadius="12" Padding="18">
                            <StackPanel>
                                <TextBlock Text="PROPRIEDADES DO DIVISOR" FontSize="11" FontWeight="Bold" Foreground="#92A6BC" Margin="0,0,0,10"/>

                                <TextBlock Text="Nome do Divisor:" FontSize="11" Foreground="#C8C8CE" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding EspacadorSelecionado.Nome, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                                <TextBlock Text="Estilo Visual:" FontSize="11" Foreground="#C8C8CE" Margin="0,0,0,6"/>
                                <ComboBox SelectedValue="{Binding EspacadorSelecionado.Estilo, Mode=TwoWay}"
                                          Background="#202026" Foreground="#FFFFFF" Padding="6,4" Margin="0,0,0,12">
                                    <models:EstiloEspacador>Linha</models:EstiloEspacador>
                                    <models:EstiloEspacador>Espaco</models:EstiloEspacador>
                                    <models:EstiloEspacador>Ponto</models:EstiloEspacador>
                                </ComboBox>

                                <TextBlock Text="{Binding EspacadorSelecionado.Largura, StringFormat='Espaçamento / Largura: {0}px'}" FontSize="11" Foreground="#C8C8CE" Margin="0,0,0,4"/>
                                <Slider Minimum="4" Maximum="32" Value="{Binding EspacadorSelecionado.Largura, Mode=TwoWay}" Margin="0,0,0,12"/>

                                <CheckBox Style="{StaticResource ToggleSwitchStyle}" Content="Visível no dock" IsChecked="{Binding EspacadorSelecionado.Visivel, Mode=TwoWay}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ================================================= -->
                    <!-- ================================================= -->
                    <!-- 4. APARÊNCIA (TEMAS PRÉ-DEFINIDOS) E CUSTOMIZAÇÃO -->
                    <!-- ================================================= -->
                    <StackPanel Grid.Row="0" Visibility="{Binding EhSecaoAparencia, Converter={StaticResource BoolToVis}}" Margin="0,0,0,20">
                        <TextBlock Text="Tema" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock Text="Visuais prontos para o Dock, como no RocketDock ou macOS." FontSize="12" Foreground="#A9B8C9" Margin="0,2,0,16"/>
                        
                        <ListBox ItemsSource="{Binding TemasPredefinidos}"
                                 SelectedItem="{Binding TemaSelecionado, Mode=TwoWay}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Margin="-5" />
