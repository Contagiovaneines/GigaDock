                                <TextBlock Text="  Feito em C# .NET 10 WPF." FontSize="11" Foreground="#C8C8CE"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#182432" BorderBrush="#2A3B50" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="CRIADO POR GIOVANE INES" FontSize="11" FontWeight="Bold" Foreground="#92A6BC" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE71B;" Foreground="#0A84FF" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="LinkedIn: https://www.linkedin.com/in/giovaneines/" FontSize="11" Foreground="#C8C8CE" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE774;" Foreground="#C9D1D9" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="GitHub: https://github.com/Contagiovaneines" FontSize="11" Foreground="#C8C8CE" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="#2A1B3D" BorderBrush="#4A2569" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="APOIE O DESENVOLVEDOR" FontSize="11" FontWeight="Bold" Foreground="#BF5AF2" Margin="0,0,0,8"/>
                                <TextBlock Text="  Se quiser mandar um alô pro dev ou apoiar o projeto:" FontSize="11" Foreground="#E5D0FF" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE715;" Foreground="#E5D0FF" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Email: giovaneinesdev@gmail.com" FontSize="11" Foreground="#E5D0FF" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE8D7;" Foreground="#32D74B" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Pix: giovaneinesdev@gmail.com" FontSize="11" Foreground="#32D74B" VerticalAlignment="Center" FontWeight="Bold"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="#182432" BorderBrush="#2A3B50" BorderThickness="1" CornerRadius="12" Padding="18">
                            <StackPanel>
                                <TextBlock Text="GUIA DE ATALHOS" FontSize="11" FontWeight="Bold" Foreground="#92A6BC" Margin="0,0,0,8"/>
                                <TextBlock Text="  Ctrl + Alt + D : Exibir ou ocultar a dock" FontSize="11" Foreground="#C8C8CE" Margin="0,0,0,4"/>
                                <TextBlock Text="  Ctrl + Alt + 1/2/3 : Alternar para Trabalho, Estudos ou Pessoal" FontSize="11" Foreground="#C8C8CE" Margin="0,0,0,4"/>
