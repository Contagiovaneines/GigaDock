                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>
        <Border x:Name="VisualizationsPanel" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Background="#101720"
                Visibility="{Binding EhSecaoVisualizacoes, Converter={StaticResource BoolToVis}}">
            <views:VisualizacoesSettings/>
        </Border>
        <Border x:Name="CompactNavigation" Grid.Row="0" Grid.ColumnSpan="3" Visibility="Collapsed" Background="#152130" BorderBrush="#2A3B50" BorderThickness="0,0,0,1" Padding="16,12">
