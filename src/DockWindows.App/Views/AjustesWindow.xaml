                <TextBlock Text="Ajustes" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,18,0"/>
                <ComboBox Grid.Column="1" MaxWidth="260" HorizontalAlignment="Left" MinWidth="185" SelectedValuePath="Tag" SelectedValue="{Binding SecaoAtiva, Mode=TwoWay}" AutomationProperties.Name="Seção de ajustes">
                    <ComboBoxItem Content="Ambientes" Tag="Ambientes"/><ComboBoxItem Content="Widgets" Tag="Widgets"/><ComboBoxItem Content="Espaçadores" Tag="Espacadores"/><ComboBoxItem Content="Aparência" Tag="Aparencia"/><ComboBoxItem Content="Visualizações" Tag="Visualizacoes"/><ComboBoxItem Content="Geral" Tag="Geral"/><ComboBoxItem Content="Utilitários" Tag="Utilitarios"/><ComboBoxItem Content="Sobre" Tag="Sobre"/>
                </ComboBox>
                <Button Grid.Column="2" Content="Concluir" Command="{Binding ConcluirCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="12,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>































