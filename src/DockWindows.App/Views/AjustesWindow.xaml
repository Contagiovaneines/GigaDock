                                        <TextBlock Text="Ctrl + Alt + 1/2/3" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <!-- ================================================= -->
                    <!-- 6. PAINEL DE UTILITÁRIOS                          -->
                    <!-- ================================================= -->
                    <StackPanel Visibility="{Binding EhSecaoUtilitarios, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Utilitários e Manutenção" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock Text="Backup, restauração e ferramentas de emergência" FontSize="11" Foreground="#A9B8C9" Margin="0,2,0,14"/>

                        <Border Background="#182432" BorderBrush="#2A3B50" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="BACKUP E RESTAURAÇÃO" FontSize="11" FontWeight="Bold" Foreground="#92A6BC" Margin="0,0,0,10"/>
                                <WrapPanel>
                                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="💾 Exportar Backup (.json)" Command="{Binding ExportarBackupCommand}" Margin="0,0,8,0"/>
                                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="📥 Importar Backup (.json)" Command="{Binding ImportarBackupCommand}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="#182432" BorderBrush="#2A3B50" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="RESTAURAÇÃO DA BARRA DO WINDOWS" FontSize="11" FontWeight="Bold" Foreground="#92A6BC" Margin="0,0,0,10"/>
                                <TextBlock Text="Restaura imediatamente a barra nativa do Windows caso esteja oculta." FontSize="11" Foreground="#A9B8C9" Margin="0,0,0,8"/>
                                <Button Style="{StaticResource PrimaryButtonStyle}" Content="🔄 Restaurar Barra Nativa Agora" Command="{Binding RestaurarBarraWindowsCommand}" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#2A1C1D" BorderBrush="#4A2628" BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel>
                                <TextBlock Text="ZONA DE PERIGO" FontSize="11" FontWeight="Bold" Foreground="#FF453A" Margin="0,0,0,10"/>
                                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Restaurar Padrões de Fábrica" Command="{Binding RestaurarPadroesFabricaCommand}" Foreground="#FF453A" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ================================================= -->
                                        <!-- 7. PAINEL DE SOBRE -->
                    <StackPanel Visibility="{Binding EhSecaoSobre, Converter={StaticResource BoolToVis}}">
