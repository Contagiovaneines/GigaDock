                        <Border Background="#182432" BorderBrush="#2A3B50" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="O PROJETO É OPEN SOURCE" FontSize="11" FontWeight="Bold" Foreground="#92A6BC" Margin="0,0,0,8"/>
                                <TextBlock Text="  O GigaDock é 100% open-source e gratuito!" FontSize="11" Foreground="#C8C8CE" Margin="0,0,0,4"/>
