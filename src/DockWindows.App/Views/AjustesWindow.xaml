<Window x:Class="DockWindows.App.Views.AjustesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:DockWindows.App.Converters"
        xmlns:models="clr-namespace:DockWindows.Core.Models;assembly=DockWindows.Core"
        xmlns:vm="clr-namespace:DockWindows.App.ViewModels"
        Title="Dock Windows â€” Ajustes e ConfiguraÃ§Ãµes"
        Width="1080"
        Height="720"
        MinWidth="960"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#141416"
        Foreground="#FFFFFF"
        FontFamily="Segoe UI"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <conv:ColorToBrushConverter x:Key="ColorToBrushConverter"/>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InvertBoolToVis"/>

        <!-- Estilo dos BotÃµes da Barra Lateral de NavegaÃ§Ã£o (Liquid Glass Sidebar SBR001) -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A0A0A8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="6,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" CornerRadius="8" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#18FFFFFF"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#25FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Tag" Value="True">
                    <Setter Property="Background" Value="#220A84FF"/>
                    <Setter Property="BorderBrush" Value="#4538BDF8"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo dos BotÃµes PrimÃ¡rios (Liquid Glass Button BTN003) -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0A84FF"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#60FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" CornerRadius="7" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#2997FF"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#90FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#0071E3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo dos BotÃµes SecundÃ¡rios / Ãcones -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#24242A"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#383842"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#32323A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo das Caixas de Texto -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#202026"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#383844"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ESTRUTURA PRINCIPAL EM 3 COLUNAS -->
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Coluna 1: NavegaÃ§Ã£o Lateral -->
            <ColumnDefinition Width="220" MinWidth="190" MaxWidth="260"/>
            <!-- Coluna 2: Itens da SeÃ§Ã£o Selecionada -->
            <ColumnDefinition Width="310" MinWidth="260" MaxWidth="400"/>
            <!-- Coluna 3: EdiÃ§Ã£o e Detalhes do Item Selecionado -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ========================================================= -->
        <!-- COLUNA 1: NAVEGAÃ‡ÃƒO LATERAL                               -->
        <!-- ========================================================= -->
        <Border Grid.Column="0" Background="#161619" BorderBrush="#26262C" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- CabeÃ§alho do App -->
                    <RowDefinition Height="Auto"/>
                    <!-- Menu de NavegaÃ§Ã£o -->
                    <RowDefinition Height="*"/>
                    <!-- RodapÃ© com BotÃ£o Concluir -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- CabeÃ§alho: Identidade do Dock Windows e Ambiente Ativo -->
                <Border Grid.Row="0" Padding="14,16,14,14" BorderBrush="#26262C" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="34" Height="34" CornerRadius="8" Background="#0A84FF" Margin="0,0,10,0">
                                <TextBlock Text="ðŸš€" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Dock Windows" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock Text="VersÃ£o 1.6.0" FontSize="11" Foreground="#8E8E93"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Indicador do Ambiente Ativo -->
                        <Border Margin="0,12,0,0" Padding="8,5" CornerRadius="6" Background="#1C1F26" BorderBrush="#2A303D" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Margin="0,0,7,0"
                                         Fill="{Binding AmbienteAtivo.CorHex, Converter={StaticResource ColorToBrushConverter}}"/>
                                <TextBlock Text="Ativo: " FontSize="11" Foreground="#8E8E93"/>
                                <TextBlock Text="{Binding AmbienteAtivo.Nome}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Grupos de NavegaÃ§Ã£o -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,10">
                        <!-- GRUPO PRINCIPAL -->
                        <TextBlock Text="PRINCIPAL" FontSize="10" FontWeight="Bold" Foreground="#71717A" Margin="16,8,0,4"/>

                        <Button Style="{StaticResource NavButtonStyle}" Tag="{Binding EhSecaoAmbientes}" Command="{Binding NavegarCommand}" CommandParameter="Ambientes">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ðŸ’¼" FontSize="14" Margin="0,0,9,0"/>
                                <TextBlock Text="Ambientes"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavButtonStyle}" Tag="{Binding EhSecaoWidgets}" Command="{Binding NavegarCommand}" CommandParameter="Widgets">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ðŸ§©" FontSize="14" Margin="0,0,9,0"/>
                                <TextBlock Text="Widgets"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavButtonStyle}" Tag="{Binding EhSecaoEspacadores}" Command="{Binding NavegarCommand}" CommandParameter="Espacadores">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="â†”ï¸" FontSize="14" Margin="0,0,9,0"/>
                                <TextBlock Text="EspaÃ§adores"/>
                            </StackPanel>
                        </Button>

                        <!-- GRUPO AJUSTES -->
                        <TextBlock Text="AJUSTES" FontSize="10" FontWeight="Bold" Foreground="#71717A" Margin="16,16,0,4"/>

                        <Button Style="{StaticResource NavButtonStyle}" Tag="{Binding EhSecaoAparencia}" Command="{Binding NavegarCommand}" CommandParameter="Aparencia">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ðŸŽ¨" FontSize="14" Margin="0,0,9,0"/>
                                <TextBlock Text="AparÃªncia"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavButtonStyle}" Tag="{Binding EhSecaoGeral}" Command="{Binding NavegarCommand}" CommandParameter="Geral">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="âš™ï¸" FontSize="14" Margin="0,0,9,0"/>
                                <TextBlock Text="Geral"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavButtonStyle}" Tag="{Binding EhSecaoUtilitarios}" Command="{Binding NavegarCommand}" CommandParameter="Utilitarios">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ðŸ› ï¸" FontSize="14" Margin="0,0,9,0"/>
                                <TextBlock Text="UtilitÃ¡rios"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavButtonStyle}" Tag="{Binding EhSecaoSobre}" Command="{Binding NavegarCommand}" CommandParameter="Sobre">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="â„¹ï¸" FontSize="14" Margin="0,0,9,0"/>
                                <TextBlock Text="Sobre"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- RodapÃ© -->
                <Border Grid.Row="2" Padding="12" BorderBrush="#26262C" BorderThickness="0,1,0,0">
                    <Button Style="{StaticResource PrimaryButtonStyle}" Content="Concluir e Fechar" Command="{Binding ConcluirCommand}" HorizontalAlignment="Stretch"/>
                </Border>
            </Grid>
        </Border>

        <!-- ========================================================= -->
        <!-- COLUNA 2: ITENS DA SEÃ‡ÃƒO (MASTER LIST)                    -->
        <!-- ========================================================= -->
        <Border Grid.Column="1" Background="#19191D" BorderBrush="#282830" BorderThickness="0,0,1,0">
            <Grid Margin="12,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 1. AMBIENTES (LISTA E CRUD) -->
                <StackPanel Grid.Row="0" Visibility="{Binding EhSecaoAmbientes, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Ambientes" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock Text="Selecione um ambiente para editar ou ativar" FontSize="11" Foreground="#8E8E93" Margin="0,2,0,8"/>

                    <!-- Barra de AÃ§Ãµes: + - Cima Baixo -->
                    <Border Background="#202026" CornerRadius="6" Padding="4" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="âž• Novo" Command="{Binding NovoAmbienteCommand}" Margin="2,0" ToolTip="Criar novo ambiente"/>
                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="âž– Excluir" Command="{Binding ExcluirAmbienteCommand}" Margin="2,0" ToolTip="Excluir ambiente selecionado"/>
                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="â¬†ï¸" Command="{Binding MoverAmbienteCimaCommand}" Margin="2,0" ToolTip="Mover para cima"/>
                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="â¬‡ï¸" Command="{Binding MoverAmbienteBaixoCommand}" Margin="2,0" ToolTip="Mover para baixo"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <ListBox Grid.Row="1" ItemsSource="{Binding Ambientes}"
                         SelectedItem="{Binding AmbienteSelecionado, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0"
                         Visibility="{Binding EhSecaoAmbientes, Converter={StaticResource BoolToVis}}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,3"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Card" CornerRadius="8" Padding="10,8" Background="#202026" BorderBrush="#32323C" BorderThickness="1">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Card" Property="Background" Value="#2A2F3D"/>
                                                <Setter TargetName="Card" Property="BorderBrush" Value="#0A84FF"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Card" Property="Background" Value="#262630"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:EnvironmentViewModel}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="30" Height="30" CornerRadius="6"
                                        Background="{Binding CorHex, Converter={StaticResource ColorToBrushConverter}}" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding Icone}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Nome}" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                    <TextBlock Text="{Binding Itens.Count, StringFormat='{}{0} apps fixados'}" FontSize="11" Foreground="#8E8E93"/>
                                </StackPanel>

                                <!-- Tag de Ativo -->
                                <Border Grid.Column="2" CornerRadius="4" Padding="6,2" Background="#0A84FF"
                                        Visibility="{Binding EstaAtivo, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center">
                                    <TextBlock Text="ATIVO" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 2. WIDGETS -->
                <StackPanel Grid.Row="0" Visibility="{Binding EhSecaoWidgets, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Widgets" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock Text="Widgets disponÃ­veis no ambiente ativo" FontSize="11" Foreground="#8E8E93" Margin="0,2,0,8"/>

                    <Border Background="#202026" CornerRadius="6" Padding="4" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="â¬†ï¸ Subir" Command="{Binding MoverWidgetCimaCommand}" Margin="2,0"/>
                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="â¬‡ï¸ Descer" Command="{Binding MoverWidgetBaixoCommand}" Margin="2,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <ListBox Grid.Row="1" ItemsSource="{Binding WidgetsAmbiente}"
                         SelectedItem="{Binding WidgetSelecionado, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0"
                         Visibility="{Binding EhSecaoWidgets, Converter={StaticResource BoolToVis}}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,3"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Card" CornerRadius="8" Padding="10,8" Background="#202026" BorderBrush="#32323C" BorderThickness="1">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Card" Property="Background" Value="#2A2F3D"/>
                                                <Setter TargetName="Card" Property="BorderBrush" Value="#0A84FF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:WidgetInstanceConfig}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="ðŸ§©" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Nome}" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                    <TextBlock Text="{Binding Formato}" FontSize="11" Foreground="#8E8E93"/>
                                </StackPanel>

                                <CheckBox Grid.Column="2" IsChecked="{Binding Visivel}" VerticalAlignment="Center" ToolTip="Exibir na barra"
                                          Command="{Binding DataContext.AlternarVisibilidadeWidgetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                          CommandParameter="{Binding}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 3. ESPAÃ‡ADORES -->
                <StackPanel Grid.Row="0" Visibility="{Binding EhSecaoEspacadores, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="EspaÃ§adores" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock Text="Divisores visuais entre blocos do dock" FontSize="11" Foreground="#8E8E93" Margin="0,2,0,8"/>

                    <Border Background="#202026" CornerRadius="6" Padding="4" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="âž• Adicionar" Command="{Binding NovoEspacadorCommand}" Margin="2,0"/>
                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="âž– Remover" Command="{Binding RemoverEspacadorCommand}" Margin="2,0"/>
                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="â¬†ï¸" Command="{Binding MoverEspacadorCimaCommand}" Margin="2,0"/>
                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="â¬‡ï¸" Command="{Binding MoverEspacadorBaixoCommand}" Margin="2,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <ListBox Grid.Row="1" ItemsSource="{Binding Espacadores}"
                         SelectedItem="{Binding EspacadorSelecionado, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0"
                         Visibility="{Binding EhSecaoEspacadores, Converter={StaticResource BoolToVis}}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,3"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Card" CornerRadius="8" Padding="10,8" Background="#202026" BorderBrush="#32323C" BorderThickness="1">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Card" Property="Background" Value="#2A2F3D"/>
                                                <Setter TargetName="Card" Property="BorderBrush" Value="#0A84FF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:EspacadorConfig}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="â†”ï¸" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Nome}" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                    <TextBlock Text="{Binding Estilo, StringFormat='Estilo: {0}'}" FontSize="11" Foreground="#8E8E93"/>
                                </StackPanel>

                                <TextBlock Grid.Column="2" Text="{Binding Largura, StringFormat='{}{0}px'}" FontSize="11" FontWeight="Bold" Foreground="#0A84FF" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 4. APARÃŠNCIA (TEMAS PRÃ‰-DEFINIDOS) -->
                <StackPanel Grid.Row="0" Visibility="{Binding EhSecaoAparencia, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Temas Visuais" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock Text="Escolha o estilo visual para o dock" FontSize="11" Foreground="#8E8E93" Margin="0,2,0,10"/>
                </StackPanel>

                <ListBox Grid.Row="1" ItemsSource="{Binding TemasPredefinidos}"
                         SelectedItem="{Binding TemaSelecionado, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0"
                         Visibility="{Binding EhSecaoAparencia, Converter={StaticResource BoolToVis}}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,4"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Card" CornerRadius="8" Padding="10" Background="#202026" BorderBrush="#32323C" BorderThickness="1">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Card" Property="Background" Value="#282D3D"/>
                                                <Setter TargetName="Card" Property="BorderBrush" Value="#0A84FF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:TemaDefinicao}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Miniatura do tema -->
                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8"
                                        Background="{Binding CorMiniatura, Converter={StaticResource ColorToBrushConverter}}"
                                        BorderBrush="{Binding CorBordaMiniatura, Converter={StaticResource ColorToBrushConverter}}"
                                        BorderThickness="2" Margin="0,0,10,0"/>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Nome}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    <TextBlock Text="{Binding Descricao}" FontSize="11" Foreground="#8E8E93" TextWrapping="Wrap" MaxHeight="32"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 5. GERAL (LISTA DE CATEGORIAS) -->
                <StackPanel Grid.Row="0" Visibility="{Binding EhSecaoGeral, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="OpÃ§Ãµes Gerais" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock Text="ConfiguraÃ§Ãµes de sistema e comportamento" FontSize="11" Foreground="#8E8E93" Margin="0,2,0,10"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Visibility="{Binding EhSecaoGeral, Converter={StaticResource BoolToVis}}">
                    <Border CornerRadius="8" Padding="10" Background="#202026" BorderBrush="#32323C" BorderThickness="1" Margin="0,0,0,6">
