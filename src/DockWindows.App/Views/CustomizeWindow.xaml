<Window x:Class="DockWindows.App.Views.CustomizeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:DockWindows.App.Converters"
        xmlns:models="clr-namespace:DockWindows.Core.Models;assembly=DockWindows.Core"
        Title="Personalizar Dock Windows"
        Width="780"
        Height="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#18181A"
        Foreground="#FFFFFF"
        FontFamily="Segoe UI">
    <Window.Resources>
        <conv:ColorToBrushConverter x:Key="ColorToBrushConverter"/>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InvertBoolToVis"/>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#A0A0A5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#0A84FF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,6"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <!-- 0: Título -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Live Preview -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Abas de Configuração -->
            <RowDefinition Height="*"/>
            <!-- 3: Botões Inferiores -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <TextBlock Text="Personalizar Dock Windows"
                   FontSize="18" FontWeight="Bold"
                   Foreground="#0A84FF" Margin="4,0,0,10"/>

        <!-- ÁREA DE LIVE PREVIEW -->
        <Border Grid.Row="1"
                Background="#101012"
                BorderBrush="#2A2A30"
                BorderThickness="1"
                CornerRadius="14"
                Padding="16,14"
                Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="PRÉ-VISUALIZAÇÃO EM TEMPO REAL"
                           FontSize="10" FontWeight="Bold"
                           Foreground="#8E8E93" Margin="0,0,0,10"
                           HorizontalAlignment="Center"/>

                <!-- Simulação da Dock -->
                <Border CornerRadius="18"
                        BorderThickness="1"
                        BorderBrush="{Binding PreviewBordaColor, Converter={StaticResource ColorToBrushConverter}}"
                        Background="{Binding PreviewFundoColor, Converter={StaticResource ColorToBrushConverter}}"
                        Opacity="{Binding OpacidadeDock}"
                        Padding="12,6"
                        HorizontalAlignment="Center"
                        Height="56">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        
                        <!-- 1. Seção Iniciar e Pesquisa Simulada -->
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding PreviewSecaoIniciarPesquisaVisivel, Converter={StaticResource BoolToVis}}">
                            <Border Background="#18FFFFFF" CornerRadius="8" Width="30" Height="30" Margin="1,0">
                                <TextBlock Text="⊞" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Background="#18FFFFFF" CornerRadius="8" Width="30" Height="30" Margin="1,0">
                                <TextBlock Text="🔍" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Rectangle Width="1" Height="22" Fill="#30FFFFFF" Margin="6,0"/>
                        </StackPanel>

                        <!-- 2. Seção Apps Fixados e Abertos Simulada -->
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding PreviewSecaoAppsVisivel, Converter={StaticResource BoolToVis}}">
                            <Border Background="#18FFFFFF" CornerRadius="8" Width="30" Height="30" Margin="1,0" ToolTip="Explorador">
                                <TextBlock Text="📁" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ItemsControl ItemsSource="{Binding AppsPermanentes}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#20FFFFFF" CornerRadius="8" Width="30" Height="30" Margin="1,0" ToolTip="{Binding Titulo}">
                                            <TextBlock Text="🚀" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Rectangle Width="1" Height="22" Fill="#30FFFFFF" Margin="6,0"/>
                        </StackPanel>

                        <!-- 3. Seção Itens do Ambiente Atual Simulada -->
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding PreviewSecaoItensAmbienteVisivel, Converter={StaticResource BoolToVis}}">
                            <!-- Pílula do Ambiente -->
                            <Border Background="{Binding AmbienteSelecionado.CorHex, Converter={StaticResource ColorToBrushConverter}}"
                                    CornerRadius="10" Padding="8,4" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding AmbienteSelecionado.Icone}" FontSize="12" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding AmbienteSelecionado.Nome}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                                </StackPanel>
                            </Border>
                            <!-- Itens Fixados do Ambiente -->
                            <ItemsControl ItemsSource="{Binding ItensDoAmbiente}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#20FFFFFF" CornerRadius="8" Width="30" Height="30" Margin="1,0" ToolTip="{Binding Titulo}">
                                            <TextBlock Text="📌" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Rectangle Width="1" Height="22" Fill="#30FFFFFF" Margin="6,0"/>
                        </StackPanel>

                        <!-- 4. Seção Widgets Simulada -->
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding PreviewSecaoWidgetsVisivel, Converter={StaticResource BoolToVis}}">
                            <Border Background="#18FFFFFF" CornerRadius="8" Padding="6,3" Margin="0,0,4,0"
                                    Visibility="{Binding PomodoroHabilitado, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="⏱️ 25:00" FontSize="11" FontWeight="Bold" Foreground="#FF9F0A"/>
                            </Border>
                            <Rectangle Width="1" Height="22" Fill="#30FFFFFF" Margin="4,0,6,0"
                                       Visibility="{Binding PomodoroHabilitado, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>

                        <!-- 5. Seção Relógio e Controles Simulada -->
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding PreviewSecaoRelogioControlesVisivel, Converter={StaticResource BoolToVis}}">
                            <Border Background="#18FFFFFF" CornerRadius="8" Padding="6,3" Margin="0,0,4,0"
                                    Visibility="{Binding RelogioHabilitado, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="🕒 12:00" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </Border>
                            <TextBlock Text="➕" FontSize="11" Margin="2,0" VerticalAlignment="Center"/>
                            <TextBlock Text="🎨" FontSize="11" Margin="2,0" VerticalAlignment="Center"/>
                            <TextBlock Text="⚙️" FontSize="11" Margin="2,0" VerticalAlignment="Center"/>
                        </StackPanel>

                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ABAS DE CONFIGURAÇÃO -->
        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
            
            <!-- ABA 1: ORGANIZAÇÃO & SEÇÕES -->
            <TabItem Header="📑 Organização &amp; Seções">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,12,10,10">
                        <TextBlock Text="ORDEM E VISIBILIDADE DAS SEÇÕES DO DOCK" FontSize="11" FontWeight="Bold" Foreground="#8E8E93" Margin="0,0,0,6"/>
                        <TextBlock Text="Marque/desmarque para exibir ou ocultar. Selecione uma seção e use as setas para reordenar:"
                                   FontSize="12" Foreground="#A0A0A5" Margin="0,0,0,8"/>

                        <!-- Grid de Reordenação de Seções -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>

                            <ListBox ItemsSource="{Binding Secoes}"
                                     SelectedItem="{Binding SecaoSelecionada, Mode=TwoWay}"
                                     Background="#202024" BorderBrush="#333338" Foreground="#FFFFFF"
                                     MinHeight="130">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="4,3">
                                            <CheckBox IsChecked="{Binding Visivel, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding Nome}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <Button Content="⬆️ Subir Seção" Command="{Binding MoverSecaoCimaCommand}"
                                        Background="#33333A" Foreground="#FFFFFF" Padding="10,6" Margin="0,0,0,6" Cursor="Hand"/>
                                <Button Content="⬇️ Descer Seção" Command="{Binding MoverSecaoBaixoCommand}"
                                        Background="#33333A" Foreground="#FFFFFF" Padding="10,6" Margin="0,0,0,6" Cursor="Hand"/>
                                <Button Content="🔄 Ordem Padrão" Command="{Binding RestaurarOrdemSecoesPadraoCommand}"
                                        Background="#33333A" Foreground="#FF9F0A" Padding="10,6" Margin="0,0,0,6" Cursor="Hand"/>
                            </StackPanel>
                        </Grid>

                        <Separator Background="#2A2A30" Margin="0,6,0,10"/>

                        <TextBlock Text="POLÍTICA DE APLICATIVOS FIXADOS" FontSize="11" FontWeight="Bold" Foreground="#8E8E93" Margin="0,0,0,6"/>
                        <CheckBox Content="Apps fixados globais (exibir os mesmos aplicativos fixados em todos os ambientes)"
                                  IsChecked="{Binding AppsFixadosGlobais, Mode=TwoWay}"/>
                        <TextBlock Text="Quando marcado, a área de aplicativos é unificada. Quando desmarcado, cada ambiente pode manter seu próprio conjunto de apps."
                                   FontSize="11" Foreground="#8E8E93" Margin="24,0,0,12"/>

                        <Separator Background="#2A2A30" Margin="0,0,0,10"/>

                        <TextBlock Text="MODO DE SUBSTITUIÇÃO DA BARRA DE TAREFAS" FontSize="11" FontWeight="Bold" Foreground="#8E8E93" Margin="0,0,0,6"/>
                        <CheckBox Content="Usar como barra principal (posiciona na borda inferior e auto-oculta barra nativa)"
                                  IsChecked="{Binding UsarComoBarraPrincipal, Mode=TwoWay}"/>
                        <TextBlock Text="A barra de tarefas nativa do Windows é configurada para ocultar automaticamente usando APIs documentadas da shell. O processo Explorer não é finalizado."
                                   FontSize="11" Foreground="#8E8E93" TextWrapping="Wrap" Margin="24,0,0,10"/>

                        <Button Content="🔄 Restaurar Barra de Tarefas do Windows Agora"
                                Command="{Binding RestaurarBarraWindowsCommand}"
                                Background="#33333A" Foreground="#FFFFFF"
                                Padding="12,6" HorizontalAlignment="Left"
                                Margin="24,0,0,14" Cursor="Hand"/>

                        <Separator Background="#2A2A30" Margin="0,0,0,10"/>

                        <TextBlock Text="COMPORTAMENTO DA JANELA" FontSize="11" FontWeight="Bold" Foreground="#8E8E93" Margin="0,0,0,6"/>
                        <CheckBox Content="Ocultar automaticamente quando inativa (Auto-Hide)"
                                  IsChecked="{Binding OcultarAutomaticamente, Mode=TwoWay}"/>
                        <CheckBox Content="Manter dock sempre no topo (Topmost)"
                                  IsChecked="{Binding SempreNoTopo, Mode=TwoWay}"/>
                        <CheckBox Content="Desativar animações visuais (Respeitar redução de movimento)"
                                  IsChecked="{Binding DesativarAnimacoes, Mode=TwoWay}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ABA 2: APLICATIVOS PERMANENTES -->
            <TabItem Header="🚀 Apps Fixados">
                <Grid Margin="10,12,10,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="APLICATIVOS PERMANENTES DO DOCK (ATALHOS, EXECUTÁVEIS E UWP)"
                               FontSize="11" FontWeight="Bold" Foreground="#8E8E93" Margin="0,0,0,10"/>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>

                        <ListBox ItemsSource="{Binding AppsPermanentes}"
                                 SelectedItem="{Binding AppPermanenteSelecionado, Mode=TwoWay}"
                                 Background="#202024" BorderBrush="#333338" Foreground="#FFFFFF">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="🚀" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="14"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock Text="{Binding CaminhoOuUrl}" FontSize="11" Foreground="#8E8E93" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <Button Content="➕ Adicionar App..." Command="{Binding AdicionarAppPermanenteCommand}"
                                    Background="#0078D4" Foreground="#FFFFFF" Padding="10,6" Margin="0,0,0,6" Cursor="Hand"/>
                            <Button Content="✏️ Editar..." Command="{Binding EditarAppPermanenteCommand}"
                                    Background="#33333A" Foreground="#FFFFFF" Padding="10,6" Margin="0,0,0,6" Cursor="Hand"/>
                            <Button Content="⬆️ Mover Cima" Command="{Binding MoverAppCimaCommand}"
                                    Background="#33333A" Foreground="#FFFFFF" Padding="10,6" Margin="0,0,0,6" Cursor="Hand"/>
                            <Button Content="⬇️ Mover Baixo" Command="{Binding MoverAppBaixoCommand}"
                                    Background="#33333A" Foreground="#FFFFFF" Padding="10,6" Margin="0,0,0,6" Cursor="Hand"/>
                            <Button Content="🗑️ Desafixar" Command="{Binding RemoverAppPermanenteCommand}"
                                    Background="#442222" Foreground="#FF6B6B" Padding="10,6" Margin="0,0,0,6" Cursor="Hand"/>
                            <Button Content="🔄 Restaurar Padrões" Command="{Binding RestaurarAppsPadraoCommand}"
                                    Background="#33333A" Foreground="#FF9F0A" Padding="10,6" Margin="0,0,0,6" Cursor="Hand"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ABA 2: APARÊNCIA -->
            <TabItem Header="🎨 Aparência">
                <StackPanel Margin="10,14,10,10">
                    <TextBlock Text="Modo de Tema:" FontSize="13" Foreground="#A0A0A5"/>
                    <ComboBox x:Name="CmbTema" SelectionChanged="CmbTema_SelectionChanged" Width="260" HorizontalAlignment="Left" Margin="0,4,0,14">
                        <ComboBoxItem Content="Escuro (Dark)" Tag="{x:Static models:TemaModo.Escuro}"/>
                        <ComboBoxItem Content="Claro (Light)" Tag="{x:Static models:TemaModo.Claro}"/>
                        <ComboBoxItem Content="Seguir o Windows (Sistema)" Tag="{x:Static models:TemaModo.Sistema}"/>
                    </ComboBox>

                    <TextBlock Text="Tamanho dos Ícones:" FontSize="13" Foreground="#A0A0A5"/>
                    <ComboBox x:Name="CmbTamanho" SelectionChanged="CmbTamanho_SelectionChanged" Width="260" HorizontalAlignment="Left" Margin="0,4,0,14">
                        <ComboBoxItem Content="Pequeno (32px)" Tag="{x:Static models:TamanhoIcone.Pequeno}"/>
                        <ComboBoxItem Content="Médio (40px — Padrão)" Tag="{x:Static models:TamanhoIcone.Medio}"/>
                        <ComboBoxItem Content="Grande (48px)" Tag="{x:Static models:TamanhoIcone.Grande}"/>
                    </ComboBox>

                    <TextBlock Text="Espaçamento entre Ícones:" FontSize="13" Foreground="#A0A0A5"/>
                    <Grid Width="360" HorizontalAlignment="Left" Margin="0,4,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <Slider Minimum="2" Maximum="20" Value="{Binding EspacamentoItens, Mode=TwoWay}"
                                TickFrequency="2" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding EspacamentoItens, StringFormat={}{0} px}"
                                   FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock Text="Opacidade da Barra:" FontSize="13" Foreground="#A0A0A5"/>
                    <Grid Width="360" HorizontalAlignment="Left" Margin="0,4,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <Slider Minimum="0.5" Maximum="1.0" Value="{Binding OpacidadeDock, Mode=TwoWay}"
                                TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding OpacidadeDock, StringFormat={}{0:P0}}"
                                   FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </TabItem>

            <!-- ABA 3: ITENS DO AMBIENTE -->
            <TabItem Header="📌 Itens do Ambiente">
                <Grid Margin="10,12,10,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Seletor do Ambiente a Customizar -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Ambiente:" VerticalAlignment="Center" FontSize="13" Foreground="#A0A0A5" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding Ambientes}"
                                  SelectedItem="{Binding AmbienteSelecionado, Mode=TwoWay}"
                                  DisplayMemberPath="Nome" Width="180"/>
                    </StackPanel>

                    <!-- Lista de Itens e Botões -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="130"/>
                        </Grid.ColumnDefinitions>

                        <ListBox ItemsSource="{Binding ItensDoAmbiente}"
                                 SelectedItem="{Binding ItemSelecionado, Mode=TwoWay}"
                                 Background="#202024" BorderBrush="#333338" Foreground="#FFFFFF">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="📌" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock Text="{Binding CaminhoOuUrl}" FontSize="11" Foreground="#8E8E93" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Botões de Ação na Lista -->
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <Button Content="➕ Adicionar..." Command="{Binding AdicionarItemCommand}"
                                    Background="#0078D4" Foreground="#FFFFFF" Padding="10,6" Margin="0,0,0,6" Cursor="Hand"/>
                            <Button Content="✏️ Editar..." Command="{Binding EditarItemCommand}"
                                    Background="#33333A" Foreground="#FFFFFF" Padding="10,6" Margin="0,0,0,6" Cursor="Hand"/>
                            <Button Content="⬆️ Mover Cima" Command="{Binding MoverItemCimaCommand}"
                                    Background="#33333A" Foreground="#FFFFFF" Padding="10,6" Margin="0,0,0,6" Cursor="Hand"/>
                            <Button Content="⬇️ Mover Baixo" Command="{Binding MoverItemBaixoCommand}"
                                    Background="#33333A" Foreground="#FFFFFF" Padding="10,6" Margin="0,0,0,6" Cursor="Hand"/>
                            <Button Content="🗑️ Remover" Command="{Binding RemoverItemCommand}"
                                    Background="#442222" Foreground="#FF6B6B" Padding="10,6" Margin="0,0,0,6" Cursor="Hand"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ABA 4: WIDGETS DO AMBIENTE -->
            <TabItem Header="⏱️ Widgets">
                <StackPanel Margin="10,12,10,10">
                    <TextBlock Text="WIDGETS PARA O AMBIENTE SELECIONADO" FontSize="11" FontWeight="Bold" Foreground="#8E8E93" Margin="0,0,0,8"/>
                    
                    <CheckBox Content="Habilitar Widget de Relógio e Data"
                              IsChecked="{Binding RelogioHabilitado, Mode=TwoWay}"/>

                    <CheckBox Content="Habilitar Widget de Pomodoro de Foco"
                              IsChecked="{Binding PomodoroHabilitado, Mode=TwoWay}"/>

                    <TextBlock Text="Ajuste dos Ciclos de Pomodoro (minutos):" FontSize="12" Foreground="#A0A0A5" Margin="0,10,0,6"/>
                    <Grid Width="340" HorizontalAlignment="Left" Margin="0,0,0,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Duração de Foco:" VerticalAlignment="Center" Margin="0,4"/>
                        <TextBox Grid.Column="1" Text="{Binding DuracaoFocoMinutos, Mode=TwoWay}"
                                 Background="#2A2A30" Foreground="#FFFFFF" BorderBrush="#44444E" Padding="6,3" Margin="0,4"/>

                        <TextBlock Grid.Row="1" Text="Pausa Curta:" VerticalAlignment="Center" Margin="0,4"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DuracaoPausaCurtaMinutos, Mode=TwoWay}"
                                 Background="#2A2A30" Foreground="#FFFFFF" BorderBrush="#44444E" Padding="6,3" Margin="0,4"/>

                        <TextBlock Grid.Row="2" Text="Pausa Longa:" VerticalAlignment="Center" Margin="0,4"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DuracaoPausaLongaMinutos, Mode=TwoWay}"
                                 Background="#2A2A30" Foreground="#FFFFFF" BorderBrush="#44444E" Padding="6,3" Margin="0,4"/>
                    </Grid>

                    <Separator Background="#2A2A30" Margin="0,10"/>

                    <Button Content="🔄 Restaurar Configurações Padrão Deste Ambiente"
                            Command="{Binding RestaurarPadraoCommand}"
                            Background="#33333A" Foreground="#FF9F0A"
                            Padding="12,6" HorizontalAlignment="Left"
                            Cursor="Hand"/>
                </StackPanel>
            </TabItem>

        </TabControl>

        <!-- BOTÕES INFERIORES -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancelar"
                    Command="{Binding CancelarCommand}"
                    Background="#33333A" Foreground="#FFFFFF"
                    Padding="18,7" Margin="0,0,10,0"
                    IsCancel="True" Cursor="Hand"/>

            <Button Content="Salvar e Aplicar"
                    Command="{Binding SalvarCommand}"
                    Background="#0078D4" Foreground="#FFFFFF"
                    Padding="22,7" FontWeight="Bold"
                    IsDefault="True" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
