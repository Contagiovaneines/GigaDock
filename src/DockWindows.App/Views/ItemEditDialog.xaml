<Window x:Class="DockWindows.App.Views.ItemEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:DockWindows.Core.Models;assembly=DockWindows.Core"
        Title="Item Fixado"
        Width="460"
        Height="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1E1E22"
        Foreground="#FFFFFF"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2A2A30"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#44444E"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,4,0,12"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2A2A30"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="BorderBrush" Value="#44444E"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,4,0,12"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Configurar Item Fixado"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="#0A84FF"
                   Margin="0,0,0,16"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Título ou Rótulo:" FontSize="12" Foreground="#A0A0A5"/>
            <TextBox x:Name="TxtTitulo"/>

            <TextBlock Text="Tipo de Item:" FontSize="12" Foreground="#A0A0A5"/>
            <ComboBox x:Name="CmbTipo" SelectionChanged="CmbTipo_SelectionChanged">
                <ComboBoxItem Content="Aplicativo (.exe, .lnk)" Tag="{x:Static models:TipoItem.Aplicativo}"/>
                <ComboBoxItem Content="Arquivo (Documento, PDF, etc.)" Tag="{x:Static models:TipoItem.Arquivo}"/>
                <ComboBoxItem Content="Pasta de Diretório" Tag="{x:Static models:TipoItem.Pasta}"/>
                <ComboBoxItem Content="Endereço Web (URL)" Tag="{x:Static models:TipoItem.WebUrl}"/>
            </ComboBox>

            <TextBlock Text="Caminho ou URL:" FontSize="12" Foreground="#A0A0A5"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtCaminho" Margin="0,4,8,12"/>
                <Button x:Name="BtnProcurar" Grid.Column="1" Content="Procurar..."
                        Background="#33333A" Foreground="#FFFFFF"
                        Click="BtnProcurar_Click" Margin="0,4,0,12"/>
            </Grid>

            <TextBlock x:Name="LblArgumentos" Text="Argumentos (opcional):" FontSize="12" Foreground="#A0A0A5"/>
            <TextBox x:Name="TxtArgumentos"/>
        </StackPanel>

        <!-- Mensagem de erro de validação -->
        <TextBlock x:Name="TxtErro" Grid.Row="2"
                   Foreground="#FF453A"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"
                   Margin="0,0,0,12"/>

        <!-- Botões de Ação -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar"
                    Background="#33333A"
                    Foreground="#FFFFFF"
                    Margin="0,0,10,0"
                    IsCancel="True"/>
            <Button Content="Salvar Item"
                    Background="#0078D4"
                    Foreground="#FFFFFF"
                    Click="BtnSalvar_Click"
                    IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
