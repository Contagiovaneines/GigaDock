<Window x:Class="DockWindows.App.Views.LojaWidgetsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Loja de Widgets" Height="700" Width="900"
        WindowStartupLocation="CenterOwner" Background="#111116" Foreground="#FFFFFF" WindowStyle="ToolWindow">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Border Grid.Row="0" Background="#1C1C22" BorderBrush="#2C2C36" BorderThickness="0,0,0,1" Padding="20">
            <StackPanel>
                <TextBlock Text="Galeria de Widgets" FontSize="26" FontWeight="Bold"/>
                <TextBlock Text="Escolha um widget e selecione a aparência desejada (Ícone ou Detalhado) para adicionar à sua Dock." Foreground="#8E8E93" FontSize="14" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>
        
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
            <ItemsControl x:Name="ListaLoja">
                <ItemsControl.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="18" Foreground="#E0E0E0" Margin="0,20,0,10"/>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                        <GroupStyle.Panel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </GroupStyle.Panel>
                    </GroupStyle>
                </ItemsControl.GroupStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#1C1C22" BorderBrush="#2C2C36" BorderThickness="1" CornerRadius="12" Padding="15" Margin="0,0,15,15" Width="{Binding LarguraCard}" Height="120">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <StackPanel Orientation="Horizontal" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border Width="48" Height="48" CornerRadius="12" Background="{Binding CorIcone}" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Icone}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Nome}" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                                        <TextBlock Text="{Binding DescricaoFormato}" FontSize="11" Foreground="#8E8E93" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                
                                <Button Grid.Row="1" Content="{Binding TextoBotao}" Background="{Binding CorBotao}" 
                                        Foreground="White" BorderThickness="0" FontWeight="Bold" Height="28" Margin="0,10,0,0"
                                        Cursor="Hand" Click="BtnAdicionar_Click" Tag="{Binding}">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
