<Window x:Class="DockWindows.App.Views.LojaWidgetsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Loja de widgets" Width="1180" Height="760" MinWidth="760" MinHeight="520" WindowStartupLocation="CenterOwner" Background="#191C21" Foreground="#F5F7FA" FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Window.Resources>
  <BooleanToVisibilityConverter x:Key="BoolToVis"/>
  <Style x:Key="CategoryStyle" TargetType="RadioButton">
   <Setter Property="Foreground" Value="#D5DAE1"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,2"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
    <Border x:Name="Surface" CornerRadius="9" Padding="12,9" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border x:Name="IconSurface" Width="24" Height="24" CornerRadius="7" Background="#353B45"><TextBlock x:Name="Glyph" Text="◈" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#AAB4C2" FontSize="12"/></Border><ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"/><Ellipse x:Name="ActiveDot" Grid.Column="2" Width="6" Height="6" Fill="#7068FF" Visibility="Collapsed"/></Grid></Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#30353D"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="#393F49"/><Setter TargetName="Surface" Property="BorderBrush" Value="#4A515D"/><Setter TargetName="IconSurface" Property="Background" Value="#6158E8"/><Setter TargetName="Glyph" Property="Foreground" Value="White"/><Setter TargetName="ActiveDot" Property="Visibility" Value="Visible"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#9EA8FF"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PrimaryAction" TargetType="Button"><Setter Property="Background" Value="#6B63F5"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#827BFF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,8"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" CornerRadius="9" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#7B74FF"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#5750D4"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Background" Value="#353A43"/><Setter Property="Foreground" Value="#ADB5C1"/><Setter Property="Cursor" Value="Arrow"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="RemoveAction" TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#FF9A95"/><Setter Property="BorderBrush" Value="#604347"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,7"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" CornerRadius="9" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#38282C"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Border Margin="10" CornerRadius="18" Background="#1D2025" BorderBrush="#434A55" BorderThickness="1" ClipToBounds="True">
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="235"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="#272C33" BorderBrush="#424954" BorderThickness="0,0,1,0"><Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="8,8,8,22"><StackPanel Orientation="Horizontal"><Border Width="34" Height="34" CornerRadius="9" Background="#625AF0" Margin="0,0,10,0"><Image Source="/DockWindows.App;component/Assets/gigadock.ico" Width="26" Height="26"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="GigaDock" FontSize="16" FontWeight="Bold"/><TextBlock Text="Loja de widgets" FontSize="11" Foreground="#98A1AE"/></StackPanel></StackPanel>
     <Border Margin="0,18,0,0" CornerRadius="10" Background="#343941" BorderBrush="#454C57" BorderThickness="1" Padding="10,7"><DockPanel><TextBlock Text="⌕" FontSize="17" Foreground="#9BA5B3" Margin="0,0,8,0"/><TextBox x:Name="TxtBusca" TextChanged="TxtBusca_TextChanged" ToolTip="Buscar widgets" AutomationProperties.Name="Buscar widgets" Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="White" VerticalContentAlignment="Center"/></DockPanel></Border>
    </StackPanel>
    <StackPanel Grid.Row="1"><TextBlock Text="CATEGORIAS" FontSize="10" FontWeight="Bold" Foreground="#88929F" Margin="9,0,0,6"/><RadioButton Style="{StaticResource CategoryStyle}" Content="Todos" IsChecked="True" Checked="Filtro_Checked"/><RadioButton Style="{StaticResource CategoryStyle}" Content="Mídia" Checked="Filtro_Checked"/><RadioButton Style="{StaticResource CategoryStyle}" Content="Sistema" Checked="Filtro_Checked"/><RadioButton Style="{StaticResource CategoryStyle}" Content="Produtividade" Checked="Filtro_Checked"/><RadioButton Style="{StaticResource CategoryStyle}" Content="Utilidade" Checked="Filtro_Checked"/><RadioButton Style="{StaticResource CategoryStyle}" Content="Comunicação" Checked="Filtro_Checked"/></StackPanel>
    <Border Grid.Row="3" Margin="0,14,0,0" Padding="12" CornerRadius="11" Background="#30353D" BorderBrush="#444B56" BorderThickness="1"><StackPanel><TextBlock Text="AMBIENTE EM EDIÇÃO" FontSize="9" FontWeight="Bold" Foreground="#929BA8"/><TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Title}" TextTrimming="CharacterEllipsis" Margin="0,5,0,8" FontWeight="SemiBold"/><TextBlock x:Name="TxtInstaladosBadge" Foreground="#9EA8FF" FontSize="12"/></StackPanel></Border>
   </Grid></Border>
   <Grid Grid.Column="1" Margin="26,22,22,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Widgets" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Leia como funciona e os requisitos antes de instalar. Prévias são ilustrativas." Foreground="#9DA6B3" Margin="0,5,0,18"/></StackPanel><Border Grid.Column="1" Width="38" Height="38" CornerRadius="19" Background="#292E35" BorderBrush="#454C57" BorderThickness="1"><TextBlock Text="⚙" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#CDD3DC"/></Border></Grid>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl x:Name="ListaLoja"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
     <Border Width="395" Margin="0,0,16,16" Padding="14" Background="#24282E" BorderBrush="#3D444E" BorderThickness="1" CornerRadius="15"><StackPanel>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Border Width="38" Height="38" CornerRadius="10" Background="{Binding CorIcone}" Margin="0,0,10,0"><TextBlock Text="{Binding Icone}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Foreground="#E9EDF3" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Nome}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding Categoria}" FontSize="10" Foreground="#929CA9"/></StackPanel></StackPanel><Border Grid.Column="1" Background="#303640" CornerRadius="8" Padding="8,4" VerticalAlignment="Center"><TextBlock Text="{Binding EstadoTexto}" Foreground="{Binding EstadoCor}" FontSize="10" FontWeight="SemiBold"/></Border></Grid>
      <Border Height="132" Margin="0,13,0,11" CornerRadius="14" BorderBrush="#525A68" BorderThickness="1" ClipToBounds="True"><Border.Background><LinearGradientBrush StartPoint="0,1" EndPoint="1,0"><GradientStop Color="#07175B" Offset="0"/><GradientStop Color="#3733C9" Offset="0.52"/><GradientStop Color="#111C70" Offset="1"/></LinearGradientBrush></Border.Background><Grid><Ellipse Width="210" Height="210" Fill="#303CFF" Opacity="0.28" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-105,-60,0"/><Border Padding="14,10" CornerRadius="13" Background="#E7141920" BorderBrush="#70FFFFFF" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding PreviewIcone}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{Binding PreviewCor}" FontSize="25" VerticalAlignment="Center" Margin="0,0,9,0"/><StackPanel><TextBlock Text="{Binding PreviewTitle}" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis" MaxWidth="220"/><TextBlock Text="{Binding PreviewSubtitle}" FontSize="10" Foreground="#C3CBD6" TextTrimming="CharacterEllipsis" MaxWidth="220"/></StackPanel></StackPanel></Border></Grid></Border>
      <TextBlock Text="{Binding Descricao}" TextWrapping="Wrap" Foreground="#B7BEC8" FontSize="11"/><TextBlock Text="COMO FUNCIONA" FontSize="10" FontWeight="SemiBold" Foreground="#CCD6E4" Margin="0,12,0,5"/>
      <TextBlock Text="{Binding ComoFunciona}" TextWrapping="Wrap" Foreground="#C0C8D4" FontSize="12"/>
      <TextBlock Text="REQUISITOS E LIMITES" FontSize="10" FontWeight="SemiBold" Foreground="#CCD6E4" Margin="0,10,0,5"/>
      <TextBlock Text="{Binding Requisitos}" TextWrapping="Wrap" Foreground="#A9B3C2" FontSize="11"/>
      <DockPanel Margin="0,11,0,0"><StackPanel DockPanel.Dock="Left"><TextBlock Text="{Binding DescricaoFormato}" FontSize="10" Foreground="#909AA7"/><TextBlock Text="{Binding EstadoDescricao}" FontSize="10" Foreground="{Binding EstadoCor}" Margin="0,3,0,0"/></StackPanel><StackPanel HorizontalAlignment="Right"><Button Style="{StaticResource PrimaryAction}" Content="{Binding TextoBotao}" IsEnabled="{Binding PodeInstalar}" ToolTip="{Binding Requisitos}" ToolTipService.ShowOnDisabled="True" Click="BtnAdicionar_Click" Tag="{Binding}"/><Button Style="{StaticResource RemoveAction}" Content="Desinstalar" Click="BtnRemover_Click" Tag="{Binding}" Margin="0,7,0,0" Visibility="{Binding JaAdicionado, Converter={StaticResource BoolToVis}}"/></StackPanel></DockPanel>
     </StackPanel></Border>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
   </Grid>
  </Grid>
 </Border>
</Window>
