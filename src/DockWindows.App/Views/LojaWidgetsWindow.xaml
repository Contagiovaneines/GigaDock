<Window x:Class="DockWindows.App.Views.LojaWidgetsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Loja de widgets" Width="1000" Height="700" MinWidth="480" MinHeight="350" WindowStartupLocation="CenterOwner" Background="#101216" Foreground="WhiteSmoke">
 <Window.Resources><BooleanToVisibilityConverter x:Key="BoolToVis"/></Window.Resources>
 <DockPanel Margin="24">
  <StackPanel DockPanel.Dock="Top">
   <TextBlock Text="Loja de widgets" FontSize="28" FontWeight="SemiBold"/>
   <TextBlock Text="Escolha o widget e veja os estilos antes de adicionar. As escolhas pertencem ao ambiente em edição." Foreground="Silver" TextWrapping="Wrap" Margin="0,8,0,16"/>
   <TextBox x:Name="TxtBusca" TextChanged="TxtBusca_TextChanged" ToolTip="Buscar widgets" AutomationProperties.Name="Buscar widgets" Padding="10" Margin="0,0,0,12"/>
   <WrapPanel Margin="0,0,0,16">
    <RadioButton Content="Todos" IsChecked="True" Checked="Filtro_Checked" Margin="0,0,20,8" Foreground="WhiteSmoke"/>
    <RadioButton Content="Mídia" Checked="Filtro_Checked" Margin="0,0,20,8" Foreground="WhiteSmoke"/>
    <RadioButton Content="Sistema" Checked="Filtro_Checked" Margin="0,0,20,8" Foreground="WhiteSmoke"/>
    <RadioButton Content="Produtividade" Checked="Filtro_Checked" Margin="0,0,20,8" Foreground="WhiteSmoke"/>
    <RadioButton Content="Utilidade" Checked="Filtro_Checked" Margin="0,0,20,8" Foreground="WhiteSmoke"/>
    <RadioButton Content="Comunicação" Checked="Filtro_Checked" Margin="0,0,20,8" Foreground="WhiteSmoke"/>
   </WrapPanel>
  </StackPanel>
  <TextBlock DockPanel.Dock="Bottom" x:Name="TxtInstaladosBadge" Foreground="Silver" Margin="0,12,0,0"/>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <ItemsControl x:Name="ListaLoja">
    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate><DataTemplate>
     <Border Width="280" Margin="0,0,16,16" Padding="18" Background="#1B2025" BorderBrush="#384047" BorderThickness="1" CornerRadius="14">
      <StackPanel>
       <TextBlock Text="{Binding Nome}" FontSize="18" FontWeight="SemiBold"/>
       <TextBlock Text="{Binding Descricao}" TextWrapping="Wrap" Foreground="Silver" Height="60" Margin="0,8,0,8"/>
       <Border Background="#111619" CornerRadius="10" Padding="12" Height="70">
        <StackPanel><TextBlock Text="{Binding PreviewTitle}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding DescricaoFormato}" FontSize="12" Foreground="Silver"/></StackPanel>
       </Border>
       <Button Content="{Binding TextoBotao}" Click="BtnAdicionar_Click" Tag="{Binding}" Padding="12,8" Margin="0,14,0,0" Background="#167AC4" Foreground="White"/>
       <Button Content="Remover deste ambiente" Click="BtnRemover_Click" Tag="{Binding}" Padding="8,5" Margin="0,8,0,0" Visibility="{Binding JaAdicionado, Converter={StaticResource BoolToVis}}"/>
      </StackPanel>
     </Border>
    </DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
  </ScrollViewer>
 </DockPanel>
</Window>
