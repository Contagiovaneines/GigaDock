<Window x:Class="DockWindows.App.Views.LojaWidgetsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Widget Store" Height="820" Width="1160"
        WindowStartupLocation="CenterOwner" Background="Transparent" Foreground="#FFFFFF" 
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Border Background="#090A0F" CornerRadius="16" BorderBrush="#1C1E26" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/> <!-- Title Bar -->
                <RowDefinition Height="Auto"/> <!-- Category Tabs -->
                <RowDefinition Height="*"/> <!-- Scroll Content -->
                <RowDefinition Height="40"/> <!-- Status Bar -->
            </Grid.RowDefinitions>

            <!-- TITLE BAR -->
            <Grid Grid.Row="0" MouseLeftButtonDown="Window_MouseLeftButtonDown" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                    <Border Width="24" Height="24" Background="#161821" CornerRadius="6" BorderBrush="#252733" BorderThickness="1">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE713;" FontSize="12" Foreground="#0A84FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="GigaDock" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" Margin="10,0,6,0" VerticalAlignment="Center"/>
                    <Border Background="#252733" CornerRadius="4" Padding="4,2" VerticalAlignment="Center">
                        <TextBlock Text="v3.4" FontSize="10" Foreground="#8E8E93" FontWeight="Bold"/>
                    </Border>
                    <Border Background="#1C2E3C" CornerRadius="12" Padding="8,4" Margin="16,0,0,0" VerticalAlignment="Center" BorderBrush="#20425C" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="#0A84FF" Margin="0,0,6,0"/>
                            <TextBlock Text="DESKTOP CANVAS" FontSize="10" Foreground="#4AA1FF" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Live Preview" FontSize="13" Foreground="#8E8E93" Margin="0,0,24,0"/>
                    <TextBlock Text="Icon Packs" FontSize="13" Foreground="#8E8E93" Margin="0,0,24,0"/>
                    <Border Background="#0A84FF" CornerRadius="14" Padding="14,6" Margin="0,0,24,0">
                        <TextBlock Text="Themes Gallery" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
                    </Border>
                    <TextBlock Text="Widgets" FontSize="13" Foreground="#8E8E93"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                    <Border Width="32" Height="32" Background="#161821" CornerRadius="16" BorderBrush="#252733" BorderThickness="1" Margin="0,0,16,0">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE77B;" FontSize="14" Foreground="#8E8E93" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Button Content="&#xE921;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Background="Transparent" Foreground="#8E8E93" BorderThickness="0" Width="32" Height="32"/>
                    <Button Content="&#xE922;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Background="Transparent" Foreground="#8E8E93" BorderThickness="0" Width="32" Height="32"/>
                    <Button Content="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Background="Transparent" Foreground="#8E8E93" BorderThickness="0" Width="32" Height="32" Click="BtnClose_Click" Cursor="Hand"/>
                </StackPanel>
            </Grid>

            <!-- HEADER TEXT & TABS -->
            <StackPanel Grid.Row="1" Margin="32,10,32,10">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Widget Store" FontSize="32" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <Border Background="#161821" CornerRadius="12" Padding="8,4" Margin="16,0,0,0" VerticalAlignment="Center" BorderBrush="#252733" BorderThickness="1">
                        <TextBlock Text="NATIVE DESKTOP HUB" FontSize="10" Foreground="#0A84FF" FontWeight="Bold"/>
                    </Border>
                    <TextBlock Text="• API v3.4.108 Direct" FontSize="11" Foreground="#5C5C66" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Personalize seu GigaDock com extensões e telemetria nativa com renderização Direct2D de&#x0a;ultra-baixo consumo de memória." 
                               FontSize="14" Foreground="#8E8E93" LineHeight="20"/>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Border Background="#161821" CornerRadius="16" BorderBrush="#252733" BorderThickness="1" Padding="12,6" Width="240" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE721;" Foreground="#5C5C66" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Buscar widgets, ferramentas..." Foreground="#5C5C66" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#161821" CornerRadius="16" BorderBrush="#252733" BorderThickness="1" Padding="16,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE77B;" Foreground="#0A84FF" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Pessoal" Foreground="#FFFFFF" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE70D;" Foreground="#8E8E93" FontSize="10" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Category Filters -->
                <Grid Margin="0,24,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Border Background="#0A84FF" CornerRadius="14" Padding="16,6" Margin="0,0,8,0">
                            <TextBlock Text="Todos" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </Border>
                        <TextBlock Text="Produtividade" FontSize="13" FontWeight="Bold" Foreground="#8E8E93" Margin="12,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Sistema" FontSize="13" FontWeight="Bold" Foreground="#8E8E93" Margin="12,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Comunicação" FontSize="13" FontWeight="Bold" Foreground="#8E8E93" Margin="12,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Desenvolvimento" FontSize="13" FontWeight="Bold" Foreground="#8E8E93" Margin="12,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Mídia &amp; Áudio" FontSize="13" FontWeight="Bold" Foreground="#8E8E93" Margin="12,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#161821" CornerRadius="14" Padding="12,6" Margin="0,0,16,0" BorderBrush="#252733" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="#8E8E93" Margin="0,0,6,0"/>
                                <TextBlock Text="Instalados: 5" FontSize="12" FontWeight="Bold" Foreground="#C8C8CE"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Ordenar por:" FontSize="13" Foreground="#8E8E93" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Mais Populares" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE70D;" Foreground="#8E8E93" FontSize="10" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <Separator Grid.Row="1" VerticalAlignment="Bottom" Background="#1C1E26" Margin="0"/>

            <!-- MAIN CONTENT -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="32,24,32,24">
                <StackPanel>
                    
                    <!-- HERO BANNER -->
                    <Border CornerRadius="16" BorderBrush="#1C1E26" BorderThickness="1" Padding="24" Margin="0,0,0,32">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#12141C" Offset="0"/>
                                <GradientStop Color="#0F1626" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Border Background="#4C1D95" CornerRadius="4" Padding="6,2">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE735;" FontSize="10" Foreground="#FFFFFF" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="DESTAQUE DA SEMANA" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#1C1E26" CornerRadius="4" Padding="6,2" Margin="8,0">
                                        <TextBlock Text="v2.4 DirectX 12" FontSize="10" Foreground="#8E8E93" FontWeight="Bold"/>
                                    </Border>
                                    <TextBlock Text="Desenvolvido por GigaDock Core Labs" FontSize="11" Foreground="#8E8E93" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="Monitor de Sistema Pro" FontSize="28" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    <TextBlock Text="v2" FontSize="20" FontWeight="Light" Foreground="#0A84FF" Margin="8,0,0,0" VerticalAlignment="Bottom"/>
                                </StackPanel>

                                <TextBlock Text="Painel de telemetria ultra-compacto integrado ao rack do dock. Acompanhe oscilações de&#x0a;frame-time, clock por núcleo, uso de VRAM e vazão de barramento PCI-e com renderização&#x0a;a 144Hz e zero impacto em jogos." 
                                           FontSize="13" Foreground="#C8C8CE" LineHeight="22" Margin="0,0,0,24"/>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="DOCK PLACEMENT" FontSize="10" FontWeight="Bold" Foreground="#5C5C66" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                    <Border Background="#090A0F" CornerRadius="18" Padding="12,6" BorderBrush="#1C1E26" BorderThickness="1" Margin="0,0,24,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE9CA;" FontSize="16" Foreground="#0A84FF" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <StackPanel>
                                                <TextBlock Text="4.82 GHz • 38°C" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                <TextBlock Text="GPU 18% | RAM 12.4GB" FontSize="9" Foreground="#8E8E93"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Button Content="Configurar no Dock" Background="#0A84FF" Foreground="White" BorderThickness="0" FontWeight="Bold" FontSize="13" Padding="20,10" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                                        </Button.Resources>
                                    </Button>
                                    <Border Background="#193524" CornerRadius="12" Padding="10,4" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6" Fill="#1DB954" Margin="0,0,6,0"/>
                                            <TextBlock Text="Instalado" FontSize="10" FontWeight="Bold" Foreground="#1DB954"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <!-- Hero Fake Graph -->
                            <Border Grid.Column="1" Background="#090A0F" CornerRadius="12" BorderBrush="#1C1E26" BorderThickness="1" Padding="16" Width="360" VerticalAlignment="Center">
                                <StackPanel>
                                    <Grid Margin="0,0,0,16">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6" Fill="#0A84FF" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="DirectX 12 Telemetry Hook" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="0.4ms Polling" FontSize="10" Foreground="#8E8E93" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    
                                    <Border Height="60" Background="#161821" CornerRadius="4" Margin="0,0,0,16" BorderBrush="#252733" BorderThickness="1"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="MEMÓRIA" FontSize="9" Foreground="#8E8E93" HorizontalAlignment="Center"/>
                                            <TextBlock Text="14.2 / 32 GB" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="GPU VRAM" FontSize="9" Foreground="#8E8E93" HorizontalAlignment="Center"/>
                                            <TextBlock Text="3.8 / 16 GB" FontSize="11" FontWeight="Bold" Foreground="#0A84FF" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="TEMPERATURA" FontSize="9" Foreground="#8E8E93" HorizontalAlignment="Center"/>
                                            <TextBlock Text="41°C" FontSize="11" FontWeight="Bold" Foreground="#1DB954" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- WIDGET GRID TITLE -->
                    <Grid Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Extensões &amp; Módulos Disponíveis" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <Border Background="#1C1E26" CornerRadius="10" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="8 itens" FontSize="10" Foreground="#8E8E93" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Renderizados sob camada isolada DirectComposition" FontSize="11" Foreground="#5C5C66" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- WIDGET GRID -->
                    <ItemsControl x:Name="ListaLoja">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- CARD -->
                                <Border Background="#11131A" BorderBrush="#1C1E26" BorderThickness="1" CornerRadius="16" Margin="0,0,16,16" Width="258" Height="290">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        
                                        <!-- Header: Icon & Tags -->
                                        <Grid Grid.Row="0" Margin="16,16,16,12">
                                            <Border Width="36" Height="36" CornerRadius="18" Background="{Binding CorIcone}" HorizontalAlignment="Left" VerticalAlignment="Top">
                                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="{Binding Icone}" FontSize="16" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                <Border Background="#1C1E26" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding Categoria}" FontSize="9" Foreground="#8E8E93" FontWeight="Bold"/>
                                                </Border>
                                                <Border Background="{Binding CustoBackground}" CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="{Binding Custo}" FontSize="9" Foreground="{Binding CustoForeground}" FontWeight="Bold"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Text Details -->
                                        <StackPanel Grid.Row="1" Margin="16,0,16,0">
                                            <TextBlock Text="{Binding Nome}" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding Descricao}" FontSize="11" Foreground="#8E8E93" LineHeight="16" TextWrapping="Wrap" MaxHeight="48" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <!-- Bottom Section: Preview & Button -->
                                        <StackPanel Grid.Row="2" Margin="16,0,16,16">
                                            <!-- Preview Box -->
                                            <Border Background="#090A0F" BorderBrush="#1C1E26" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,8">
                                                        <TextBlock Text="NO DOCK" FontSize="9" FontWeight="Bold" Foreground="#5C5C66"/>
                                                        <Ellipse Width="4" Height="4" Fill="#1DB954" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                    <!-- Mock Widget Layout -->
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="{Binding PreviewIcone}" FontSize="14" Foreground="{Binding PreviewCor}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding PreviewTitle}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding PreviewSubtitle}" FontSize="9" Foreground="#8E8E93" VerticalAlignment="Center"/>
                                                        
                                                        <ProgressBar Grid.ColumnSpan="3" Visibility="{Binding ShowPreviewBar, Converter={StaticResource BoolToVis}}" 
                                                                     Height="2" Minimum="0" Maximum="100" Value="60" Margin="0,20,0,0" Foreground="{Binding PreviewCor}" Background="#1C1E26"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <!-- Button Row -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <Button Grid.Column="0" Content="{Binding TextoBotao}" Background="{Binding CorBotao}" 
                                                        Foreground="{Binding CorTextoBotao}" BorderBrush="{Binding CorBordaBotao}" BorderThickness="1" 
                                                        FontWeight="Bold" FontSize="12" Height="32" Cursor="Hand" Click="BtnAdicionar_Click" Tag="{Binding}">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="16"/>
                                                        </Style>
                                                    </Button.Resources>
                                                </Button>

                                                <Button Grid.Column="1" Visibility="{Binding JaAdicionado, Converter={StaticResource BoolToVis}}" 
                                                        Content="&#xE712;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" 
                                                        Background="Transparent" Foreground="#8E8E93" BorderBrush="#252733" BorderThickness="1" 
                                                        Width="32" Height="32" Margin="8,0,0,0" Cursor="Hand">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="16"/>
                                                        </Style>
                                                    </Button.Resources>
                                                </Button>
                                            </Grid>
                                        </StackPanel>

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>
            
            <!-- STATUS BAR -->
            <Border Grid.Row="3" Background="#090A0F" BorderBrush="#1C1E26" BorderThickness="0,1,0,0" CornerRadius="0,0,16,16">
                <Grid Margin="24,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="#0A84FF" Margin="0,0,8,0"/>
                        <TextBlock Text="8 de 12 slots de dock ocupados" FontSize="11" Foreground="#8E8E93" VerticalAlignment="Center"/>
                        <TextBlock Text="|" FontSize="11" Foreground="#333340" Margin="12,0" VerticalAlignment="Center"/>
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE90C;" FontSize="12" Foreground="#1DB954" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Aceleração gráfica por hardware ativa (144 FPS)" FontSize="11" Foreground="#C8C8CE" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE72E;" FontSize="12" Foreground="#5C5C66" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Sandbox Isolada" FontSize="10" Foreground="#5C5C66" VerticalAlignment="Center"/>
                        <TextBlock Text="PERFIL ATIVO:" FontSize="9" FontWeight="Bold" Foreground="#5C5C66" Margin="16,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Pessoal" FontSize="11" Foreground="#0A84FF" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
