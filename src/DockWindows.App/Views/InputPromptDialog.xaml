<Window x:Class="DockWindows.App.Views.InputPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GigaDock"
        Width="380"
        Height="210"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1E1E22"
        Foreground="#FFFFFF"
        FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtTitulo"
                   Text="Entrada de Dados"
                   FontSize="16"
                   FontWeight="Bold"
                   Foreground="#0A84FF"
                   Margin="0,0,0,10"/>

        <TextBlock x:Name="TxtPrompt"
                   Grid.Row="1"
                   Text="Digite o valor:"
                   FontSize="13"
                   Foreground="#A0A0A5"
                   Margin="0,0,0,8"/>

        <TextBox x:Name="TxtValor"
                 Grid.Row="2"
                 Background="#2A2A30"
                 Foreground="#FFFFFF"
                 BorderBrush="#44444E"
                 Padding="8,6"
                 FontSize="13"
                 VerticalAlignment="Top"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancelar"
                    Padding="14,6"
                    Background="#33333A"
                    Foreground="#FFFFFF"
                    Margin="0,0,10,0"
                    IsCancel="True"
                    Cursor="Hand"/>
            <Button Content="Confirmar"
                    Padding="14,6"
                    Background="#0078D4"
                    Foreground="#FFFFFF"
                    Click="BtnConfirmar_Click"
                    IsDefault="True"
                    Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>

