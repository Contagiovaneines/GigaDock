<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:DockWindows.App.Converters">
    <conv:ColorToBrushConverter x:Key="DockControlsBrush"/>
    <!-- Uma linguagem visual única: vetores próprios, traço e tamanho constantes. -->
    <Geometry x:Key="DockIconTaskbar">M4,3 H20 Q22,3 22,5 V19 Q22,21 20,21 H4 Q2,21 2,19 V5 Q2,3 4,3 Z M2,16 H22 M6,19 H9 M12,19 H15 M10,10 L12,8 L14,10</Geometry>
    <Geometry x:Key="DockIconAdd">M12,4 V20 M4,12 H20</Geometry>
    <Geometry x:Key="DockIconSettings">M9.5,2 H14.5 L15,5 L17,6 L20,5 L22,9 L19.5,11 V13 L22,15 L20,19 L17,18 L15,19 L14.5,22 H9.5 L9,19 L7,18 L4,19 L2,15 L4.5,13 V11 L2,9 L4,5 L7,6 L9,5 Z M15.5,12 A3.5,3.5 0 1 0 8.5,12 A3.5,3.5 0 1 0 15.5,12</Geometry>
    <Geometry x:Key="DockIconTray">M5,15 L12,8 L19,15</Geometry>
    <Geometry x:Key="DockIconSliders">M3,6 H7 M11,6 H21 M3,12 H13 M17,12 H21 M3,18 H7 M11,18 H21 M7,4 H11 V8 H7 Z M13,10 H17 V14 H13 Z M7,16 H11 V20 H7 Z</Geometry>
    <Geometry x:Key="DockIconLock">M8,10 V7 A4,4 0 0 1 16,7 V10 M6,10 H18 Q20,10 20,12 V20 Q20,22 18,22 H6 Q4,22 4,20 V12 Q4,10 6,10 Z M12,15 V18</Geometry>
    <Style x:Key="DockControlIcon" TargetType="Path">
        <Setter Property="Width" Value="20"/><Setter Property="Height" Value="20"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        <Setter Property="StrokeThickness" Value="1.65"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/><Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
    </Style>
    <Style x:Key="DockControlButton" TargetType="Button">
        <Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Margin" Value="1,0"/><Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="{Binding DataContext.FundoControlesColor, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource DockControlsBrush}}"/>
        <Setter Property="Foreground" Value="{Binding DataContext.TextoPrincipalColor, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource DockControlsBrush}}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="11" BorderThickness="1" BorderBrush="Transparent"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Border x:Name="Focus" CornerRadius="11" BorderThickness="1.5" BorderBrush="{TemplateBinding Foreground}" Visibility="Collapsed" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Setter TargetName="Surface" Property="Opacity" Value="0.12"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.22"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="Visibility" Value="Visible"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
