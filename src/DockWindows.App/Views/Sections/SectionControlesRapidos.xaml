<UserControl x:Class="DockWindows.App.Views.Sections.SectionControlesRapidos"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DockWindows.App.Converters">
 <UserControl.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"><MenuItem Header="Personalizar&#x2026;" Command="{Binding ControlesRapidos.AbrirCommand}"/></ContextMenu></UserControl.ContextMenu>

    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="QuickBoolToVis"/>
        <Style x:Key="QuickButton" TargetType="Button">
            <Setter Property="Background" Value="#171B19"/>
            <Setter Property="Foreground" Value="#EEEEEB"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#343B35"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#A7D9BF"/>
                                <Setter TargetName="Surface" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QuickDockButton" TargetType="Button" BasedOn="{StaticResource QuickButton}">
            <Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.ControlesRapidos.Estilo, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Anéis">
                    <Setter Property="Width" Value="42"/><Setter Property="Height" Value="42"/>
                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                        <Border x:Name="Ring" CornerRadius="22" Background="#171F21" BorderBrush="{Binding Cor}" BorderThickness="2.5"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="BorderBrush" Value="White"/></Trigger></ControlTemplate.Triggers>
                    </ControlTemplate></Setter.Value></Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DockVisibilitySwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Width="56" Height="28" CornerRadius="14" Background="#383C36">
                            <Ellipse x:Name="Thumb" Width="22" Height="22" Margin="3" Fill="#8A8D85" HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="#EFEFEA"/>
                                <Setter TargetName="Track" Property="Background" Value="#51584D"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="#B7DCC6"/>
                                <Setter TargetName="Track" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <StackPanel Orientation="Horizontal" DataContext="{Binding ControlesRapidos}" VerticalAlignment="Center">
        <Button x:Name="OpenButton" Style="{StaticResource QuickButton}" Width="30" Height="30" Margin="2,0"
                Command="{Binding AbrirCommand}" ToolTip="Controles rápidos" AutomationProperties.Name="Controles rápidos">
            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE713;" FontSize="15"/>
        </Button>
        <ItemsControl ItemsSource="{Binding Fixados}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource QuickDockButton}" Margin="2,0"
                            Command="{Binding ExecutarCommand}" ToolTip="{Binding Ajuda}" AutomationProperties.Name="{Binding Nome}">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="{Binding Icone}" Foreground="{Binding Cor}" FontSize="16"/>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Style="{StaticResource QuickButton}" Command="{Binding LiberarTecladoCommand}" Margin="4,0" Padding="8,4"
                Visibility="{Binding TecladoBloqueado, Converter={StaticResource QuickBoolToVis}}"
                ToolTip="Liberar teclado agora. F12 também libera." AutomationProperties.Name="Liberar teclado">
            <TextBlock Text="Liberar · F12" Foreground="#54C5B2" FontSize="11"/>
        </Button>
        <Popup x:Name="PanelPopup" IsOpen="{Binding Aberto, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True"
               Placement="Top" PlacementTarget="{Binding ElementName=OpenButton}" Opened="PanelPopup_Opened">
            <Border x:Name="Panel" Width="390" CornerRadius="22" Padding="18" Margin="0,0,0,10"
                    Background="#F7131916" BorderBrush="#405249" BorderThickness="1"
                    PreviewKeyDown="Panel_PreviewKeyDown">
                <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="7" Opacity=".48"/></Border.Effect>
                <StackPanel>
                    <Grid Margin="2,0,2,18" Height="36" Visibility="{Binding ExibindoInicio, Converter={StaticResource QuickBoolToVis}}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Controles rápidos" Foreground="#F2F5F1" FontSize="20" FontWeight="SemiBold"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#202A24" CornerRadius="14" MinWidth="30" Height="28" Padding="8,0" Margin="10,0,8,0"
                                ToolTip="Atalhos visíveis na dock">
                            <TextBlock Text="{Binding Quantidade}" Foreground="#B8C7BD" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Button Grid.Column="2" Style="{StaticResource QuickButton}" Width="32" Height="32"
                                Content="×" FontSize="21" Background="#1B2420" Foreground="#DDE7E1"
                                Command="{Binding FecharCommand}" AutomationProperties.Name="Fechar controles rápidos"/>
                    </Grid>
                    <Grid Margin="0,0,0,12" Visibility="{Binding ExibindoWifi, Converter={StaticResource QuickBoolToVis}}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Button Style="{StaticResource QuickButton}" Width="34" Height="34" Command="{Binding VoltarCommand}" Content="←" FontSize="20" AutomationProperties.Name="Voltar"/>
                        <StackPanel Grid.Column="1" Margin="10,0"><TextBlock Text="Wi-Fi" Foreground="White" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Redes próximas" Foreground="#9FA9A2"/></StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource QuickButton}" Width="34" Height="34" Command="{Binding Conectividade.AtualizarCommand}" Content="↻" FontSize="18" AutomationProperties.Name="Atualizar redes Wi-Fi"/>
                    </Grid>
                    <StackPanel Visibility="{Binding ExibindoWifi, Converter={StaticResource QuickBoolToVis}}">
                        <ScrollViewer MaxHeight="390" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Conectividade.RedesWifi}">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Button Style="{StaticResource QuickButton}" HorizontalContentAlignment="Stretch" Margin="0,0,0,7" Padding="12" Command="{Binding DataContext.Conectividade.ConectarWifiCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="&#xE701;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#59AFFF" FontSize="24" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <StackPanel Grid.Column="1"><TextBlock Text="{Binding Nome}" Foreground="White" FontSize="15" FontWeight="SemiBold"/><TextBlock Foreground="#AEB7B1" FontSize="12"><Run Text="Sinal "/><Run Text="{Binding Intensidade}"/><Run Text="%  ·  "/><Run Text="{Binding Segura, StringFormat=Segura: {0}}"/></TextBlock></StackPanel>
                                            <TextBlock Grid.Column="2" Text="›" Foreground="#DDE4DF" FontSize="24" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Button Style="{StaticResource QuickButton}" HorizontalContentAlignment="Left" Padding="12" Margin="0,6,0,0" Command="{Binding Conectividade.AbrirRedeCommand}" Content="Mais configurações de Wi-Fi"/>
                    </StackPanel>
                    <Grid Margin="0,0,0,12" Visibility="{Binding ExibindoBluetooth, Converter={StaticResource QuickBoolToVis}}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Button Style="{StaticResource QuickButton}" Width="34" Height="34" Command="{Binding VoltarCommand}" Content="←" FontSize="20" AutomationProperties.Name="Voltar"/>
                        <StackPanel Grid.Column="1" Margin="10,0"><TextBlock Text="Bluetooth" Foreground="White" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Conectados e disponíveis" Foreground="#9FA9A2"/></StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource QuickButton}" Width="34" Height="34" Command="{Binding Conectividade.AtualizarCommand}" Content="↻" FontSize="18"/>
                    </Grid>
                    <StackPanel Visibility="{Binding ExibindoBluetooth, Converter={StaticResource QuickBoolToVis}}">
                        <TextBlock Text="Novos dispositivos" Foreground="White" FontWeight="SemiBold" FontSize="15" Margin="4,0,0,9"/>
                        <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Conectividade.Bluetooth}"><ItemsControl.ItemTemplate><DataTemplate>
                                <Button Style="{StaticResource QuickButton}" HorizontalContentAlignment="Stretch" Margin="0,0,0,7" Padding="12" Command="{Binding DataContext.Conectividade.SelecionarBluetoothCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE702;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#5AAEFF" FontSize="23" Margin="0,0,12,0"/>
                                        <StackPanel Grid.Column="1"><TextBlock Text="{Binding Nome}" Foreground="White" FontSize="15"/><TextBlock Text="{Binding Conectado, StringFormat=Conectado: {0}}" Foreground="#AEB7B1" FontSize="12"/></StackPanel>
                                        <TextBlock Grid.Column="2" Text="›" Foreground="#DDE4DF" FontSize="24"/>
                                    </Grid>
                                </Button>
                            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        </ScrollViewer>
                        <Button Style="{StaticResource QuickButton}" HorizontalContentAlignment="Left" Padding="12" Margin="0,6,0,0" Command="{Binding Conectividade.AbrirBluetoothCommand}" Content="Mais configurações de Bluetooth"/>
                    </StackPanel>
                    <StackPanel Visibility="{Binding ExibindoInicio, Converter={StaticResource QuickBoolToVis}}">
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="APARÊNCIA NESTE AMBIENTE" Foreground="#82948A" FontSize="10" FontWeight="SemiBold" Margin="2,0,0,8"/>
                            <ListBox ItemsSource="{Binding EstilosDisponiveis}" SelectedItem="{Binding Estilo, Mode=TwoWay}"
                                     Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     AutomationProperties.Name="Estilo dos controles rápidos">
                                <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Foreground" Value="#B7C5BC"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Margin" Value="0,0,8,0"/>
                                        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Choice" Height="58" Background="#1A231F" BorderBrush="#34483E" BorderThickness="1" CornerRadius="14" Padding="10,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border x:Name="Preview" Width="36" Height="36" Background="#213029" CornerRadius="10" Margin="0,0,10,0">
                                                        <TextBlock Text="&#xE701;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#4CA6FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ContentPresenter VerticalAlignment="Center" TextElement.FontSize="12" TextElement.FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding}" Value="Anéis"><Setter TargetName="Preview" Property="CornerRadius" Value="18"/><Setter TargetName="Preview" Property="BorderBrush" Value="#4CA6FF"/><Setter TargetName="Preview" Property="BorderThickness" Value="2"/></DataTrigger>
                                                <Trigger Property="IsSelected" Value="True"><Setter TargetName="Choice" Property="BorderBrush" Value="#58D3A0"/><Setter TargetName="Choice" Property="Background" Value="#1E3A2E"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Choice" Property="Background" Value="#283A31"/><Setter TargetName="Choice" Property="BorderBrush" Value="#4C6A5A"/></Trigger>
                                                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Choice" Property="BorderBrush" Value="White"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate></Setter.Value></Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </StackPanel>
                    </StackPanel>
                    <ScrollViewer x:Name="OptionsScroller" MaxHeight="420" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" Visibility="{Binding ExibindoInicio, Converter={StaticResource QuickBoolToVis}}">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar">
                                <Setter Property="Width" Value="8"/>
                                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
                                    <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
                                        <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
                                        <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#52675B" CornerRadius="3" Margin="2,0"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                                        <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
                                    </Track>
                                </ControlTemplate></Setter.Value></Setter>
                            </Style>
                        </ScrollViewer.Resources>
                        <ItemsControl ItemsSource="{Binding Itens}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="17" Padding="10" Margin="0,0,0,7" Background="#1B2520">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Button Style="{StaticResource QuickButton}" Background="Transparent" HorizontalContentAlignment="Stretch"
                                                    Command="{Binding ExecutarCommand}" ToolTip="{Binding Ajuda}" AutomationProperties.Name="{Binding Nome}">
                                                <Grid Margin="0,0,10,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <Border Width="43" Height="43" CornerRadius="22" Background="#263027" Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding Icone}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                   Foreground="{Binding Cor}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Nome}" TextWrapping="Wrap" Foreground="#E5E8E0" FontSize="16" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#9A9F91" FontSize="12" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                            <CheckBox x:Name="VisibilityToggle" Grid.Column="1" Style="{StaticResource DockVisibilitySwitch}"
                                                      VerticalAlignment="Center" IsChecked="{Binding MostrarNaDock, Mode=TwoWay}"
                                                      ToolTip="Mostrar este controle na dock" AutomationProperties.Name="{Binding Nome, StringFormat=Mostrar {0} na dock}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="Os interruptores mostram ou ocultam os atalhos." FontSize="11" Foreground="#8A9180" Visibility="{Binding ExibindoInicio, Converter={StaticResource QuickBoolToVis}}"
                               TextWrapping="Wrap" Margin="4,5,4,0"/>
                </StackPanel>
            </Border>
        </Popup>
    </StackPanel>
</UserControl>
