<UserControl x:Class="DockWindows.App.Views.Sections.SectionColecoes"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DockWindows.App.Converters"
             xmlns:vm="clr-namespace:DockWindows.App.ViewModels">

    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InvertBoolToVis"/>
        <conv:ColorToBrushConverter x:Key="ColorToBrushConverter"/>
    </UserControl.Resources>

    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <ItemsControl ItemsSource="{Binding TodasColecoesAtivas}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ColecaoAppViewModel}">
                    <Grid Margin="{Binding DataContext.MargemItem, RelativeSource={RelativeSource AncestorType=Window}}">
                        <!-- Botão da Coleção no Dock com Magnificação no Hover -->
                                                <Button Command="{Binding AlternarPainelCommand}"
                                ToolTip="{Binding TextoDica}"
                                Padding="3,2,3,2"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand">
                            <Button.ContextMenu>
                                <ContextMenu Background="#1A1A1E" Foreground="#FFFFFF" BorderBrush="#32323C">
                                    <MenuItem Header="Editar Coleção" Command="{Binding EditarColecaoCommand}">
                                        <MenuItem.Icon>
                                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE70F;" FontSize="14" Foreground="#0A84FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator Background="#32323C"/>
                                    <MenuItem Header="Remover Coleção" Command="{Binding RemoverColecaoCommand}">
                                        <MenuItem.Icon>
                                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE74D;" FontSize="14" Foreground="#EF4444" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="ColBorder" CornerRadius="10" Background="Transparent" Padding="{TemplateBinding Padding}">
                                        <Grid RenderTransformOrigin="0.5,0.5">
                                            <Grid.RenderTransform>
                                                <ScaleTransform x:Name="ColScale" ScaleX="1.0" ScaleY="1.0"/>
                                            </Grid.RenderTransform>

                                            <!-- Ícone da Coleção estilo Pasta/Launchpad Apple -->
                                            <Grid Width="{Binding DataContext.TamanhoIconeNumerico, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  Height="{Binding DataContext.TamanhoIconeNumerico, RelativeSource={RelativeSource AncestorType=Window}}">
                                                <Border CornerRadius="9" Background="#28FFFFFF" BorderThickness="1" BorderBrush="#50FFFFFF"
                                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                    <Grid>
                                                        <!-- Grade 2x2 com miniaturas dos apps internos -->
                                                        <UniformGrid Columns="2" Rows="2" Margin="3"
                                                                     Visibility="{Binding TemItens, Converter={StaticResource BoolToVis}}">
                                                            <Border Margin="1" CornerRadius="3" Background="#20FFFFFF">
                                                                <Image Source="{Binding Miniatura1}" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            </Border>
                                                            <Border Margin="1" CornerRadius="3" Background="#20FFFFFF">
                                                                <Image Source="{Binding Miniatura2}" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            </Border>
                                                            <Border Margin="1" CornerRadius="3" Background="#20FFFFFF">
                                                                <Image Source="{Binding Miniatura3}" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            </Border>
                                                            <Border Margin="1" CornerRadius="3" Background="#20FFFFFF">
                                                                <Image Source="{Binding Miniatura4}" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            </Border>
                                                        </UniformGrid>

                                                        <!-- Fallback se não houver itens -->
                                                        <TextBlock Text="{Binding Icone}" FontSize="18"
                                                                   Visibility="{Binding TemItens, Converter={StaticResource InvertBoolToVis}}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>

                                                <!-- Badge com Contagem de Itens -->
                                                <Border Background="#FF3B30" CornerRadius="8"
                                                        MinWidth="16" Height="16" Padding="4,0"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0"
                                                        Visibility="{Binding DataContext.ExibirContagemColecoes, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding QuantidadeItens}" FontSize="10" FontWeight="Bold"
                                                               Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ColBorder" Property="Background" Value="#25FFFFFF"/>
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="ColScale" Storyboard.TargetProperty="ScaleX"
                                                                         To="1.18" Duration="0:0:0.12">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="ColScale" Storyboard.TargetProperty="ScaleY"
                                                                         To="1.18" Duration="0:0:0.12">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="ColScale" Storyboard.TargetProperty="ScaleX"
                                                                         To="1.0" Duration="0:0:0.12">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="ColScale" Storyboard.TargetProperty="ScaleY"
                                                                         To="1.0" Duration="0:0:0.12">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="ColBorder" Property="Background" Value="#45FFFFFF"/>
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="ColScale" Storyboard.TargetProperty="ScaleX" To="0.95" Duration="0:0:0.08"/>
                                                        <DoubleAnimation Storyboard.TargetName="ColScale" Storyboard.TargetProperty="ScaleY" To="0.95" Duration="0:0:0.08"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- FLYOUT POPUP ESTILO APPLE (IMAGEM 2) -->
                        <Popup IsOpen="{Binding PainelAberto, Mode=TwoWay}"
                               StaysOpen="False"
                               Placement="Top"
                               AllowsTransparency="True">
                            <Border Background="#E61E2129" BorderBrush="#50FFFFFF" BorderThickness="1"
                                    CornerRadius="18" Padding="16,14" Margin="0,0,0,12" MinWidth="260" MaxWidth="340">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.55" Color="Black"/>
                                </Border.Effect>
                                <StackPanel>
                                    <!-- Título Centralizado estilo Apple (Imagem 2) -->
                                    <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" FontSize="14"
                                               Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,2,0,14"/>

                                    <!-- Grade 2 Colunas com Ícone Grande e Nome Embaixo (Imagem 2) -->
                                    <ItemsControl ItemsSource="{Binding Itens}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:ItemViewModel}">
                                                <Button Command="{Binding DataContext.ExecutarItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent" BorderThickness="0"
                                                        Padding="10,8" Margin="4" Cursor="Hand" ToolTip="{Binding TextoDica}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="AppBorder" CornerRadius="12" Background="Transparent" Padding="{TemplateBinding Padding}">
                                                                <StackPanel HorizontalAlignment="Center">
                                                                    <Grid Width="42" Height="42" Margin="0,0,0,6">
                                                                        <Image Source="{Binding Icone}" RenderOptions.BitmapScalingMode="HighQuality"
                                                                               Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        <Border Background="#253341" CornerRadius="10" BorderThickness="1" BorderBrush="#35FFFFFF"
                                                                                Visibility="{Binding Icone, Converter={StaticResource InvertBoolToVis}}">
                                                                            <TextBlock Text="✦" FontSize="16" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                    </Grid>
                                                                    <TextBlock Text="{Binding Titulo}" FontSize="11" Foreground="#FFFFFF"
                                                                               TextTrimming="CharacterEllipsis" MaxWidth="90" HorizontalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="AppBorder" Property="Background" Value="#25FFFFFF"/>
                                                                </Trigger>
                                                                <Trigger Property="IsPressed" Value="True">
                                                                    <Setter TargetName="AppBorder" Property="Background" Value="#40FFFFFF"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Linha divisória -->
                                    <Separator Background="#35FFFFFF" Margin="2,12,2,8"/>

                                    <!-- Botão de Rodapé "Editar Coleção..." estilo Imagem 2 -->
                                    <Button Command="{Binding EditarColecaoCommand}"
                                            Background="Transparent" BorderThickness="0"
                                            Foreground="#E2E8F0" FontSize="11" FontWeight="SemiBold"
                                            HorizontalAlignment="Center" Cursor="Hand" Padding="8,4">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="⚙️" FontSize="11" Margin="0,0,6,0"/>
                                            <TextBlock Text="Editar Coleção..."/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>




