<UserControl x:Class="DockWindows.App.Views.Sections.SectionMascotePokemonInline"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:DockWindows.App.Controls"
 xmlns:atividade="clr-namespace:DockWindows.App.Common" atividade:AtividadeVisual.Componente="MascotePokemon"
 Height="44" ClipToBounds="True" ToolTip="{Binding MascotePokemon.Descricao}"
 AutomationProperties.Name="{Binding MascotePokemon.Descricao}">
 <Canvas x:Name="Track">
  <Image x:Name="Pet" Width="44" Height="44" Stretch="Uniform" Canvas.Bottom="0"
   RenderOptions.BitmapScalingMode="NearestNeighbor" RenderTransformOrigin="0.5,0.5">

   <Image.RenderTransform><ScaleTransform x:Name="Facing"/></Image.RenderTransform>
  </Image>
  <controls:PokemonEvolutionEffect x:Name="EvolutionEffect" Width="64" Height="56" Canvas.Bottom="0" Visibility="Collapsed" IsHitTestVisible="False"/>
 </Canvas>
</UserControl>
