<UserControl x:Class="DockWindows.App.Views.Sections.SectionIniciarPesquisa"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DockWindows.App.Converters"
             xmlns:vm="clr-namespace:DockWindows.App.ViewModels">

    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InvertBoolToVis"/>
        <conv:ColorToBrushConverter x:Key="ColorToBrushConverter"/>
    </UserControl.Resources>

    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <!-- Botão Iniciar / Launchpad -->
        <Button x:Name="BtnIniciar"
                Command="{Binding AbrirMenuIniciarCommand}"
                Margin="{Binding DataContext.MargemItem, RelativeSource={RelativeSource AncestorType=Window}}"
                Padding="3"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                ToolTip="Menu Iniciar / Launchpad (Win)"
                AutomationProperties.Name="Menu Iniciar">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="StartBorder" CornerRadius="10" Padding="{TemplateBinding Padding}" Background="Transparent">
                        <Grid RenderTransformOrigin="0.5,0.5"
                              Width="{Binding DataContext.TamanhoIconeNumerico, RelativeSource={RelativeSource AncestorType=Window}}"
                              Height="{Binding DataContext.TamanhoIconeNumerico, RelativeSource={RelativeSource AncestorType=Window}}">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="StartScale" ScaleX="1.0" ScaleY="1.0"/>
                            </Grid.RenderTransform>

                            <!-- Squircle com Gradiente translúcido estilo Apple/Windows 11 -->
                            <!-- Squircle Preto com Terminal Icon -->
                            <Border CornerRadius="9" BorderThickness="1" BorderBrush="#20FFFFFF" Background="#1C1C1E">
                                <TextBlock Text="&gt;_" Foreground="#FFFFFF" FontSize="18" FontFamily="Consolas" 
                                           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,4"/>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="StartBorder" Property="Background" Value="#25FFFFFF"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="StartScale" Storyboard.TargetProperty="ScaleX" To="1.18" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="StartScale" Storyboard.TargetProperty="ScaleY" To="1.18" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="StartScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="StartScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="StartBorder" Property="Background" Value="#45FFFFFF"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="StartScale" Storyboard.TargetProperty="ScaleX" To="0.95" Duration="0:0:0.08"/>
                                        <DoubleAnimation Storyboard.TargetName="StartScale" Storyboard.TargetProperty="ScaleY" To="0.95" Duration="0:0:0.08"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- FLYOUT LAUNCHPAD / MENU INICIAR ESTILO APPLE / VIDRO LÍQUIDO -->
        <Popup x:Name="PopupLaunchpad"
               IsOpen="{Binding MenuIniciarAberto, Mode=TwoWay}"
               StaysOpen="False"
               Placement="Top"
               PlacementTarget="{Binding ElementName=BtnIniciar}"
               VerticalOffset="-12"
               AllowsTransparency="True"
               Opened="PopupLaunchpad_Opened">
            <Border Background="#F213161F" BorderBrush="#45FFFFFF" BorderThickness="1"
                    CornerRadius="18" Padding="18,16,18,14" Margin="0,0,0,12" Width="520" MaxHeight="560">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.6" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Top Bar / Ambientes -->
                        <RowDefinition Height="Auto"/> <!-- Campo de Busca -->
                        <RowDefinition Height="*"/>    <!-- Grade de Aplicativos / Atalhos -->
                        <RowDefinition Height="Auto"/> <!-- Barra de Ações Rápidas (Rodapé) -->
                    </Grid.RowDefinitions>

                    <!-- Linha 0: Cabeçalho com Título e Seletor Rápido de Ambientes -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🚀" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Launchpad" FontWeight="Bold" FontSize="15" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Pílulas de Seleção de Ambiente (Trabalho, Estudos, Pessoal) -->
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Ambientes}" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.TrocarAmbienteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Margin="3,0" Padding="8,4" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="EnvPill" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#15FFFFFF"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding EstaAtivo}" Value="True">
                                                                    <Setter Property="Background" Value="#350A84FF"/>
                                                                    <Setter Property="BorderBrush" Value="#800A84FF"/>
                                                                    <Setter Property="BorderThickness" Value="1"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Icone}" FontSize="11" Margin="0,0,4,0"/>
                                                        <TextBlock Text="{Binding Nome}" FontSize="11" FontWeight="SemiBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding EstaAtivo}" Value="True">
                                                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <!-- Linha 1: Campo de Busca com Estilo Vidro Líquido -->
                    <Border Grid.Row="1" Background="#20FFFFFF" BorderBrush="#35FFFFFF" BorderThickness="1"
                            CornerRadius="10" Padding="8,6" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔍" FontSize="13" Foreground="#94A3B8" Margin="4,0,8,0" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="TxtBuscaLaunchpad"
                                     Text="{Binding TextoFiltroLaunchpad, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="TxtBuscaLaunchpad_KeyDown"
                                     Background="Transparent" BorderThickness="0" Foreground="#F8FAFC" FontSize="13"
                                     CaretBrush="#FFFFFF" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" Click="LimparBusca_Click" Background="Transparent" BorderThickness="0"
                                    Foreground="#94A3B8" Cursor="Hand" Padding="4,0" ToolTip="Limpar busca"
                                    Visibility="{Binding TextoFiltroLaunchpad, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="✕" FontSize="11"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Linha 2: Grade de Aplicativos e Atalhos com Rolagem Suave -->
                    <ScrollViewer Grid.Row="2" MaxHeight="340" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding ItensLaunchpadFiltrados}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:LaunchpadItemModel}">
                                    <Button Command="{Binding ExecutarCommand}"
                                            Margin="4" Padding="6,8"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            ToolTip="{Binding Subtitulo}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="ItemBox" CornerRadius="12" Background="#12FFFFFF" BorderBrush="Transparent" BorderThickness="1"
                                                        Padding="{TemplateBinding Padding}">
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <!-- Ícone com Magnificação -->
                                                        <Grid Width="46" Height="46" Margin="0,0,0,6">
                                                            <Image Source="{Binding Icone}"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                                   Width="44" Height="44" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            <Border Background="#253341" CornerRadius="10"
                                                                    Visibility="{Binding Icone, Converter={StaticResource InvertBoolToVis}}"
                                                                    Width="44" Height="44">
                                                                <TextBlock Text="{Binding IconeTexto}" FontSize="20" Foreground="#94A3B8"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <!-- Ponto indicador de aberto/ativo -->
                                                            <Ellipse Width="6" Height="6" Fill="#0A84FF"
                                                                     Visibility="{Binding EstaAberto, Converter={StaticResource BoolToVis}}"
                                                                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0"/>
                                                        </Grid>
                                                        <!-- Nome do Aplicativo / Item -->
                                                        <TextBlock Text="{Binding Titulo}"
                                                                   FontSize="11"
                                                                   FontWeight="Medium"
                                                                   Foreground="#E2E8F0"
                                                                   TextAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   MaxWidth="96"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemBox" Property="Background" Value="#30FFFFFF"/>
                                                        <Setter TargetName="ItemBox" Property="BorderBrush" Value="#60FFFFFF"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="ItemBox" Property="Background" Value="#50FFFFFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Linha 3: Barra de Ações Rápidas (Rodapé) -->
                    <Border Grid.Row="3" Margin="0,12,0,0" Padding="0,10,0,0" BorderThickness="0,1,0,0" BorderBrush="#25FFFFFF">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Ações à esquerda: Ajustes e Explorador -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Button Command="{Binding AbrirConfiguracoesCommand}"
                                        Content="⚙️ Ajustes"
                                        Padding="8,5" Margin="0,0,6,0"
                                        Background="#18FFFFFF" Foreground="#CBD5E1" FontSize="11" FontWeight="Medium"
                                        BorderThickness="0" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border CornerRadius="8" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button Command="{Binding AbrirExploradorCommand}"
                                        Content="📁 Arquivos"
                                        Padding="8,5"
                                        Background="#18FFFFFF" Foreground="#CBD5E1" FontSize="11" FontWeight="Medium"
                                        BorderThickness="0" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border CornerRadius="8" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>

                            <!-- Ações à direita: Iniciar do Windows e Sair -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Command="{Binding AbrirIniciarNativoWindowsCommand}"
                                        Content="🪟 Iniciar do Windows"
                                        ToolTip="Abrir o menu Iniciar nativo do Windows"
                                        Padding="8,5" Margin="0,0,6,0"
                                        Background="#12FFFFFF" Foreground="#94A3B8" FontSize="11"
                                        BorderThickness="0" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border CornerRadius="8" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button Command="{Binding SairCommand}"
                                        Content="🚪 Sair"
                                        ToolTip="Encerrar o Dock Windows e restaurar o sistema"
                                        Padding="8,5"
                                        Background="#25EF4444" Foreground="#FCA5A5" FontSize="11" FontWeight="SemiBold"
                                        BorderThickness="0" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border CornerRadius="8" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Popup>

        <!-- Botão Pesquisa / Spotlight -->
        <Button x:Name="BtnPesquisar"
                Command="{Binding AbrirPesquisaCommand}"
                Margin="{Binding DataContext.MargemItem, RelativeSource={RelativeSource AncestorType=Window}}"
                Padding="3"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                ToolTip="Pesquisar no Launchpad (Win + S)"
                AutomationProperties.Name="Pesquisar">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="SearchBorder" CornerRadius="10" Padding="{TemplateBinding Padding}" Background="Transparent">
                        <Grid RenderTransformOrigin="0.5,0.5"
                              Width="{Binding DataContext.TamanhoIconeNumerico, RelativeSource={RelativeSource AncestorType=Window}}"
                              Height="{Binding DataContext.TamanhoIconeNumerico, RelativeSource={RelativeSource AncestorType=Window}}">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="SearchScale" ScaleX="1.0" ScaleY="1.0"/>
                            </Grid.RenderTransform>

                            <!-- Squircle com Gradiente translúcido estilo Spotlight -->
                            <Border CornerRadius="9" BorderThickness="1" BorderBrush="#50FFFFFF">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#35475569" Offset="0.0"/>
                                        <GradientStop Color="#251E293B" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Path Data="M 12.5,4 A 6,6 0 1,0 16.7,14.7 L 21.5,19.5 A 1.2,1.2 0 1,0 23.2,17.8 L 18.4,13 A 6,6 0 0,0 12.5,4 Z M 12.5,6.5 A 3.5,3.5 0 1,1 9,10 A 3.5,3.5 0 0,1 12.5,6.5 Z"
                                      Fill="#F1F5F9"
                                      Stretch="Uniform"
                                      Width="16" Height="16"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="SearchBorder" Property="Background" Value="#25FFFFFF"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SearchScale" Storyboard.TargetProperty="ScaleX" To="1.18" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="SearchScale" Storyboard.TargetProperty="ScaleY" To="1.18" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SearchScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="SearchScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="SearchBorder" Property="Background" Value="#45FFFFFF"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SearchScale" Storyboard.TargetProperty="ScaleX" To="0.95" Duration="0:0:0.08"/>
                                        <DoubleAnimation Storyboard.TargetName="SearchScale" Storyboard.TargetProperty="ScaleY" To="0.95" Duration="0:0:0.08"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </StackPanel>
</UserControl>
