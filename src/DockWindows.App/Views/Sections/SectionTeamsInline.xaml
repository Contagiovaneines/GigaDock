<UserControl x:Class="DockWindows.App.Views.Sections.SectionTeamsInline"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DockWindows.App.Converters"
             Height="{Binding DataContext.TamanhoIconeNumerico, RelativeSource={RelativeSource AncestorType=Window}}"
             Margin="{Binding DataContext.MargemItem, RelativeSource={RelativeSource AncestorType=Window}}">
    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:ColorToBrushConverter x:Key="ColorToBrushConverter"/>
    </UserControl.Resources>
    <Grid Visibility="{Binding Teams.Habilitado, Converter={StaticResource BoolToVis}}">
        <Border CornerRadius="12" Padding="6" Background="#161B22" Cursor="Hand" ToolTip="Microsoft Teams">
            <Border.InputBindings>
                <MouseBinding MouseAction="LeftClick" Command="{Binding Teams.AbrirAppCommand}"/>
            </Border.InputBindings>
                        <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Testar Alerta de Reunião (Roxo)" Command="{Binding Teams.TestarAlertaCommand}"/>
                </ContextMenu>
            </Border.ContextMenu>
            <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.3" Color="Black"/></Border.Effect>
            <Border CornerRadius="8" Background="#4A448C" Height="40" Padding="12,0,16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE716;" FontSize="18" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        <Border Width="10" Height="10" CornerRadius="5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-4,-2"
                                Background="{Binding Teams.CorStatus, Converter={StaticResource ColorToBrushConverter}}" 
                                BorderBrush="#4A448C" BorderThickness="2"/>
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Teams.Status}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock Text="{Binding Teams.ProximaReuniao}" FontSize="10" Foreground="#C8C6E2" Margin="0,-2,0,0" MaxWidth="110" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>


