<UserControl x:Class="DockWindows.App.Views.Sections.SectionDiscordInline"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DockWindows.App.Converters"
             Height="{Binding DataContext.TamanhoIconeNumerico, RelativeSource={RelativeSource AncestorType=Window}}"
             Margin="{Binding DataContext.MargemItem, RelativeSource={RelativeSource AncestorType=Window}}">
    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:ColorToBrushConverter x:Key="ColorToBrushConverter"/>
    </UserControl.Resources>
    <Grid Visibility="{Binding Discord.Habilitado, Converter={StaticResource BoolToVis}}">
        <Border CornerRadius="12" Padding="6" Background="#161B22" Cursor="Hand" ToolTip="Discord">
            <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.3" Color="Black"/></Border.Effect>
            <Border CornerRadius="8" Background="#5865F2" Height="40" Padding="12,0,16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE154;" FontSize="18" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="{Binding Discord.SalaVoz}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock Text="Conectado" FontSize="10" Foreground="#C7CCFC" Margin="0,-2,0,0"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Discord.UsuariosNaCall}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="20" Height="20" CornerRadius="10" Margin="0,0,4,0"
                                        Background="{Binding CorAvatar, Converter={StaticResource ColorToBrushConverter}}"
                                        BorderBrush="#3BA55C">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EstaFalando}" Value="True">
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding AvatarInicial}" Foreground="#FFFFFF" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
