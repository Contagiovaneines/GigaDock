<UserControl x:Class="DockWindows.App.Views.Sections.SectionCalendarioInline"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DockWindows.App.Converters"
             Margin="{Binding DataContext.MargemItem, RelativeSource={RelativeSource AncestorType=Window}}">
    <Grid>
        <Border CornerRadius="12" Padding="6" Background="#161B22" Cursor="Hand"
                ToolTip="Calendário e Eventos">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.3" Color="Black"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                
                <!-- Ícone da Esquerda (Página do Calendário) -->
                <Border Width="40" Height="40" CornerRadius="8" Background="#1C1C1E" Padding="4">
                    <Border Background="#FFFFFF" CornerRadius="4" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#FF3B30" CornerRadius="4,4,0,0">
                                <TextBlock Text="{Binding Calendario.DiaSemanaCurto, FallbackValue='TER.'}" 
                                           FontSize="8" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Row="1" Text="{Binding Calendario.DiaDoMes, FallbackValue='22'}" 
                                       FontSize="14" FontWeight="Bold" Foreground="#000000" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                        </Grid>
                    </Border>
                </Border>

                <!-- Pílula da Direita (Lista de Eventos) -->
                <Border CornerRadius="10" Background="#21262D" Height="40" Margin="6,0,0,0" Padding="8,4">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Mini Icone -->
                        <Border Width="26" Height="26" CornerRadius="6" Background="#FFFFFF" Margin="0,0,10,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="#FF3B30" CornerRadius="6,6,0,0">
                                    <TextBlock Text="{Binding Calendario.DiaSemanaCurto, FallbackValue='TER.'}" 
                                               FontSize="5" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Row="1" Text="{Binding Calendario.DiaDoMes, FallbackValue='22'}" 
                                           FontSize="10" FontWeight="Bold" Foreground="#000000" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Lista de Eventos (Trunca para exibir apenas 2 ou 3) -->
                        <ItemsControl ItemsSource="{Binding Calendario.TodosCompromissos}" Height="32">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                        <Ellipse Width="4" Height="4" Fill="#34C759" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Titulo}" FontSize="9" FontWeight="SemiBold" Foreground="#E5E7EB" Width="90" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding DataHora, StringFormat='{}{0:HH:mm}'}" FontSize="9" Foreground="#9CA3AF" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty state -->
                        <TextBlock Text="Sem eventos próximos" FontSize="10" Foreground="#8E8E93" VerticalAlignment="Center" Margin="10,0"
                                   Visibility="{Binding Calendario.TemCompromissos, Converter={StaticResource InvertBoolToVis}}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>


