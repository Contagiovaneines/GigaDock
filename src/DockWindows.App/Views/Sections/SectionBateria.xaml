<UserControl xmlns:atividade="clr-namespace:DockWindows.App.Common" atividade:AtividadeVisual.Componente="Bateria" x:Class="DockWindows.App.Views.Sections.SectionBateria"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="clr-namespace:DockWindows.Core.Models;assembly=DockWindows.Core"
             xmlns:controls="clr-namespace:DockWindows.App.Controls"
             xmlns:conv="clr-namespace:DockWindows.App.Converters"
             Margin="8,0" VerticalAlignment="Center"
             Visibility="{Binding Bateria.Habilitado, Converter={StaticResource BoolToVis}}">
 <UserControl.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"><MenuItem Header="Personalizar&#x2026;" Command="{Binding PersonalizarWidgetCommand}" CommandParameter="{x:Static models:TipoWidget.Bateria}"/></ContextMenu></UserControl.ContextMenu>

    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid>
    <Border Padding="4,5" ToolTip="{Binding Bateria.Descricao}" AutomationProperties.Name="{Binding Bateria.Descricao}">
        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding Bateria.Estilo}" Value="anel"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{Binding Bateria.Porcentagem}" Foreground="#E1E4E8" FontSize="11"
                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <Grid Width="27" Height="14" VerticalAlignment="Center">
                <Border Width="25" Height="14" CornerRadius="4" BorderThickness="1.5"
                        BorderBrush="#72D99C" HorizontalAlignment="Left">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Opacity" Value="0"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Bateria.Carregando}" Value="True"/>
                                        <Condition Binding="{Binding AnimacoesAtivas}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <MultiDataTrigger.EnterActions>
                                        <BeginStoryboard x:Name="ChargingGlowStoryboard">
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.2" To="0.9" Duration="0:0:0.85"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </MultiDataTrigger.EnterActions>
                                    <MultiDataTrigger.ExitActions><StopStoryboard BeginStoryboardName="ChargingGlowStoryboard"/></MultiDataTrigger.ExitActions>
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Bateria.Carregando}" Value="True"/>
                                        <Condition Binding="{Binding AnimacoesAtivas}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Opacity" Value="0.75"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <Border Width="24" Height="13" CornerRadius="3" BorderThickness="1.3" BorderBrush="#B3BAC4"
                        HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <Border Width="2" Height="5" CornerRadius="1" Background="#B3BAC4"
                        HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <Border Width="{Binding Bateria.LarguraCarga}" Height="7" CornerRadius="1"
                        Background="{Binding Bateria.CorCarga}" HorizontalAlignment="Left" Margin="3,0,0,0" VerticalAlignment="Center"/>
                <Path Data="M 12,1 L 8,8 L 12,8 L 10,13 L 17,5 L 13,5 Z" Fill="#183225"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Visibility="{Binding Bateria.Carregando, Converter={StaticResource BoolToVis}}">
                    <Path.RenderTransform><ScaleTransform CenterX="12" CenterY="7"/></Path.RenderTransform>
                    <Path.Style>
                        <Style TargetType="Path">
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Bateria.Carregando}" Value="True"/>
                                        <Condition Binding="{Binding AnimacoesAtivas}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <MultiDataTrigger.EnterActions>
                                        <BeginStoryboard x:Name="ChargingBoltStoryboard">
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.5" To="1" Duration="0:0:0.55"/>
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" From="0.9" To="1.08" Duration="0:0:0.55"/>
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" From="0.9" To="1.08" Duration="0:0:0.55"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </MultiDataTrigger.EnterActions>
                                    <MultiDataTrigger.ExitActions><StopStoryboard BeginStoryboardName="ChargingBoltStoryboard"/></MultiDataTrigger.ExitActions>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
            </Grid>
        </StackPanel>
    </Border>
    <controls:IndicadorSistemaControl Width="62" Height="58" Estilo="anel" Titulo="Bateria" Texto="{Binding Bateria.Porcentagem}" Valor="{Binding Bateria.Carga}" ToolTip="{Binding Bateria.Descricao}">
        <controls:IndicadorSistemaControl.Style><Style TargetType="controls:IndicadorSistemaControl"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Bateria.Estilo}" Value="anel"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></controls:IndicadorSistemaControl.Style>
    </controls:IndicadorSistemaControl>
    </Grid>
</UserControl>
