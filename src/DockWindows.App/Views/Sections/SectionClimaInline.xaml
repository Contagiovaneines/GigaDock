<UserControl x:Class="DockWindows.App.Views.Sections.SectionClimaInline"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Height="{Binding DataContext.TamanhoIconeNumerico, RelativeSource={RelativeSource AncestorType=Window}}"
             Margin="{Binding DataContext.MargemItem, RelativeSource={RelativeSource AncestorType=Window}}">
    
    <Grid Width="Auto" MinWidth="140" MaxWidth="190">
        <Border CornerRadius="{Binding DataContext.RaioCantosDockRadius, RelativeSource={RelativeSource AncestorType=Window}}" ClipToBounds="True">
            <Border.Background>
                <SolidColorBrush Color="#1AFFFFFF"/>
            </Border.Background>
            
            <StackPanel Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Clima.IconeEmoji}" FontSize="22" VerticalAlignment="Center" Margin="0,0,8,0"/>
                
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding Clima.Temperatura}" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding Clima.Condicao}" FontSize="11" Foreground="#E0E0E0" VerticalAlignment="Bottom" Margin="0,0,0,2" TextTrimming="CharacterEllipsis" MaxWidth="75"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Clima.Local}" FontSize="10" Foreground="#A0C0E0" TextTrimming="CharacterEllipsis" MaxWidth="110"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
