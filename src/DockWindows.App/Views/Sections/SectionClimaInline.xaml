<UserControl x:Class="DockWindows.App.Views.Sections.SectionClimaInline"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Height="{Binding DataContext.TamanhoIconeNumerico, RelativeSource={RelativeSource AncestorType=Window}}"
             Margin="{Binding DataContext.MargemItem, RelativeSource={RelativeSource AncestorType=Window}}">
    
    <Grid Width="160">
        <Border CornerRadius="12" ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#54A0FF" Offset="0.0"/>
                    <GradientStop Color="#2E86DE" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            
            <Grid>
                <!-- Textos -->
                <StackPanel VerticalAlignment="Center" Margin="12,0,50,0">
                    <TextBlock Text="{Binding Clima.Condicao}" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Clima.Local}" FontSize="10" Foreground="#E0F7FA" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                </StackPanel>
                
                <!-- Temperatura -->
                <TextBlock Text="{Binding Clima.Temperatura}" FontSize="24" FontWeight="Light" Foreground="#FFFFFF" 
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                
                <!-- Ícone decorativo (protótipo tem um ícone de sol sobre a nuvem) -->
                <TextBlock Text="{Binding Clima.IconeEmoji}" FontSize="32" 
                           HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-4,-10">
                    <TextBlock.RenderTransform>
                        <TranslateTransform Y="4"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>
