<UserControl x:Class="DockWindows.App.Views.Sections.SectionClimaInline"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Height="{Binding DataContext.TamanhoIconeNumerico, RelativeSource={RelativeSource AncestorType=Window}}"
             Margin="{Binding DataContext.MargemItem, RelativeSource={RelativeSource AncestorType=Window}}">
    
    <Grid Width="160">
        <Border CornerRadius="12" ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#54A0FF" Offset="0.0"/>
                    <GradientStop Color="#2E86DE" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            
            <Grid>
                <!-- Textos e Temperatura -->
                <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center" Width="85">
                        <TextBlock Text="{Binding Clima.Condicao}" FontSize="11" FontWeight="Medium" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Clima.Local}" FontSize="11" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                    </StackPanel>
                    
                    <TextBlock Text="{Binding Clima.Temperatura}" FontSize="28" FontWeight="Light" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,0,4"/>
                </StackPanel>
                
                <!-- Ícone decorativo vazando a borda -->
                <TextBlock Text="⛅" FontSize="44" 
                           HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-8,-12">
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>
