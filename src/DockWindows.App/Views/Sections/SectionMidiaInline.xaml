<UserControl x:Class="DockWindows.App.Views.Sections.SectionMidiaInline"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Height="{Binding DataContext.TamanhoIconeNumerico, RelativeSource={RelativeSource AncestorType=Window}}"
             Margin="{Binding DataContext.MargemItem, RelativeSource={RelativeSource AncestorType=Window}}">
    
    <Grid Width="200">
        <Border CornerRadius="12" Background="#18181A" ClipToBounds="True">
            <Grid>
                <!-- Fundo Capa do Álbum com Efeito -->
                <Image Source="{Binding Midia.CapaAlbumUrl}" Stretch="UniformToFill" Opacity="0.4"/>
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#CC000000" Offset="0.0"/>
                            <GradientStop Color="#44000000" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Conteúdo -->
                <Grid Margin="12,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                        <TextBlock Text="{Binding Midia.Titulo}" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" MaxWidth="95"/>
                        <TextBlock Text="{Binding Midia.Artista}" FontSize="12" Foreground="#B3B3B3" TextTrimming="CharacterEllipsis" Margin="4,0,0,0" MaxWidth="70"/>
                    </StackPanel>

                    <!-- Controles -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,10">
                        <TextBlock Text="🔀" FontSize="11" Foreground="#B3B3B3" Margin="0,0,10,0"/>
                        <Button Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" Padding="0" Margin="0,0,10,0"
                                Command="{Binding Midia.AnteriorCommand}" Cursor="Hand">
                            <TextBlock Text="⏮" FontSize="11"/>
                        </Button>
                        <Button Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" Padding="0" Margin="0,0,10,0"
                                Command="{Binding Midia.PlayPauseCommand}" Cursor="Hand">
                            <TextBlock FontSize="11">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="▶"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Midia.EstaTocando}" Value="True">
                                                <Setter Property="Text" Value="⏸"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                        <Button Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" Padding="0" Margin="0,0,10,0"
                                Command="{Binding Midia.ProximoCommand}" Cursor="Hand">
                            <TextBlock Text="⏭" FontSize="11"/>
                        </Button>
                        <TextBlock Text="🤍" FontSize="11" Foreground="#B3B3B3"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Ícone Spotify flutuando pra fora -->
        <Border Background="#1DB954" Width="18" Height="18" CornerRadius="9" BorderThickness="1.5" BorderBrush="#25252A"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0">
        </Border>
    </Grid>
</UserControl>
