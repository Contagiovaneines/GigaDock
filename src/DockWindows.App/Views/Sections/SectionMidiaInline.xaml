<UserControl x:Class="DockWindows.App.Views.Sections.SectionMidiaInline"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:DockWindows.App.Converters"
             mc:Ignorable="d"
             Margin="{Binding DataContext.MargemItem, RelativeSource={RelativeSource AncestorType=Window}}"
             Visibility="{Binding Midia.TemMidia, Converter={StaticResource BoolToVis}}">
    
    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- Estilo dos botões de controle -->
        <Style x:Key="MediaBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#25FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    
    <Grid Width="240">
                        <Border CornerRadius="12" ClipToBounds="False" BorderThickness="0" Background="Transparent" Cursor="Hand" ToolTip="Dê um duplo-clique para abrir o player">
            <Border.InputBindings>
                <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding Midia.AbrirPlayerCommand}"/>
            </Border.InputBindings>
            
            <Grid>
                
                <Grid Margin="6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Capa do Álbum (miniatura quadrada) -->
                    <Border Grid.Column="0" Width="30" Height="30" CornerRadius="6" ClipToBounds="True" 
                            VerticalAlignment="Center">
                        <Image Source="{Binding Midia.CapaAlbumUrl}" Stretch="UniformToFill"/>
                    </Border>
                    
                    <!-- Título e Artista -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock Text="{Binding Midia.Titulo}" FontSize="11" FontWeight="SemiBold" 
                                   Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" MaxWidth="110"/>
                        <TextBlock Text="{Binding Midia.Artista}" FontSize="10" 
                                   Foreground="#A0A0A0" TextTrimming="CharacterEllipsis" MaxWidth="110" Margin="0,-1,0,0"/>
                    </StackPanel>
                        
                    <!-- Botões de Controle na Direita -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,2,0">
                        <!-- Anterior -->
                        <Button Style="{StaticResource MediaBtnStyle}" Command="{Binding Midia.AnteriorCommand}">
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE892;" FontSize="11"/>
                        </Button>
                        
                        <!-- Play/Pause -->
                        <Button Style="{StaticResource MediaBtnStyle}" Command="{Binding Midia.PlayPauseCommand}" Margin="2,0">
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <!-- Play icon -->
                                        <Setter Property="Text" Value="&#xE768;"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Midia.EstaTocando}" Value="True">
                                                <!-- Pause icon -->
                                                <Setter Property="Text" Value="&#xE769;"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                        
                        <!-- Próximo -->
                        <Button Style="{StaticResource MediaBtnStyle}" Command="{Binding Midia.ProximoCommand}">
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE893;" FontSize="11"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
        
        <!-- Badge Fonte App -->
        <Border Background="{Binding Midia.FonteCor, FallbackValue='#1DB954'}" 
                Width="14" Height="14" CornerRadius="7" 
                BorderThickness="1.5" BorderBrush="#1A1A1E"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0"
                ToolTip="{Binding Midia.FonteNome}">
            <TextBlock Text="{Binding Midia.FonteIcone, FallbackValue='♪'}" FontSize="8" Foreground="White" 
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
        </Border>
    </Grid>
</UserControl>




