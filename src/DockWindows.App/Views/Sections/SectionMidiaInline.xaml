<UserControl x:Class="DockWindows.App.Views.Sections.SectionMidiaInline"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:DockWindows.App.Converters"
             mc:Ignorable="d"
             Height="{Binding DataContext.TamanhoIconeNumerico, RelativeSource={RelativeSource AncestorType=Window}}"
             Margin="{Binding DataContext.MargemItem, RelativeSource={RelativeSource AncestorType=Window}}"
             Visibility="{Binding Midia.TemMidia, Converter={StaticResource BoolToVis}}">
    
    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- Estilo dos botões de controle -->
        <Style x:Key="MediaBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#CCFFFFFF"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    
    <Grid Width="220">
        <Border CornerRadius="12" ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#2A2A30" Offset="0.0"/>
                    <GradientStop Color="#1A1A1E" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            
            <Grid>
                <!-- Capa de fundo com blur suave -->
                <Image Source="{Binding Midia.CapaAlbumUrl}" Stretch="UniformToFill" Opacity="0.15"/>
                
                <Grid Margin="8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Capa do Álbum (miniatura quadrada) -->
                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6" ClipToBounds="True" 
                            VerticalAlignment="Center" Margin="0,0,8,0">
                        <Image Source="{Binding Midia.CapaAlbumUrl}" Stretch="UniformToFill"/>
                    </Border>
                    
                    <!-- Info + Controles -->
                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Título e Artista -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,2">
                            <TextBlock Text="{Binding Midia.Titulo}" FontSize="11" FontWeight="Bold" 
                                       Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" MaxWidth="140"/>
                            <TextBlock Text="{Binding Midia.Artista}" FontSize="10" 
                                       Foreground="#99FFFFFF" TextTrimming="CharacterEllipsis" MaxWidth="140"/>
                        </StackPanel>
                        
                        <!-- Botões de Controle -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,0">
                            <Button Style="{StaticResource MediaBtnStyle}" Command="{Binding Midia.AnteriorCommand}">
                                <TextBlock Text="⏮" FontSize="10"/>
                            </Button>
                            <Button Style="{StaticResource MediaBtnStyle}" Command="{Binding Midia.PlayPauseCommand}" Margin="4,0">
                                <TextBlock FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="▶"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Midia.EstaTocando}" Value="True">
                                                    <Setter Property="Text" Value="⏸"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                            <Button Style="{StaticResource MediaBtnStyle}" Command="{Binding Midia.ProximoCommand}">
                                <TextBlock Text="⏭" FontSize="10"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
        
        <!-- Badge Fonte App -->
        <Border Background="{Binding Midia.FonteCor, FallbackValue='#1DB954'}" 
                Width="16" Height="16" CornerRadius="8" 
                BorderThickness="1.5" BorderBrush="#1A1A1E"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,-5,0"
                ToolTip="{Binding Midia.FonteNome}">
            <TextBlock Text="{Binding Midia.FonteIcone, FallbackValue='♫'}" FontSize="8" Foreground="White" 
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
