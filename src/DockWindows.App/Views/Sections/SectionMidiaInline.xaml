<UserControl xmlns:atividade="clr-namespace:DockWindows.App.Common" atividade:AtividadeVisual.Componente="Midia" x:Class="DockWindows.App.Views.Sections.SectionMidiaInline"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="clr-namespace:DockWindows.Core.Models;assembly=DockWindows.Core"
             xmlns:conv="clr-namespace:DockWindows.App.Converters"
             Margin="4,3" VerticalAlignment="Center"
             Visibility="{Binding Midia.TemMidia, Converter={StaticResource BoolToVis}}">
 <UserControl.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"><MenuItem Header="Personalizar&#x2026;" Command="{Binding PersonalizarWidgetCommand}" CommandParameter="{x:Static models:TipoWidget.Midia}"/></ContextMenu></UserControl.ContextMenu>

    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:MediaColorsConverter x:Key="MediaColors"/>
        <Style x:Key="MediaBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#28FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#45FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#B9F5CE"/>
                                <Setter TargetName="Surface" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Geometry x:Key="PreviousIcon">M 2,2 L 5,2 L 5,22 L 2,22 Z M 22,2 L 7,12 L 22,22 Z</Geometry>
        <Geometry x:Key="NextIcon">M 19,2 L 22,2 L 22,22 L 19,22 Z M 2,2 L 17,12 L 2,22 Z</Geometry>
        <Style x:Key="PlaybackIconStyle" TargetType="Path">
            <Setter Property="Fill" Value="White"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Data" Value="M 4,2 L 21,12 L 4,22 Z"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Midia.EstaTocando}" Value="True">
                    <Setter Property="Data" Value="M 3,2 L 9,2 L 9,22 L 3,22 Z M 15,2 L 21,2 L 21,22 L 15,22 Z"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MediaPlayBtnStyle" TargetType="Button" BasedOn="{StaticResource MediaBtnStyle}">
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="Margin" Value="9,0"/>
        </Style>
        <Style x:Key="MediaSideBtnStyle" TargetType="Button" BasedOn="{StaticResource MediaBtnStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Midia.Estilo}" Value="mini"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                <DataTrigger Binding="{Binding Midia.Estilo}" Value="barra"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
    <Viewbox Stretch="Uniform" StretchDirection="Both" Height="54">
        <Viewbox.Style><Style TargetType="Viewbox"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Midia.Estilo}" Value="capa"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Viewbox.Style>
        <Grid Width="630" Height="140">
            <Border Margin="0,8,10,2" CornerRadius="24" BorderThickness="1.2"
                    ToolTip="Dê um duplo clique para abrir o player">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding Midia.AbrirPlayerCommand}"/>
                </Border.InputBindings>
                <Border.BorderBrush><Binding Path="Midia.CorPredominanteHex" Converter="{StaticResource MediaColors}" ConverterParameter="Borda"/></Border.BorderBrush>
                <Border.Background><Binding Path="Midia.CorPredominanteHex" Converter="{StaticResource MediaColors}"/></Border.Background>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="18"/></Grid.RowDefinitions>
                    <!-- A capa atual também cria a textura do vidro, sem imagens externas. -->
                    <Border Grid.RowSpan="2" Margin="1" CornerRadius="23" Opacity="0.09">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Midia.CapaAlbumUrl}" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                    <Border Grid.RowSpan="2" Margin="1" CornerRadius="23">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#24FFFFFF" Offset="0"/>
                                <GradientStop Color="#08000000" Offset="0.42"/>
                                <GradientStop Color="#A8000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Grid Margin="14,8,28,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="104"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border CornerRadius="16" BorderBrush="#45FFFFFF" BorderThickness="1">
                            <Border.Background><ImageBrush ImageSource="{Binding Midia.CapaAlbumUrl}" Stretch="UniformToFill"/></Border.Background>
                        </Border>
                        <Grid Grid.Column="1" Margin="18,0,0,0">
                            <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="24"/><RowDefinition Height="8"/><RowDefinition Height="36"/></Grid.RowDefinitions>
                            <TextBlock Text="{Binding Midia.Titulo}" FontSize="26" FontWeight="SemiBold" Foreground="White"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Midia.Titulo}"/>
                            <TextBlock Grid.Row="1" Text="{Binding Midia.Artista}" FontSize="20" Foreground="#E1E7ED"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Midia.Artista}"/>
                            <StackPanel Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource MediaBtnStyle}" Command="{Binding Midia.AnteriorCommand}" ToolTip="Faixa anterior" AutomationProperties.Name="Faixa anterior">
                                    <Path Data="{StaticResource PreviousIcon}" Fill="White" Width="22" Height="22" Stretch="Uniform"/>
                                </Button>
                                <Button Style="{StaticResource MediaPlayBtnStyle}" Command="{Binding Midia.PlayPauseCommand}" ToolTip="Reproduzir ou pausar" AutomationProperties.Name="Reproduzir ou pausar">
                                    <Path Style="{StaticResource PlaybackIconStyle}"/>
                                </Button>
                                <Button Style="{StaticResource MediaBtnStyle}" Command="{Binding Midia.ProximoCommand}" ToolTip="Próxima faixa" AutomationProperties.Name="Próxima faixa">
                                    <Path Data="{StaticResource NextIcon}" Fill="White" Width="22" Height="22" Stretch="Uniform"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                    <ProgressBar Grid.Row="1" Height="3" Minimum="0" Maximum="1" Value="{Binding Midia.Progresso, Mode=OneWay}"
                                 Foreground="{Binding Midia.CorPredominanteHex, Converter={StaticResource MediaColors}, ConverterParameter=Destaque}"
                                 Background="#20FFFFFF" BorderThickness="0" IsTabStop="False" Margin="24,0,28,4" VerticalAlignment="Center"
                                 AutomationProperties.Name="Progresso da música"/>
                </Grid>
            </Border>
            <Button Width="38" Height="38" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Command="{Binding Midia.AbrirPlayerCommand}" ToolTip="{Binding Midia.FonteNome}"
                    AutomationProperties.Name="Abrir player de mídia" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="19" BorderBrush="{Binding Midia.CorPredominanteHex, Converter={StaticResource MediaColors}, ConverterParameter=Borda}" BorderThickness="1">
                            <Border.Background><Binding Path="Midia.CorPredominanteHex" Converter="{StaticResource MediaColors}"/></Border.Background>
                            <Grid Margin="6">
                                <Ellipse Fill="{Binding Midia.FonteCor}" Stroke="#72FFAE" StrokeThickness="1"/>
                                <TextBlock x:Name="GenericSource" Text="{Binding Midia.FonteIcone}" FontSize="21"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Path x:Name="SpotifyMark" Visibility="Collapsed"
                                      Data="M 5,9 C 12,6 21,7 27,11 M 7,15 C 13,12 20,13 25,16 M 9,21 C 14,19 19,19 23,22"
                                      Stroke="#143C24" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="25" Height="21" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Midia.FonteNome}" Value="Spotify">
                                <Setter TargetName="GenericSource" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="SpotifyMark" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Viewbox>

    <Viewbox Height="54" Stretch="Uniform" StretchDirection="Both">
    <Border Background="{Binding Midia.CorPredominanteHex, Converter={StaticResource MediaColors}}" CornerRadius="10" BorderBrush="{Binding Midia.CorPredominanteHex, Converter={StaticResource MediaColors}, ConverterParameter=Borda}" BorderThickness="1" Padding="10,5" Margin="0,2">
        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding Midia.Estilo}" Value="capa"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <StackPanel Width="145" VerticalAlignment="Center" Margin="0,0,8,0">
                    <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding Midia.Estilo}" Value="mini"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                    <TextBlock Text="{Binding Midia.Titulo}" Foreground="White" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Midia.Artista}" Foreground="Silver" FontSize="10" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button Command="{Binding Midia.AnteriorCommand}" Style="{StaticResource MediaSideBtnStyle}" ToolTip="Anterior" AutomationProperties.Name="Faixa anterior"><Path Data="{StaticResource PreviousIcon}" Fill="White" Width="22" Height="22" Stretch="Uniform"/></Button>
                <Button Command="{Binding Midia.PlayPauseCommand}" Style="{StaticResource MediaPlayBtnStyle}" ToolTip="Reproduzir / pausar" AutomationProperties.Name="Reproduzir ou pausar">
                    <Path Style="{StaticResource PlaybackIconStyle}"/>
                </Button>
                <Button Command="{Binding Midia.ProximoCommand}" Style="{StaticResource MediaSideBtnStyle}" ToolTip="Próxima" AutomationProperties.Name="Próxima faixa"><Path Data="{StaticResource NextIcon}" Fill="White" Width="22" Height="22" Stretch="Uniform"/></Button>
            </StackPanel>
            <Grid Margin="0,5,0,0">
                <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Midia.Estilo}" Value="barra"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                <ProgressBar Height="3" Minimum="0" Maximum="1" Value="{Binding Midia.Progresso, Mode=OneWay}" Foreground="{Binding Midia.CorPredominanteHex, Converter={StaticResource MediaColors}, ConverterParameter=Destaque}" Background="#42463E" Margin="0,0,0,17"/>
                <TextBlock Text="{Binding Midia.Posicao}" Foreground="Silver" FontSize="9" Margin="0,6,0,0"/>
                <TextBlock Text="{Binding Midia.Duracao}" Foreground="Silver" FontSize="9" HorizontalAlignment="Right" Margin="0,6,0,0"/>
            </Grid>
        </StackPanel>
    </Border>
    </Viewbox>
    </Grid>
</UserControl>
