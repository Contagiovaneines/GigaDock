<UserControl x:Class="DockWindows.App.Views.Sections.SectionApps"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DockWindows.App.Converters"
             xmlns:vm="clr-namespace:DockWindows.App.ViewModels"
             AllowDrop="True"
             DragOver="Apps_DragOver"
             Drop="Apps_Drop">

    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InvertBoolToVis"/>
        <conv:ColorToBrushConverter x:Key="ColorToBrushConverter"/>

        <!-- Context menu dos aplicativos fixados/abertos -->
        <ContextMenu x:Key="AppContextMenu" Background="#1E1E22" Foreground="#FFFFFF" BorderBrush="#33333A">
            <MenuItem Header="🚀 Abrir / Nova Janela" Command="{Binding AbrirNovaJanelaCommand}" FontWeight="Bold"/>
            <Separator Background="#33333A"/>
            <MenuItem Header="📌 Fixar na Dock" Command="{Binding FixarDesafixarCommand}"
                      Visibility="{Binding EstaFixado, Converter={StaticResource InvertBoolToVis}}"/>
            <MenuItem Header="📌 Desafixar da Dock" Command="{Binding FixarDesafixarCommand}"
                      Visibility="{Binding EstaFixado, Converter={StaticResource BoolToVis}}"/>
            <Separator Background="#33333A"/>
            <MenuItem Header="⬅️ Mover para a Esquerda" Command="{Binding MoverEsquerdaCommand}"
                      Visibility="{Binding EstaFixado, Converter={StaticResource BoolToVis}}"/>
            <MenuItem Header="➡️ Mover para a Direita" Command="{Binding MoverDireitaCommand}"
                      Visibility="{Binding EstaFixado, Converter={StaticResource BoolToVis}}"/>
            <MenuItem Header="💼 Mover para o Ambiente Ativo" Command="{Binding MoverParaAmbienteCommand}"/>
            <Separator Background="#33333A" Visibility="{Binding EstaAberto, Converter={StaticResource BoolToVis}}"/>
            <MenuItem Header="❌ Fechar Todas as Janelas" Command="{Binding FecharTodasJanelasCommand}"
                      Visibility="{Binding EstaAberto, Converter={StaticResource BoolToVis}}"/>
        </ContextMenu>
    </UserControl.Resources>

    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <!-- Lista de Aplicativos Fixados e Abertos -->
        <ItemsControl ItemsSource="{Binding Aplicativos}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:AppItemViewModel}">
                    <Grid Margin="6,0,6,0">
                        <Button Command="{Binding ClicarCommand}"
                                ContextMenu="{StaticResource AppContextMenu}"
                                ToolTip="{Binding TextoDica}"
                                Padding="0"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="BtnBorder" CornerRadius="10" Padding="0" Background="Transparent">
                                        <Grid>
                                            <!-- Layout Vertical: Ícone no Centro, Indicador embaixo -->
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Ícone e Badge com Magnificação Suave -->
                                            <Grid Grid.Row="0"
                                                  RenderTransformOrigin="0.5,0.5"
                                                  Width="{Binding DataContext.TamanhoIconeNumerico, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  Height="{Binding DataContext.TamanhoIconeNumerico, RelativeSource={RelativeSource AncestorType=Window}}">
                                                <Grid.RenderTransform>
                                                    <ScaleTransform x:Name="AppScale" ScaleX="1.0" ScaleY="1.0"/>
                                                </Grid.RenderTransform>
                                                <Border Width="{Binding DataContext.TamanhoIconeNumerico, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        Height="{Binding DataContext.TamanhoIconeNumerico, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        Background="Transparent">
                                                    <Image Source="{Binding Icone}"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           Margin="2"
                                                           VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    </Image>
                                                </Border>

                                                <!-- Fallback sofisticado se não houver ícone extraído -->
                                                <Border Background="#253341" CornerRadius="8" BorderThickness="1" BorderBrush="#40FFFFFF"
                                                        Visibility="{Binding Icone, Converter={StaticResource InvertBoolToVis}}">
                                                    <TextBlock Text="✦" FontSize="14" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                                                                <!-- Badge com Contagem / Estilo iOS Red -->
                                                <Border Visibility="{Binding TemMultiplasJanelas, Converter={StaticResource BoolToVis}}"
                                                        Background="#FF3B30" CornerRadius="8"
                                                        MinWidth="16" Height="16" Padding="4,0"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0">
                                                    
                                                    <TextBlock Text="{Binding QuantidadeJanelas}" FontSize="10" FontWeight="Bold"
                                                               Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>

                                                                                        <!-- Blue indicator for running apps -->
                                            <Grid Grid.Row="1" Margin="0,4,0,-8" Height="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border x:Name="IndicatorDot" Width="4" Height="4" CornerRadius="2" Background="#0A84FF"
                                                        Visibility="{Binding EstaAberto, Converter={StaticResource BoolToVis}}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding EstaAtivo}" Value="True">
                                                                    <Setter Property="Width" Value="14"/>
                                                                    <Setter Property="Background" Value="#58A6FF"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <!-- Realce de fundo para aplicativo ativo -->
                                        <DataTrigger Binding="{Binding EstaAtivo}" Value="True">
                                             <Setter TargetName="BtnBorder" Property="Background" Value="#250A84FF"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="BtnBorder" Property="Background" Value="#25FFFFFF"/>
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="AppScale" Storyboard.TargetProperty="ScaleX"
                                                                         To="1.18" Duration="0:0:0.12">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="AppScale" Storyboard.TargetProperty="ScaleY"
                                                                         To="1.18" Duration="0:0:0.12">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="AppScale" Storyboard.TargetProperty="ScaleX"
                                                                         To="1.0" Duration="0:0:0.12">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="AppScale" Storyboard.TargetProperty="ScaleY"
                                                                         To="1.0" Duration="0:0:0.12">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="BtnBorder" Property="Background" Value="#40FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- FLYOUT POPUP COM LISTA DE JANELAS (SE HOUVER MÚLTIPLAS) -->
                        <Popup IsOpen="{Binding MenuJanelasAberto, Mode=TwoWay}"
                               StaysOpen="False"
                               Placement="Top"
                               AllowsTransparency="True">
                            <Border Background="#1E1E22" BorderBrush="#383842" BorderThickness="1"
                                    CornerRadius="12" Padding="8" Margin="0,0,0,10" MinWidth="220" MaxWidth="320">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.5" Color="Black"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="{Binding Titulo}" FontWeight="Bold" FontSize="12" Foreground="#0A84FF" Margin="6,2,6,6"/>
                                    <ItemsControl ItemsSource="{Binding Janelas}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="8" Padding="6,5" Margin="0,2" Background="Transparent" x:Name="WinRow">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Button Command="{Binding DataContext.AtivarJanelaCommand, RelativeSource={RelativeSource AncestorType=Popup}}"
                                                                CommandParameter="{Binding}"
                                                                Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" Cursor="Hand">
                                                            <TextBlock Text="{Binding Titulo}" FontSize="12" Foreground="#FFFFFF"
                                                                       TextTrimming="CharacterEllipsis" MaxWidth="230"/>
                                                        </Button>
                                                        <Button Grid.Column="1"
                                                                Command="{Binding DataContext.FecharJanelaCommand, RelativeSource={RelativeSource AncestorType=Popup}}"
                                                                CommandParameter="{Binding}"
                                                                Content="✕" FontSize="10" Foreground="#8E8E93"
                                                                Background="Transparent" BorderThickness="0" Margin="6,0,0,0"
                                                                Padding="4,2" Cursor="Hand" ToolTip="Fechar Janela"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>



