<UserControl xmlns:atividade="clr-namespace:DockWindows.App.Common" x:Class="DockWindows.App.Views.Sections.SectionRelogioControles"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DockWindows.App.Converters"
             xmlns:sections="clr-namespace:DockWindows.App.Views.Sections"
             xmlns:models="clr-namespace:DockWindows.Core.Models;assembly=DockWindows.Core"
             xmlns:controls="clr-namespace:DockWindows.App.Controls">

    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="DockControls.xaml"/></ResourceDictionary.MergedDictionaries>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:ColorToBrushConverter x:Key="ColorToBrushConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <!-- Relógio Digital com Magnificação Suave -->
        <Button x:Name="RelogioButton" atividade:AtividadeVisual.Componente="Relogio"
                Command="{Binding Clock.AcaoPrincipalCommand}"
                Background="Transparent" BorderThickness="0" Margin="5,3"
                Cursor="Hand" ToolTip="Clique para abrir o calendário ou iniciar/pausar o controle de tempo. Botão direito para reiniciar."
                AutomationProperties.Name="{Binding Clock.Estilo}"
                Visibility="{Binding Clock.Habilitado, Converter={StaticResource BoolToVis}}">
            <Button.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"><MenuItem Header="Personalizar&#x2026;" Command="{Binding PersonalizarWidgetCommand}" CommandParameter="{x:Static models:TipoWidget.Relogio}"/><Separator/><MenuItem Header="Reiniciar cronômetro / temporizador" Command="{Binding Clock.ReiniciarControleCommand}"/></ContextMenu></Button.ContextMenu>
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ClockSurface" CornerRadius="10" Background="{TemplateBinding Background}" Padding="7,0">
                        <Viewbox Stretch="Uniform" MaxHeight="{Binding AlturaBarra}">
                            <controls:EstiloRelogioControl Width="156" Height="52" Estilo="{Binding Clock.Estilo}" Horario="{Binding Clock.Horario}" TempoControle="{Binding Clock.TempoControle}"/>
</Viewbox>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding EhAreia}" Value="True"><Setter TargetName="ClockSurface" Property="Background" Value="#292B32"/></DataTrigger>
<DataTrigger Binding="{Binding RelogioAnalogico}" Value="True"><Setter TargetName="ClockSurface" Property="Background" Value="#B52C3D87"/></DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ClockSurface" Property="Background" Value="#16FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ClockSurface" Property="BorderBrush" Value="#ABD7BB"/>
                            <Setter TargetName="ClockSurface" Property="BorderThickness" Value="1"/>
                        </Trigger>
                        <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding EhAreia}" Value="True"/><Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/></MultiDataTrigger.Conditions><Setter TargetName="ClockSurface" Property="Background" Value="#383C45"/></MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- FLYOUT POPUP: CALENDÁRIO DO RELÓGIO -->
        <Popup IsOpen="{Binding Clock.CalendarioAberto, Mode=TwoWay}"
               StaysOpen="False"
               Placement="Top"
               PlacementTarget="{Binding ElementName=RelogioButton}">
            <Border Background="{Binding FundoCardColor, Converter={StaticResource ColorToBrushConverter}}"
                    BorderBrush="{Binding BordaDockColor, Converter={StaticResource ColorToBrushConverter}}"
                    BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.45" Color="Black"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="{Binding Clock.DataFormatada}" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" Margin="0,0,0,6"/>
                    <Calendar SelectedDate="{Binding Clock.DataSelecionada, Mode=TwoWay}" DisplayDate="{Binding Clock.DataExibicao, Mode=TwoWay}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Separador interno sutil se ações estiverem visíveis -->
        <!-- Instâncias adicionais de relógio usam runtime, fuso e ciclo de vida próprios. -->
        <ItemsControl ItemsSource="{Binding RelogiosAdicionais}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Command="{Binding Relogio.AcaoPrincipalCommand}"
                            Background="Transparent" BorderThickness="0" Margin="3"
                            Cursor="Hand" ToolTip="{Binding Nome}"
                            AutomationProperties.Name="{Binding Nome}">
                        <Border CornerRadius="10" Padding="7,0">
                            <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#10FFFFFF"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.EhAreia, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Background" Value="#292B32"/></DataTrigger></Style.Triggers></Style></Border.Style>
                            <Viewbox Stretch="Uniform" MaxHeight="{Binding DataContext.AlturaBarra, RelativeSource={RelativeSource AncestorType=Window}}">
                                <controls:EstiloRelogioControl Width="156" Height="52"
                                    Estilo="{Binding Relogio.Estilo}"
                                    Horario="{Binding Relogio.Horario}"
                                    TempoControle="{Binding Relogio.TempoControle}"/>
                            </Viewbox>
                        </Border>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Rectangle Width="1" Height="24"
                   Fill="{Binding SeparadorColor, Converter={StaticResource ColorToBrushConverter}}"
                   Visibility="{Binding ExibirBotoesAcao, Converter={StaticResource BoolToVis}}"
                   Margin="6,0"/>

        <!-- Área de ações: superfície compartilhada e ícones vetoriais. -->
        <Border x:Name="QuickActionsSurface" Padding="0" Margin="2,0"
                Background="Transparent" BorderThickness="0"
                Visibility="{Binding ExibirBotoesAcao, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource DockControlButton}" Command="{Binding ToggleBarraNativaCommand}"
                        Visibility="{Binding UsarComoBarraPrincipal, Converter={StaticResource BoolToVis}}"
                        ToolTip="Mostrar ou esconder a barra do Windows" AutomationProperties.Name="Mostrar Barra do Windows">
                    <Path Style="{StaticResource DockControlIcon}" Data="{StaticResource DockIconTaskbar}"/>
                </Button>
                <Button Style="{StaticResource DockControlButton}" Command="{Binding AbrirAjustesCommand}"
                        ToolTip="Ajustes e personalização" AutomationProperties.Name="Ajustes e Personalização">
                    <Path Style="{StaticResource DockControlIcon}" Data="{StaticResource DockIconSettings}"/>
                </Button>
            </StackPanel>
        </Border>

        <!-- Separador Lixeira -->
        <Rectangle Width="1" Height="24"
                   Fill="{Binding SeparadorColor, Converter={StaticResource ColorToBrushConverter}}"
                   Visibility="{Binding ExibirLixeira, Converter={StaticResource BoolToVis}}"
                   Margin="6,0"/>

        <Button Style="{StaticResource DockControlButton}" Command="{Binding AbrirLixeiraCommand}"
                Visibility="{Binding ExibirLixeira, Converter={StaticResource BoolToVis}}"
                ToolTip="Lixeira" AutomationProperties.Name="Abrir lixeira">
            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE74D;" FontSize="16"/>
        </Button>

        <sections:SectionBateria/>
        <Button x:Name="AppsSegundoPlanoButton" Style="{StaticResource DockControlButton}"
                Command="{Binding AbrirBandejaOcultaCommand}" Margin="3,0"
                ToolTip="Bandeja da dock (experimental)" AutomationProperties.Name="Abrir bandeja da dock">
                    <Path Style="{StaticResource DockControlIcon}" Data="{StaticResource DockIconTray}"/>
                </Button>
        <Popup IsOpen="{Binding BandejaAvisoAberto, Mode=TwoWay}" PlacementTarget="{Binding ElementName=AppsSegundoPlanoButton}"
               Placement="Top" VerticalOffset="-10" StaysOpen="False" AllowsTransparency="True">
            <Border Width="300" Padding="16" CornerRadius="12"
                    Background="{Binding FundoCardColor, Converter={StaticResource ColorToBrushConverter}}"
                    BorderBrush="{Binding BordaDockColor, Converter={StaticResource ColorToBrushConverter}}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Bandeja do Windows" FontWeight="SemiBold" FontSize="14"
                               Foreground="{Binding TextoPrincipalColor, Converter={StaticResource ColorToBrushConverter}}"/>
                    <TextBlock Text="{Binding BandejaMensagem}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Foreground="{Binding TextoPrincipalColor, Converter={StaticResource ColorToBrushConverter}}"/>
                </StackPanel>
            </Border>
        </Popup>
        <Popup IsOpen="{Binding PainelAppsSegundoPlanoAberto, Mode=TwoWay}"
               PlacementTarget="{Binding ElementName=AppsSegundoPlanoButton}" Placement="Top"
               VerticalOffset="-12" StaysOpen="False" AllowsTransparency="True" PopupAnimation="None">
            <Border PreviewMouseMove="BandejaDock_Interaction" PreviewMouseDown="BandejaDock_Interaction" PreviewKeyDown="BandejaDock_Interaction" Width="390" MaxHeight="310" Padding="16" CornerRadius="18"
                    Background="#F2171B22" BorderBrush="#445566" BorderThickness="1">
                <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="6" Opacity="0.55"/></Border.Effect>
                <StackPanel>
                    <Grid Margin="2,0,2,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Em segundo plano" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="Aplicativos em execução neste usuário" Foreground="#94A3B8" FontSize="10" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#253141" CornerRadius="10" Padding="9,4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding AplicativosSegundoPlano.Count}" Foreground="#B9D9F4" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>
                    <Border Height="1" Background="#394451" Margin="2,0,2,10"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="225">
                        <ItemsControl ItemsSource="{Binding AplicativosSegundoPlano}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel ItemWidth="64" ItemHeight="68"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding AbrirCommand}" Width="58" Height="62" Margin="3"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            ToolTip="{Binding Nome}" AutomationProperties.Name="{Binding Nome}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Card" CornerRadius="12" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="7">
                                                    <Grid>
                                                        <Border Width="34" Height="34" CornerRadius="9" Background="#25364A">
                                                            <TextBlock Text="{Binding Inicial}" Foreground="#B9D9F4" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <Image Source="{Binding Icone}" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        <Border Width="7" Height="7" CornerRadius="4" Background="#32D74B"
                                                                HorizontalAlignment="Right" VerticalAlignment="Bottom" BorderBrush="#17212C" BorderThickness="1"/>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="#18FFFFFF"/><Setter TargetName="Card" Property="BorderBrush" Value="#355B7A"/></Trigger>
                                                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Card" Property="Background" Value="#2AFFFFFF"/></Trigger>
                                                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#78BEFF"/></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Popup>
        <Popup x:Name="BandejaDockPopup" Opened="BandejaDock_Opened" Closed="BandejaDock_Closed" IsOpen="{Binding BandejaEspelhadaAberta, Mode=TwoWay}"
               PlacementTarget="{Binding ElementName=AppsSegundoPlanoButton}" Placement="Top"
               VerticalOffset="-12" StaysOpen="False" AllowsTransparency="True" PopupAnimation="None">
            <Border PreviewMouseMove="BandejaDock_Interaction" PreviewMouseDown="BandejaDock_Interaction" PreviewKeyDown="BandejaDock_Interaction" Width="390" MaxHeight="310" Padding="16" CornerRadius="18"
                    Background="{Binding FundoCardColor, Converter={StaticResource ColorToBrushConverter}}" BorderBrush="{Binding BordaDockColor, Converter={StaticResource ColorToBrushConverter}}" BorderThickness="1">
                <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="6" Opacity="0.55"/></Border.Effect>
                <StackPanel>
                    <Grid Margin="2,0,2,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Bandeja da dock" Foreground="{Binding TextoPrincipalColor, Converter={StaticResource ColorToBrushConverter}}" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="Experimental · atualiza ao abrir · clique simples" Foreground="#94A3B8" FontSize="10" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#253141" CornerRadius="10" Padding="9,4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding IconesBandejaEspelhada.Count}" Foreground="#B9D9F4" FontWeight="SemiBold"/>
                        </Border>
                        <Button Grid.Column="2" Click="BandejaDock_Close" Content="&#x00D7;" Width="30" Height="30" Margin="8,0,0,0" FontSize="20" Background="Transparent" BorderThickness="0" Foreground="{Binding TextoPrincipalColor, Converter={StaticResource ColorToBrushConverter}}" ToolTip="Fechar bandeja" AutomationProperties.Name="Fechar bandeja da dock"/>
                    </Grid>
                    <Border Height="1" Background="#394451" Margin="2,0,2,10"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="225">
                        <ItemsControl ItemsSource="{Binding IconesBandejaEspelhada}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel ItemWidth="64" ItemHeight="68"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding AbrirCommand}" Width="58" Height="62" Margin="3"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            ToolTip="{Binding Nome}" AutomationProperties.Name="{Binding Nome}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Card" CornerRadius="12" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="7">
                                                    <Grid>
                                                        <Border Width="34" Height="34" CornerRadius="9" Background="#25364A">
                                                            <TextBlock Text="{Binding Inicial}" Foreground="#B9D9F4" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <Image Source="{Binding Icone}" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        <Border Width="7" Height="7" CornerRadius="4" Background="Transparent"
                                                                HorizontalAlignment="Right" VerticalAlignment="Bottom" BorderBrush="Transparent" BorderThickness="1"/>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="#18FFFFFF"/><Setter TargetName="Card" Property="BorderBrush" Value="#355B7A"/></Trigger>
                                                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Card" Property="Background" Value="#2AFFFFFF"/></Trigger>
                                                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#78BEFF"/></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Button Command="{Binding AbrirBandejaNativaCommand}" Content="Abrir bandeja do Windows" Margin="2,12,2,0" Padding="10,8" Cursor="Hand" Background="#18FFFFFF" Foreground="{Binding TextoPrincipalColor, Converter={StaticResource ColorToBrushConverter}}" ToolTip="Menus e ações nativas, incluindo botão direito">
                        <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="NativeSurface" CornerRadius="10" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="#30FFFFFF"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NativeSurface" Property="Background" Value="#30FFFFFF"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="NativeSurface" Property="BorderBrush" Value="#78BEFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>
        <sections:SectionNotificacoes/>
        <sections:SectionControlesRapidos/>
    </StackPanel>
</UserControl>

