<UserControl x:Class="DockWindows.App.Views.Sections.SectionNotasInline"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DockWindows.App.Converters"
             Height="{Binding DataContext.TamanhoIconeNumerico, RelativeSource={RelativeSource AncestorType=Window}}"
             Margin="{Binding DataContext.MargemItem, RelativeSource={RelativeSource AncestorType=Window}}">
    
    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    
    <Grid>
        <!-- Botão Compacto na Barra -->
        <Border CornerRadius="10" Padding="8,4" Background="#18FFFFFF" Cursor="Hand"
                MouseLeftButtonDown="AbrirPainel_Click">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="📝" FontSize="13" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBlock Text="{Binding Notas.ResumoNotas}" FontSize="11" Foreground="#DDDDDD" 
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="100"/>
            </StackPanel>
        </Border>
        
        <!-- Painel Popup de Notas -->
        <Popup x:Name="PopupNotas" IsOpen="{Binding Notas.PainelAberto, Mode=TwoWay}" 
               StaysOpen="False" Placement="Top" VerticalOffset="-8"
               AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="#1C1C22" BorderBrush="#3A3A44" BorderThickness="1" 
                    CornerRadius="12" Width="300" Height="280" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="📝 Bloco de Notas" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock Text="Suas anotações são salvas automaticamente" FontSize="10" Foreground="#8E8E93"/>
                    </StackPanel>
                    
                    <TextBox Grid.Row="1" Text="{Binding Notas.TextoNotas, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Background="#24242C" Foreground="#FFFFFF" BorderThickness="0" 
                             Padding="10" FontSize="12" CaretBrush="#0A84FF"
                             VerticalContentAlignment="Top"/>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
