<UserControl xmlns:atividade="clr-namespace:DockWindows.App.Common" atividade:AtividadeVisual.Componente="Notas" x:Class="DockWindows.App.Views.Sections.SectionNotasInline"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Margin="{Binding DataContext.MargemItem, RelativeSource={RelativeSource AncestorType=Window}}">
    <Grid>
        <Button x:Name="NotasCard" Command="{Binding Notas.AlternarPainelCommand}" Padding="0" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Abrir editor de notas">
        <Border CornerRadius="12" Padding="6" Background="#161B22" Cursor="Hand"
                ToolTip="{Binding Notas.Descricao}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.3" Color="Black"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                
                <!-- Ícone da Esquerda -->
                <Border Width="40" Height="40" CornerRadius="8" Background="#1C1C1E" Padding="4">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE90A;" FontSize="14" Foreground="#34C759" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Notas.QuantidadeLinhas}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Pílula da Direita (Mini checklist mockado visualmente a partir do texto) -->
                <Border CornerRadius="10" Background="#21262D" Height="40" Margin="6,0,0,0" Padding="12,4">
                    <StackPanel VerticalAlignment="Center" MaxWidth="150">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <Ellipse Width="6" Height="6" Stroke="#8E8E93" StrokeThickness="1" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding Notas.ResumoNotas, FallbackValue='Anotar ideias...'}" FontSize="10" Foreground="#E5E7EB" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
        </Button>
        <Popup IsOpen="{Binding Notas.PainelAberto, Mode=TwoWay}" PlacementTarget="{Binding ElementName=NotasCard}" Placement="Top" StaysOpen="False" AllowsTransparency="True">
            <Border Background="#161B22" BorderBrush="#3B4657" BorderThickness="1" CornerRadius="12" Padding="16" Width="340">
                <StackPanel>
                    <TextBlock Text="Notas" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBox Text="{Binding Notas.TextoNotas, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="220" Background="#202936" Foreground="White" CaretBrush="White" Padding="8" AutomationProperties.Name="Texto das notas"/>
                    <TextBlock Text="{Binding Notas.ErroPersistencia}" Foreground="#FFB4A2" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>

