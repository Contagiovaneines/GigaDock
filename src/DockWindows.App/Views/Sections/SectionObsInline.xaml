<UserControl x:Class="DockWindows.App.Views.Sections.SectionObsInline"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DockWindows.App.Converters"
             Height="{Binding DataContext.TamanhoIconeNumerico, RelativeSource={RelativeSource AncestorType=Window}}"
             Margin="{Binding DataContext.MargemItem, RelativeSource={RelativeSource AncestorType=Window}}">
    
    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Visibility="{Binding Obs.Habilitado, Converter={StaticResource BoolToVis}}">
        <Border CornerRadius="12" Padding="8,4" Background="Transparent" BorderThickness="0">
            
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Icone do OBS -->
                <Border Background="Transparent" Cursor="Hand" ToolTip="Abrir OBS Studio" Margin="0,0,8,0">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding Obs.AbrirAppCommand}"/>
                    </Border.InputBindings>
                    <Grid>
                        <Ellipse Width="32" Height="32" Fill="#1A1A1E" Stroke="#2C2C36" StrokeThickness="1"/>
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE714;" FontSize="16" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Botão de Gravar -->
                <Button Command="{Binding Obs.AlternarGravacaoCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Iniciar/Parar Gravação">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="RecBorder" CornerRadius="8" Background="#1C1C22" BorderBrush="#2C2C36" BorderThickness="1" Padding="12,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Fill="{Binding Obs.CorBotaoGravar}" Margin="0,0,6,0">
                                        <Ellipse.Effect>
                                            <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="{Binding Obs.CorGlowGravar}"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <TextBlock Text="{Binding Obs.TextoBotaoGravar}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="RecBorder" Property="Background" Value="#2A2A33"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="RecBorder" Property="Background" Value="#40404C"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
