<UserControl x:Class="DockWindows.App.Views.Sections.SectionGitHubInline"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             
             Margin="{Binding DataContext.MargemItem, RelativeSource={RelativeSource AncestorType=Window}}">
    
    <Grid>
        <Border CornerRadius="12" Padding="12,6" Background="#0D1117" BorderBrush="#30363D" BorderThickness="1"
                Cursor="Hand"  ToolTip="{Binding GitHub.TextoResumo}">
                                    <Border.InputBindings>
                <MouseBinding MouseAction="LeftClick" Command="{Binding GitHub.AbrirPerfilCommand}"/>
            </Border.InputBindings>
            <Border.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="Animação: Cobrinha" Command="{Binding GitHub.DefinirAnimacaoCommand}" CommandParameter="Cobrinha"/>
                    <MenuItem Header="Animação: Pac-Man" Command="{Binding GitHub.DefinirAnimacaoCommand}" CommandParameter="PacMan"/>
                    <MenuItem Header="Desativar Animação" Command="{Binding GitHub.DefinirAnimacaoCommand}" CommandParameter="Parado"/>
                </ContextMenu>
            </Border.ContextMenu>
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.3" Color="Black"/>
            </Border.Effect>

            <!-- Mini Heatmap (Últimas semanas) - Apenas os quadradinhos -->
            <ItemsControl ItemsSource="{Binding GitHub.Contribuicoes}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="13" Rows="7"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Quadradinhos um pouco maiores, com margem ajustada -->
                        <Border Width="4" Height="4" CornerRadius="1" Margin="1"
                                Background="{Binding Cor}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </Border>
    </Grid>
</UserControl>





