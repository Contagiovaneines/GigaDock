<UserControl x:Class="DockWindows.App.Views.Sections.SectionWidgets"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DockWindows.App.Converters"
             xmlns:local="clr-namespace:DockWindows.App.Views.Sections">

    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InvertBoolToVis"/>
        <conv:ColorToBrushConverter x:Key="ColorToBrushConverter"/>
    </UserControl.Resources>

    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        
        <!-- WIDGET 1: POMODORO -->
        <Border x:Name="PomodoroBorder"
                Background="#18FFFFFF" CornerRadius="10" Padding="6,4" Margin="2,0"
                Visibility="{Binding Pomodoro.Habilitado, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Botão do Pomodoro com Magnificação Suave -->
                <Button Command="{Binding Pomodoro.AlternarPainelCommand}"
                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                        ToolTip="Controle do Pomodoro">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="PomoScale" ScaleX="1.0" ScaleY="1.0"/>
                                </Grid.RenderTransform>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⏱️" Margin="0,0,4,0" FontSize="12"/>
                                    <TextBlock Text="{Binding DataContext.Pomodoro.TextoExibicao, RelativeSource={RelativeSource AncestorType=Window}}"
                                               FontSize="12" FontWeight="Bold"
                                               Foreground="{Binding DataContext.Pomodoro.CorEstado, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ColorToBrushConverter}}"/>
                                </StackPanel>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="PomoScale" Storyboard.TargetProperty="ScaleX" To="1.14" Duration="0:0:0.12">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="PomoScale" Storyboard.TargetProperty="ScaleY" To="1.14" Duration="0:0:0.12">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="PomoScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.12">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="PomoScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.12">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Botão Play/Pause Rápido -->
                <Button Command="{Binding Pomodoro.IniciarPausarCommand}"
                        Content="{Binding Pomodoro.TextoBotaoExecutar}"
                        Background="Transparent" BorderThickness="0"
                        Foreground="#FFFFFF" FontSize="10" FontWeight="Bold"
                        Margin="6,0,0,0" Padding="4,2" Cursor="Hand"
                        ToolTip="Iniciar / Pausar Pomodoro"/>
            </StackPanel>
        </Border>

        <!-- FLYOUT POPUP: DETALHES DO POMODORO -->
        <Popup IsOpen="{Binding Pomodoro.PainelAberto, Mode=TwoWay}"
               StaysOpen="False"
               Placement="Top"
               PlacementTarget="{Binding ElementName=PomodoroBorder}">
            <Border Background="{Binding FundoCardColor, Converter={StaticResource ColorToBrushConverter}}"
                    BorderBrush="{Binding BordaDockColor, Converter={StaticResource ColorToBrushConverter}}"
                    BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,10" Width="230">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.45" Color="Black"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Pomodoro.EstadoTexto}" FontSize="14" FontWeight="Bold"
                               Foreground="{Binding Pomodoro.CorEstado, Converter={StaticResource ColorToBrushConverter}}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Pomodoro.TempoFormatado}" FontSize="28" FontWeight="Bold"
                               Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,4"/>

                    <!-- Ciclos Concluídos -->
                    <TextBlock Text="{Binding Pomodoro.CiclosConcluidos, StringFormat={}Ciclos concluídos: {0}}"
                               FontSize="11" Foreground="#8E8E93" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                    <!-- Barra de Progresso do Ciclo -->
                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding Pomodoro.Progresso, Mode=OneWay}"
                                 Height="4" Margin="0,0,0,10" Background="#33333A" Foreground="#FF9F0A"/>

                    <!-- Botões de Controle -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Command="{Binding Pomodoro.IniciarPausarCommand}"
                                Content="{Binding Pomodoro.TextoBotaoExecutar}"
                                Width="36" Height="30" Background="#0A84FF" Foreground="#FFFFFF"
                                Margin="3,0" Cursor="Hand"/>
                        <Button Command="{Binding Pomodoro.ReiniciarCommand}"
                                Content="🔄" Width="36" Height="30" Background="#33333A" Foreground="#FFFFFF"
                                Margin="3,0" Cursor="Hand" ToolTip="Reiniciar ciclo"/>
                        <Button Command="{Binding Pomodoro.PularFaseCommand}"
                                Content="⏭️" Width="36" Height="30" Background="#33333A" Foreground="#FFFFFF"
                                Margin="3,0" Cursor="Hand" ToolTip="Avançar fase"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>

        <!-- WIDGET 2: CALENDÁRIO -->
        <local:SectionCalendarioInline Visibility="{Binding Calendario.Habilitado, Converter={StaticResource BoolToVis}}" Margin="2,0"/>

        <!-- WIDGET: NOTAS -->
        <local:SectionNotasInline Visibility="{Binding Notas.Habilitado, Converter={StaticResource BoolToVis}}" Margin="2,0"/>
        
        <!-- WIDGET: GITHUB -->
        <local:SectionGitHubInline Visibility="{Binding GitHub.Habilitado, Converter={StaticResource BoolToVis}}" Margin="2,0"/>

        <!-- WIDGET: MONITOR -->
        <local:SectionMonitorInline Visibility="{Binding MonitorSistema.Habilitado, Converter={StaticResource BoolToVis}}" Margin="2,0"/>
    </StackPanel>
</UserControl>



