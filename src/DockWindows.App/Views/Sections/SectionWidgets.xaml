<UserControl xmlns:atividade="clr-namespace:DockWindows.App.Common" x:Class="DockWindows.App.Views.Sections.SectionWidgets"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DockWindows.App.Converters"
             xmlns:local="clr-namespace:DockWindows.App.Views.Sections">

    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InvertBoolToVis"/>
        <conv:ColorToBrushConverter x:Key="ColorToBrushConverter"/>
    </UserControl.Resources>

    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        
        <!-- WIDGET 1: POMODORO -->
        <Border x:Name="PomodoroBorder" atividade:AtividadeVisual.Componente="Pomodoro"
                Background="#18FFFFFF" CornerRadius="10" Padding="6,4" Margin="2,0"
                Visibility="{Binding Pomodoro.Habilitado, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Botão do Pomodoro com Magnificação Suave -->
                <Button Command="{Binding Pomodoro.AlternarPainelCommand}"
                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                        ToolTip="Controle do Pomodoro">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="PomoScale" ScaleX="1.0" ScaleY="1.0"/>
                                </Grid.RenderTransform>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⏱️" Margin="0,0,4,0" FontSize="12"/>
                                    <TextBlock Text="{Binding DataContext.Pomodoro.TextoExibicao, RelativeSource={RelativeSource AncestorType=Window}}"
                                               FontSize="12" FontWeight="Bold"
                                               Foreground="{Binding DataContext.Pomodoro.CorEstado, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ColorToBrushConverter}}"/>
                                </StackPanel>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="PomoScale" Storyboard.TargetProperty="ScaleX" To="1.14" Duration="0:0:0.12">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="PomoScale" Storyboard.TargetProperty="ScaleY" To="1.14" Duration="0:0:0.12">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="PomoScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.12">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="PomoScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.12">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Botão Play/Pause Rápido -->
                <Button Command="{Binding Pomodoro.IniciarPausarCommand}"
                        Content="{Binding Pomodoro.TextoBotaoExecutar}"
                        Background="Transparent" BorderThickness="0"
                        Foreground="#FFFFFF" FontSize="10" FontWeight="Bold"
                        Margin="6,0,0,0" Padding="4,2" Cursor="Hand"
                        ToolTip="Iniciar / Pausar Pomodoro"/>
            </StackPanel>
        </Border>

        <!-- FLYOUT POPUP: DETALHES DO POMODORO -->
        <Popup IsOpen="{Binding Pomodoro.PainelAberto, Mode=TwoWay}"
               StaysOpen="False"
               Placement="Top"
               PlacementTarget="{Binding ElementName=PomodoroBorder}">
            <Border Background="{Binding FundoCardColor, Converter={StaticResource ColorToBrushConverter}}"
                    BorderBrush="{Binding BordaDockColor, Converter={StaticResource ColorToBrushConverter}}"
                    BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,10" Width="230">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.45" Color="Black"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Pomodoro.EstadoTexto}" FontSize="14" FontWeight="Bold"
                               Foreground="{Binding Pomodoro.CorEstado, Converter={StaticResource ColorToBrushConverter}}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Pomodoro.TempoFormatado}" FontSize="28" FontWeight="Bold"
                               Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,4"/>

                    <!-- Ciclos Concluídos -->
                    <TextBlock Text="{Binding Pomodoro.CiclosConcluidos, StringFormat={}Ciclos concluídos: {0}}"
                               FontSize="11" Foreground="#8E8E93" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                    <!-- Barra de Progresso do Ciclo -->
                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding Pomodoro.Progresso, Mode=OneWay}"
                                 Height="4" Margin="0,0,0,10" Background="#33333A" Foreground="#FF9F0A"/>

                    <!-- Botões de Controle -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Command="{Binding Pomodoro.IniciarPausarCommand}"
                                Content="{Binding Pomodoro.TextoBotaoExecutar}"
                                Width="36" Height="30" Background="#0A84FF" Foreground="#FFFFFF"
                                Margin="3,0" Cursor="Hand"/>
                        <Button Command="{Binding Pomodoro.ReiniciarCommand}"
                                Content="🔄" Width="36" Height="30" Background="#33333A" Foreground="#FFFFFF"
                                Margin="3,0" Cursor="Hand" ToolTip="Reiniciar ciclo"/>
                        <Button Command="{Binding Pomodoro.PularFaseCommand}"
                                Content="⏭️" Width="36" Height="30" Background="#33333A" Foreground="#FFFFFF"
                                Margin="3,0" Cursor="Hand" ToolTip="Avançar fase"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>

        <!-- WIDGET 2: CALENDÁRIO -->
        <local:SectionCalendarioInline Visibility="{Binding Calendario.Habilitado, Converter={StaticResource BoolToVis}}" Margin="2,0"/>

        <!-- WIDGET: NOTAS -->
        <local:SectionNotasInline Visibility="{Binding Notas.Habilitado, Converter={StaticResource BoolToVis}}" Margin="2,0"/>
        <ItemsControl ItemsSource="{Binding NotasAdicionais}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate><local:SectionNotasInline Margin="2,0"/></DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Visibility="{Binding LembreteAgua.Habilitado, Converter={StaticResource BoolToVis}}"
                CornerRadius="10" Background="#152A2630" Padding="8,5" Margin="2,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="💧" FontSize="15" Margin="0,0,5,0"/>
                <StackPanel>
                    <TextBlock Text="{Binding LembreteAgua.TextoResumo}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding LembreteAgua.TextoProximo, StringFormat='Próximo: {0}'}" Foreground="#9FB1C3" FontSize="9"/>
                </StackPanel>
                <Button Content="Bebi" Command="{Binding LembreteAgua.BeberAguaCommand}" Margin="8,0,0,0" Padding="7,3"
                        Background="#1F6F5C" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                <Button Content="+10" Command="{Binding LembreteAgua.AdiarCommand}" Margin="4,0,0,0" Padding="6,3"
                        Background="#2B3440" Foreground="White" BorderThickness="0" Cursor="Hand" ToolTip="Adiar por dez minutos"/>
            </StackPanel>
        </Border>

        <Button Visibility="{Binding CotacaoMoedas.Habilitado, Converter={StaticResource BoolToVis}}"
                Command="{Binding CotacaoMoedas.AtualizarCommand}" Background="Transparent" BorderThickness="0"
                ToolTip="{Binding CotacaoMoedas.MotivoEstado}" Cursor="Hand" Margin="2,0">
            <Border CornerRadius="10" Background="#1626313D" Padding="10,6">
                <StackPanel>
                    <TextBlock Text="{Binding CotacaoMoedas.Texto}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="BCE · taxa diária" Foreground="#9FB1C3" FontSize="9"/>
                </StackPanel>
            </Border>
        </Button>

        <Grid Visibility="{Binding AreaTransferencia.Habilitado, Converter={StaticResource BoolToVis}}" Margin="2,0">
            <Button x:Name="ClipboardButton" Command="{Binding AreaTransferencia.AlternarPainelCommand}"
                    Background="#1626313D" BorderThickness="0" Padding="9,6" Cursor="Hand"
                    ToolTip="{Binding AreaTransferencia.Estado}" AutomationProperties.Name="Abrir histórico da área de transferência">
                <StackPanel Orientation="Horizontal"><TextBlock Text="📋" Margin="0,0,5,0"/><TextBlock Text="{Binding AreaTransferencia.Itens.Count}" Foreground="White" FontWeight="SemiBold"/></StackPanel>
            </Button>
            <Popup IsOpen="{Binding AreaTransferencia.PainelAberto, Mode=TwoWay}" PlacementTarget="{Binding ElementName=ClipboardButton}" Placement="Top" StaysOpen="False" AllowsTransparency="True">
                <Border Width="360" MaxHeight="330" Background="#F2171B22" BorderBrush="#445566" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10"><Button DockPanel.Dock="Right" Content="Limpar" Command="{Binding AreaTransferencia.LimparCommand}" Padding="8,3"/><TextBlock Text="Área de transferência" Foreground="White" FontSize="15" FontWeight="SemiBold"/></DockPanel>
                        <TextBlock Text="Somente textos desta sessão. Máximo de 20 itens." Foreground="#9FB1C3" FontSize="10" Margin="0,0,0,8"/>
                        <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding AreaTransferencia.Itens}"><ItemsControl.ItemTemplate><DataTemplate>
                                <Border Background="#202936" CornerRadius="8" Padding="8" Margin="0,0,0,6"><DockPanel>
                                    <Button DockPanel.Dock="Right" Content="×" Command="{Binding RemoverCommand}" Margin="6,0,0,0"/>
                                    <Button Command="{Binding CopiarCommand}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" ToolTip="Copiar novamente"><TextBlock Text="{Binding Resumo}" Foreground="White" TextWrapping="Wrap"/></Button>
                                </DockPanel></Border>
                            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>

        <Grid Visibility="{Binding ArquivosRecentes.Habilitado, Converter={StaticResource BoolToVis}}" Margin="2,0">
            <Button x:Name="RecentesButton" Command="{Binding ArquivosRecentes.AlternarPainelCommand}"
                    Background="#1626313D" BorderThickness="0" Padding="9,6" Cursor="Hand"
                    ToolTip="{Binding ArquivosRecentes.Estado}" AutomationProperties.Name="Abrir Downloads e capturas recentes">
                <StackPanel Orientation="Horizontal"><TextBlock Text="📁" Margin="0,0,5,0"/><TextBlock Text="{Binding ArquivosRecentes.Itens.Count}" Foreground="White" FontWeight="SemiBold"/></StackPanel>
            </Button>
            <Popup IsOpen="{Binding ArquivosRecentes.PainelAberto, Mode=TwoWay}" PlacementTarget="{Binding ElementName=RecentesButton}" Placement="Top" StaysOpen="False" AllowsTransparency="True">
                <Border Width="390" MaxHeight="360" Background="#F2171B22" BorderBrush="#445566" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Capturar tela" Command="{Binding ArquivosRecentes.CapturarCommand}" Padding="8,4" Margin="0,0,5,0"/><Button Content="Atualizar" Command="{Binding ArquivosRecentes.AtualizarCommand}" Padding="8,4"/></StackPanel>
                            <TextBlock Text="Downloads e capturas" Foreground="White" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Text="{Binding ArquivosRecentes.Estado}" Foreground="#9FB1C3" FontSize="10" Margin="0,0,0,8"/>
                        <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding ArquivosRecentes.Itens}"><ItemsControl.ItemTemplate><DataTemplate>
                            <Button Command="{Binding AbrirCommand}" Background="#202936" BorderThickness="0" Margin="0,0,0,6" Padding="9" HorizontalContentAlignment="Stretch" ToolTip="{Binding Caminho}">
                                <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Pasta}" Foreground="#8291A3" FontSize="9" Margin="8,0,0,0"/><TextBlock Text="{Binding Nome}" Foreground="White" TextTrimming="CharacterEllipsis"/></DockPanel>
                            </Button>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>

        <Grid Visibility="{Binding Conectividade.Habilitado, Converter={StaticResource BoolToVis}}" Margin="2,0">
            <Button x:Name="ConectividadeButton" Command="{Binding Conectividade.AlternarPainelCommand}" Background="#1626313D" BorderThickness="0" Padding="9,6" Cursor="Hand" ToolTip="{Binding Conectividade.MotivoEstado}">
                <StackPanel Orientation="Horizontal"><TextBlock Text="◉" Foreground="#5AC8FA" Margin="0,0,5,0"/><TextBlock Text="{Binding Conectividade.Intensidade, StringFormat={}{0}%}" Foreground="White" FontWeight="SemiBold"/></StackPanel>
            </Button>
            <Popup IsOpen="{Binding Conectividade.PainelAberto, Mode=TwoWay}" PlacementTarget="{Binding ElementName=ConectividadeButton}" Placement="Top" StaysOpen="False" AllowsTransparency="True">
                <Border Width="340" MaxHeight="330" Background="#F2171B22" BorderBrush="#445566" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10"><Button DockPanel.Dock="Right" Content="Atualizar" Command="{Binding Conectividade.AtualizarCommand}" Padding="8,4"/><TextBlock Text="Conectividade" Foreground="White" FontSize="15" FontWeight="SemiBold"/></DockPanel>
                        <Button Command="{Binding Conectividade.AbrirRedeCommand}" Background="#202936" BorderThickness="0" Padding="10" HorizontalContentAlignment="Stretch" Margin="0,0,0,8">
                            <StackPanel><TextBlock Text="{Binding Conectividade.Wifi, Mode=OneWay}" Foreground="White" FontWeight="SemiBold"/><ProgressBar Minimum="0" Maximum="100" Value="{Binding Conectividade.Intensidade, Mode=OneWay}" Height="3" Margin="0,6,0,0"/></StackPanel>
                        </Button>
                        <DockPanel Margin="0,4,0,7"><Button DockPanel.Dock="Right" Content="Configurar" Command="{Binding Conectividade.AbrirBluetoothCommand}" Padding="7,3"/><TextBlock Text="Bluetooth conectado" Foreground="#B8C5D3" FontWeight="SemiBold"/></DockPanel>
                        <ItemsControl ItemsSource="{Binding Conectividade.Bluetooth}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#202936" CornerRadius="7" Padding="8" Margin="0,0,0,5"><TextBlock Text="{Binding Nome}" Foreground="White"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>

        <Grid Visibility="{Binding AudioSistema.Habilitado, Converter={StaticResource BoolToVis}}" Margin="2,0">
            <Button x:Name="AudioSistemaButton" Command="{Binding AudioSistema.AlternarPainelCommand}" Background="#1626313D" BorderThickness="0" Padding="9,6" Cursor="Hand"
                    ToolTip="Mixer de volume" PreviewMouseWheel="AudioSistemaButton_OnPreviewMouseWheel" PreviewMouseDown="AudioSistemaButton_OnPreviewMouseDown">
                <TextBlock Text="{Binding AudioSistema.IconeVolumeMestre}" FontSize="14"/>
            </Button>
            <Popup IsOpen="{Binding AudioSistema.PainelAberto, Mode=TwoWay}" PlacementTarget="{Binding ElementName=AudioSistemaButton}" Placement="Top" StaysOpen="False" AllowsTransparency="True">
                <Border Width="{Binding AudioSistema.LarguraPainel}" MaxHeight="520" Background="#FA171A20" BorderBrush="#39414D" BorderThickness="1" CornerRadius="14" Padding="12" Margin="0,0,0,10">
                    <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity=".45" Color="Black"/></Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <DockPanel Margin="2,0,0,10">
                            <Button DockPanel.Dock="Right" Content="✕" Command="{Binding AudioSistema.AlternarPainelCommand}" Width="32" Height="30" Background="Transparent" Foreground="#AEB8C6" BorderThickness="0" FontSize="15" ToolTip="Fechar"/>
                            <TextBlock Text="Mixer de volume" Foreground="White" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Button Grid.Row="1" Command="{Binding AudioSistema.AbrirSomCommand}" Background="#20242C" BorderThickness="0" Padding="10,7" HorizontalContentAlignment="Stretch" ToolTip="Gerenciar dispositivos de reprodução no Windows">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="▣" Foreground="#C8D4E3" Margin="0,0,9,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding AudioSistema.SaidaAtual}" Foreground="#DDE5EF" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="2" Text="⌄" Foreground="#94A0AF"/>
                            </Grid>
                        </Button>
                        <Border Grid.Row="2" Background="#22262E" CornerRadius="10" Padding="10" Margin="0,8,0,10">
                            <Grid PreviewMouseWheel="VolumeMestre_OnPreviewMouseWheel">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                                <Button Content="{Binding AudioSistema.IconeVolumeMestre}" Command="{Binding AudioSistema.AlternarMudoMestreCommand}" Background="#2C313B" BorderThickness="0" Foreground="White" Padding="0" FontSize="15" ToolTip="{Binding AudioSistema.DicaVolumeMestre}" PreviewMouseDown="VolumeMestre_OnPreviewMouseDown"/>
                                <Grid Grid.Column="1" Margin="10,0,8,0"><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <TextBlock Text="Volume principal" Foreground="#F4F6F8" FontWeight="SemiBold"/>
                                    <Slider Grid.Row="1" Minimum="0" Maximum="100" Value="{Binding AudioSistema.VolumeMestre, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsMoveToPointEnabled="True"/>
                                </Grid>
                                <TextBox Grid.Column="2" Text="{Binding AudioSistema.VolumeMestre, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F0}" Background="Transparent" BorderThickness="0" Foreground="#E9EDF3" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" ToolTip="Digite um volume exato de 0 a 100"/>
                            </Grid>
                        </Border>
                        <DockPanel Grid.Row="3" Margin="2,0,2,6">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding AudioSistema.SessoesDisponiveis}" Foreground="#8F9BAA"/>
                            <TextBlock Text="Aplicativos" Foreground="#8F9BAA" FontSize="11"/>
                        </DockPanel>
                        <ItemsControl Grid.Row="4" ItemsSource="{Binding AudioSistema.Sessoes}">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Border Background="#20242C" CornerRadius="9" Padding="9" Margin="0,0,0,6" PreviewMouseWheel="SessaoAudio_OnPreviewMouseWheel">
                                    <Border.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="{Binding TextoFixacao}" Command="{Binding AlternarFixacaoCommand}"/>
                                        <MenuItem Header="Copiar nome do processo" Command="{Binding CopiarNomeCommand}"/>
                                        <Separator/>
                                        <MenuItem Header="Ocultar até reabrir o mixer" Command="{Binding OcultarCommand}"/>
                                    </ContextMenu></Border.ContextMenu>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                                        <Border Width="30" Height="30" CornerRadius="7" Background="#2A303A"><TextBlock Text="♪" Foreground="#A9B7C8" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <Grid Grid.Column="1" Margin="8,0"><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                            <TextBlock Text="{Binding Nome}" ToolTip="{Binding DicaNome}" Foreground="#F0F3F7" TextTrimming="CharacterEllipsis"/>
                                            <Slider Grid.Row="1" Minimum="0" Maximum="100" Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsMoveToPointEnabled="True"/>
                                        </Grid>
                                        <TextBox Grid.Column="2" Text="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F0}" Background="Transparent" BorderThickness="0" Foreground="#DDE4EC" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" ToolTip="Digite um volume exato"/>
                                        <Button Grid.Column="3" Content="{Binding IconeVolume}" Command="{Binding AlternarMudoCommand}" Background="Transparent" BorderThickness="0" Foreground="#AEB9C7" ToolTip="Silenciar ou ativar som" PreviewMouseDown="SessaoAudio_OnPreviewMouseDown"/>
                                    </Grid>
                                </Border>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <DockPanel Grid.Row="5" Margin="0,5,0,0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="‹" Command="{Binding AudioSistema.PaginaAnteriorCommand}" Width="30" Padding="3" ToolTip="Página anterior"/>
                                <TextBlock Text="{Binding AudioSistema.TextoPagina}" Foreground="#9CA8B7" Margin="8,0" VerticalAlignment="Center"/>
                                <Button Content="›" Command="{Binding AudioSistema.ProximaPaginaCommand}" Width="30" Padding="3" ToolTip="Próxima página"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="⋯" Padding="8,2" Background="Transparent" Foreground="#AEB9C7" BorderThickness="0" ToolTip="Opções do mixer">
                                    <Button.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="Alternar modo compacto" Command="{Binding AudioSistema.AlternarCompactoCommand}"/>
                                        <MenuItem Header="{Binding AudioSistema.TextoMicrofone}" Command="{Binding AudioSistema.AlternarMicrofoneCommand}"/>
                                        <Separator/>
                                        <MenuItem Header="Atualizar aplicativos" Command="{Binding AudioSistema.AtualizarCommand}"/>
                                        <MenuItem Header="Configurações de Som" Command="{Binding AudioSistema.AbrirSomCommand}"/>
                                        <MenuItem Header="Painel de Som clássico" Command="{Binding AudioSistema.AbrirSomClassicoCommand}"/>
                                    </ContextMenu></Button.ContextMenu>
                                </Button>
                                <TextBlock Text="Por página" Foreground="#7F8B9A" FontSize="10" Margin="5,0" VerticalAlignment="Center"/>
                                <TextBox Width="25" Text="{Binding AudioSistema.AplicativosPorPagina, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Background="#252A33" BorderThickness="0" Foreground="#DDE4EC" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip="De 3 a 12 aplicativos por página"/>
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                </Border>
            </Popup>
        </Grid>

        <Grid Visibility="{Binding EstanteArquivos.Habilitado, Converter={StaticResource BoolToVis}}" Margin="2,0">
            <Button x:Name="EstanteButton" Command="{Binding EstanteArquivos.AlternarPainelCommand}" Background="#1626313D" BorderThickness="0" Padding="9,6" Cursor="Hand" ToolTip="{Binding EstanteArquivos.MotivoEstado}">
                <StackPanel Orientation="Horizontal"><TextBlock Text="▤" Foreground="#FFCC66" Margin="0,0,5,0"/><TextBlock Text="{Binding EstanteArquivos.Itens.Count}" Foreground="White" FontWeight="SemiBold"/></StackPanel>
            </Button>
            <Popup IsOpen="{Binding EstanteArquivos.PainelAberto, Mode=TwoWay}" PlacementTarget="{Binding ElementName=EstanteButton}" Placement="Top" StaysOpen="False" AllowsTransparency="True">
                <Border Width="620" Height="390" Background="#F2171B22" BorderBrush="#445566" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,10">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <DockPanel Grid.Column="0">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8"><Button Content="Adicionar" Command="{Binding EstanteArquivos.AdicionarCommand}" Padding="8,4"/><Button Content="Remover" Command="{Binding EstanteArquivos.RemoverCommand}" Padding="8,4" Margin="5,0,0,0"/></StackPanel>
                            <ListBox ItemsSource="{Binding EstanteArquivos.Itens}" SelectedItem="{Binding EstanteArquivos.Selecionado, Mode=TwoWay}" Background="#151B23" BorderThickness="0" DisplayMemberPath="Nome" Foreground="White"/>
                        </DockPanel>
                        <Border Grid.Column="2" Background="#151B23" CornerRadius="9" Padding="12">
                            <DockPanel><StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                    <Button Content="Abrir arquivo" Command="{Binding EstanteArquivos.AbrirCommand}" Padding="9,5"/>
                                    <Button Content="Compartilhar" Command="{Binding EstanteArquivos.CompartilharCommand}" Padding="9,5" Margin="6,0,0,0"/>
                                </StackPanel>
                                <StackPanel><TextBlock Text="{Binding EstanteArquivos.PreviewTitulo}" Foreground="White" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding EstanteArquivos.PreviewDescricao}" Foreground="#9FB1C3" FontSize="10" Margin="0,3,0,9"/>
                                    <Image Source="{Binding EstanteArquivos.PreviewImagem}" MaxHeight="240" Stretch="Uniform"/>
                                    <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding EstanteArquivos.PreviewTexto}" Foreground="#D5DEE8" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap"/></ScrollViewer>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>
            </Popup>
        </Grid>
        
        <!-- WIDGET: GITHUB -->
        <local:SectionGitHubInline Visibility="{Binding GitHub.Habilitado, Converter={StaticResource BoolToVis}}" Margin="2,0"/>

                <!-- WIDGET: MONITOR -->
        <local:SectionMonitorInline Visibility="{Binding MonitorSistema.Habilitado, Converter={StaticResource BoolToVis}}" Margin="2,0"/>
        
        <!-- WIDGET: WHATSAPP -->
        <local:SectionWhatsAppInline Visibility="{Binding WhatsApp.Habilitado, Converter={StaticResource BoolToVis}}" Margin="2,0"/>

        <!-- WIDGET: TEAMS -->
        <local:SectionTeamsInline Visibility="{Binding Teams.Habilitado, Converter={StaticResource BoolToVis}}" Margin="2,0"/>

        <!-- WIDGET: DISCORD -->
        <local:SectionDiscordInline Visibility="{Binding Discord.Habilitado, Converter={StaticResource BoolToVis}}" Margin="2,0"/>

        <!-- WIDGET: OBS STUDIO -->
        <local:SectionObsInline Visibility="{Binding Obs.Habilitado, Converter={StaticResource BoolToVis}}" Margin="2,0"/>
    </StackPanel>
</UserControl>






