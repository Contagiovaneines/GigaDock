<UserControl x:Class="DockWindows.App.Views.Sections.SectionWhatsAppInline"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DockWindows.App.Converters"
             Height="{Binding DataContext.TamanhoIconeNumerico, RelativeSource={RelativeSource AncestorType=Window}}"
             Margin="{Binding DataContext.MargemItem, RelativeSource={RelativeSource AncestorType=Window}}">
    <UserControl.Resources><conv:BooleanToVisibilityConverter x:Key="BoolToVis"/></UserControl.Resources>
    <Grid Visibility="{Binding WhatsApp.Habilitado, Converter={StaticResource BoolToVis}}">
        <Border CornerRadius="12" Padding="6" Background="#161B22" Cursor="Hand" ToolTip="WhatsApp">
                        <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Testar Alerta de Notificação (Verde)" Command="{Binding WhatsApp.TestarAlertaCommand}"/>
                </ContextMenu>
            </Border.ContextMenu>
            <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.3" Color="Black"/></Border.Effect>
            <Border CornerRadius="8" Background="#128C7E" Height="40" Padding="12,0,16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE8F2;" FontSize="18" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding WhatsApp.MensagensNaoLidas, StringFormat={}{0} mensagens}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock Text="{Binding WhatsApp.UltimaMensagem}" FontSize="10" Foreground="#D1F4CC" Margin="0,-2,0,0" MaxWidth="110" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>

