<Window x:Class="DockWindows.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GigaDock Setup" Height="420" Width="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E5E7EB"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- CONTAINER PRINCIPAL -->
    <Border CornerRadius="12" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" ClipToBounds="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Barra de Título Arrastável Mockada -->
            <Border Grid.ColumnSpan="2" Height="32" VerticalAlignment="Top" Background="Transparent" MouseLeftButtonDown="DragWindow" Panel.ZIndex="10"/>

            <!-- COLUNA ESQUERDA: APRESENTAÇÃO E FEATURES -->
            <Border Grid.Column="0" Background="#0D1117" BorderBrush="#30363D" BorderThickness="0,0,1,0" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Logo e Título -->
                    <StackPanel Grid.Row="0" Margin="0,10,0,0">
                        <Border Width="56" Height="56" CornerRadius="16" Background="#0A84FF" HorizontalAlignment="Left" Margin="0,0,0,16">
                            <!-- Ícone de Sorriso Apple/Finder mockado simples -->
                            <TextBlock Text="🤩" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="GigaDock 2.0" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock Text="A barra de tarefas definitiva." FontSize="11" Foreground="#8B949E" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Lista de Features (O que foi feito) -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,20,0,0">
                        
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE81E;" Foreground="#34C759" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Ambientes Ilimitados" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE734;" Foreground="#58A6FF" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Galeria de Widgets" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE8B3;" Foreground="#FF9F0A" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Visual Premium (macOS)" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE756;" Foreground="#BF5AF2" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Motor Gráfico Refeito" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>

                    </StackPanel>

                    <!-- Rodapé Esquerdo -->
                    <TextBlock Grid.Row="2" Text="Open Source • Zero Telemetria" FontSize="10" Foreground="#8B949E" HorizontalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- COLUNA DIREITA: WIZARD DE INSTALAÇÃO -->
            <Grid Grid.Column="1" Margin="30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- CABEÇALHO DIREITO -->
                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <TextBlock x:Name="TxtTituloCabecalho" Text="Instalação do Aplicativo" FontSize="22" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                    <TextBlock x:Name="TxtSubtituloCabecalho" Text="Bem-vindo ao setup do GigaDock (x64)." FontSize="13" Foreground="#8B949E" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- PAINÉIS DE CONTEÚDO (WIZARD) -->
                <Grid Grid.Row="1">
                    <!-- 1. MODO INSTALAÇÃO: ETAPA INICIAL (OPÇÕES) -->
                    <StackPanel x:Name="PanelOpcoesInstalacao" Visibility="Visible">
                        <TextBlock x:Name="TxtDescricaoAcao" Text="O aplicativo será instalado no seu perfil local para máxima segurança, sem exigir privilégios de administrador."
                                   TextWrapping="Wrap" FontSize="12" Foreground="#C9D1D9" Margin="0,0,0,16"/>

                        <!-- Pasta de Instalação -->
                        <TextBlock Text="Diretório de instalação" FontSize="11" FontWeight="Bold" Foreground="#8B949E" Margin="0,0,0,6"/>
                        <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,16">
                            <TextBlock x:Name="TxtCaminhoDestino" Text="C:\Users\...\AppData\Local\GigaDock" FontSize="12" Foreground="#58A6FF" TextTrimming="CharacterEllipsis"/>
                        </Border>

                        <!-- Opções -->
                        <TextBlock Text="Opções de atalho" FontSize="11" FontWeight="Bold" Foreground="#8B949E" Margin="0,0,0,6"/>
                        <CheckBox x:Name="ChkAtalhoIniciar" Content="Criar atalho no Menu Iniciar" IsChecked="True"/>
                        <CheckBox x:Name="ChkAtalhoDesktop" Content="Criar atalho na Área de Trabalho" IsChecked="True"/>
                        <CheckBox x:Name="ChkIniciarComWindows" Content="Iniciar GigaDock com o Windows" IsChecked="True" Margin="0,4,0,16"/>

                    </StackPanel>

                    <!-- 2. MODO INSTALAÇÃO / DESINSTALAÇÃO: ETAPA PROGRESSO -->
                    <StackPanel x:Name="PanelProgresso" Visibility="Collapsed" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtStatusProgresso" Text="Configurando ambiente..." FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16" HorizontalAlignment="Center"/>
                        <ProgressBar x:Name="BarraProgresso" IsIndeterminate="True" Height="6" Margin="40,0,40,16" Foreground="#0A84FF" Background="#21262D" BorderThickness="0"/>
                        <TextBlock x:Name="TxtDetalheProgresso" Text="Copiando arquivos..." FontSize="12" Foreground="#8B949E" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- 3. MODO INSTALAÇÃO: ETAPA CONCLUÍDO -->
                    <StackPanel x:Name="PanelConcluido" Visibility="Collapsed" VerticalAlignment="Center">
                        <Border Width="64" Height="64" CornerRadius="32" Background="#238636" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE73E;" FontSize="28" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="TxtTituloConcluido" Text="Tudo Pronto!" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock x:Name="TxtSubtituloConcluido" Text="GigaDock 2.0 foi instalado com sucesso e já está configurado na sua máquina."
                                   FontSize="13" Foreground="#8B949E" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,24"/>

                        <CheckBox x:Name="ChkExecutarAgora" Content="Lançar o GigaDock agora" IsChecked="True" HorizontalAlignment="Center" FontSize="14"/>
                    </StackPanel>

                    <!-- 4. MODO DESINSTALAÇÃO: CONFIRMAÇÃO -->
                    <StackPanel x:Name="PanelDesinstalacao" Visibility="Collapsed">
                        <TextBlock Text="Desinstalação do GigaDock" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#FF7B72"/>
                        <TextBlock Text="Isso removerá o aplicativo e restaurará as configurações originais do Windows."
                                   TextWrapping="Wrap" FontSize="12" Foreground="#C9D1D9" Margin="0,0,0,20"/>

                        <Border Background="#3b1d1e" BorderBrush="#F85149" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Restauração Garantida" FontWeight="Bold" FontSize="12" Foreground="#FF7B72"/>
                                <TextBlock Text="A barra de tarefas nativa será religada imediatamente se estiver oculta."
                                           FontSize="11" Foreground="#FFC1C0" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <CheckBox x:Name="ChkRemoverDadosPessoais"
                                  Content="Excluir configurações e ambientes (Limpeza total)"
                                  IsChecked="False" Foreground="#FF7B72"/>
                    </StackPanel>
                </Grid>

                <!-- RODAPÉ COM BOTÕES -->
                <Grid Grid.Row="2" Margin="0,16,0,0">
                    <!-- Botão Invisível para Fechar na Esquerda (útil em setups window-none) -->
                    <Button Content="Sair" Click="BtnSair_Click" Background="Transparent" Foreground="#8B949E" HorizontalAlignment="Left"/>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnCancelar" Content="Cancelar" Click="BtnCancelar_Click"
                                Background="#21262D" Foreground="#C9D1D9" Margin="0,0,10,0"/>
                        <Button x:Name="BtnAcaoPrincipal" Content="Instalar" Click="BtnAcaoPrincipal_Click"
                                Background="#238636" Foreground="#FFFFFF"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>




