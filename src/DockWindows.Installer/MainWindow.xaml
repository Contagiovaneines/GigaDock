<Window x:Class="DockWindows.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Instalador do GigaDock"
        Width="580"
        Height="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#18181A"
        Foreground="#FFFFFF"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,6"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- Cabeçalho -->
            <RowDefinition Height="Auto"/>
            <!-- Conteúdo Central -->
            <RowDefinition Height="*"/>
            <!-- Rodapé com Botões -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- CABEÇALHO -->
        <Border Grid.Row="0" BorderBrush="#2C2C32" BorderThickness="0,0,0,1" Padding="0,0,0,16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Width="44" Height="44" CornerRadius="12" Background="#0A84FF" Margin="0,0,14,0" VerticalAlignment="Center">
                    <TextBlock Text="🚀" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTituloCabecalho" Text="GigaDock — Assistente de Instalação" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock x:Name="TxtSubtituloCabecalho" Text="Versão 1.4.0 (Windows 10/11 x64)" FontSize="12" Foreground="#8E8E93" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- PAINÉIS DE CONTEÚDO (WIZARD) -->
        <Grid Grid.Row="1">
            <!-- 1. MODO INSTALAÇÃO: ETAPA INICIAL (OPÇÕES) -->
            <StackPanel x:Name="PanelOpcoesInstalacao" Visibility="Visible">
                <TextBlock x:Name="TxtTituloAcao" Text="Instalação do Aplicativo" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#0A84FF"/>
                <TextBlock x:Name="TxtDescricaoAcao" Text="O GigaDock será instalado localmente no perfil do seu usuário sem exigir privilégios de administrador."
                           TextWrapping="Wrap" FontSize="12" Foreground="#C8C8CE" Margin="0,0,0,12"/>

                <!-- Pasta de Instalação -->
                <TextBlock Text="Pasta de instalação:" FontSize="12" Foreground="#8E8E93" Margin="0,0,0,4"/>
                <Border Background="#202026" BorderBrush="#33333E" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,12">
                    <TextBlock x:Name="TxtCaminhoDestino" Text="C:\Users\..." FontSize="12" Foreground="#58A6FF" TextTrimming="CharacterEllipsis"/>
                </Border>

                <!-- Opções de Atalhos -->
                <CheckBox x:Name="ChkAtalhoIniciar" Content="Criar atalho no Menu Iniciar" IsChecked="True"/>
                <CheckBox x:Name="ChkAtalhoDesktop" Content="Criar atalho na Área de Trabalho" IsChecked="True"/>
                <CheckBox x:Name="ChkIniciarComWindows" Content="Iniciar automaticamente com o Windows" IsChecked="False"/>

                <!-- Card de Informação sobre Assinatura e Substituição -->
                <Border Background="#1C2430" BorderBrush="#1F4268" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="ℹ️ Informações Importantes" FontWeight="Bold" FontSize="12" Foreground="#58A6FF"/>
                        <TextBlock Text="• O modo de substituição da barra de tarefas é desativado por padrão."
                                   FontSize="11" Foreground="#A8C0DE" Margin="0,2,0,0"/>
                        <TextBlock Text="• Sem certificado comercial pago (projeto independente). Não envia telemetria e armazena 100% dos dados localmente."
                                   FontSize="11" Foreground="#A8C0DE" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 2. MODO INSTALAÇÃO / DESINSTALAÇÃO: ETAPA PROGRESSO -->
            <StackPanel x:Name="PanelProgresso" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock x:Name="TxtStatusProgresso" Text="Executando..." FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12" HorizontalAlignment="Center"/>
                <ProgressBar x:Name="BarraProgresso" IsIndeterminate="True" Height="8" Margin="20,0,20,16" Foreground="#0A84FF" Background="#26262E"/>
                <TextBlock x:Name="TxtDetalheProgresso" Text="Por favor, aguarde alguns instantes..." FontSize="12" Foreground="#8E8E93" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- 3. MODO INSTALAÇÃO: ETAPA CONCLUÍDO -->
            <StackPanel x:Name="PanelConcluido" Visibility="Collapsed" VerticalAlignment="Center">
                <Border Width="50" Height="50" CornerRadius="25" Background="#1C3829" HorizontalAlignment="Center" Margin="0,0,0,12">
                    <TextBlock Text="✓" FontSize="26" FontWeight="Bold" Foreground="#30D158" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="TxtTituloConcluido" Text="Instalação Concluída com Sucesso!" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock x:Name="TxtSubtituloConcluido" Text="O GigaDock já está pronto para uso com os ambientes Trabalho, Estudos e Pessoal."
                           FontSize="12" Foreground="#8E8E93" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,16"/>

                <CheckBox x:Name="ChkExecutarAgora" Content="Executar o GigaDock agora" IsChecked="True" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- 4. MODO DESINSTALAÇÃO: CONFIRMAÇÃO -->
            <StackPanel x:Name="PanelDesinstalacao" Visibility="Collapsed">
                <TextBlock Text="Desinstalação do Aplicativo" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#FF453A"/>
                <TextBlock Text="Esta operação removerá o GigaDock e todos os seus atalhos deste computador."
                           TextWrapping="Wrap" FontSize="12" Foreground="#C8C8CE" Margin="0,0,0,14"/>

                <!-- Card de Segurança da Barra de Tarefas -->
                <Border Background="#2A1B1D" BorderBrush="#502427" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="🛡️ Restauração da Barra do Windows Garantida" FontWeight="Bold" FontSize="12" Foreground="#FF453A"/>
                        <TextBlock Text="Se o modo de substituição da barra de tarefas esteve ativo, a barra nativa do Windows será restaurada automaticamente durante a desinstalação."
                                   FontSize="11" Foreground="#E0A5A8" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <CheckBox x:Name="ChkRemoverDadosPessoais"
                          Content="Excluir também minhas preferências e configurações pessoais"
                          IsChecked="False"/>
                <TextBlock Text="Se desmarcado, seus ambientes e itens personalizados serão preservados caso decida reinstalar no futuro."
                           FontSize="11" Foreground="#8E8E93" Margin="24,0,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>

        <!-- RODAPÉ COM BOTÕES -->
        <Border Grid.Row="2" BorderBrush="#2C2C32" BorderThickness="0,1,0,0" Padding="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnCancelar" Content="Cancelar" Click="BtnCancelar_Click"
                        Background="#26262E" Foreground="#FFFFFF" Margin="0,0,10,0"/>
                <Button x:Name="BtnAcaoPrincipal" Content="Instalar" Click="BtnAcaoPrincipal_Click"
                        Background="#0A84FF" Foreground="#FFFFFF"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

