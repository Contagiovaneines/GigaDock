<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>DockWindows-Setup</AssemblyName>
    <RootNamespace>DockWindows.Installer</RootNamespace>
    <Version>1.4.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DockWindows.Core\DockWindows.Core.csproj" />
    <ProjectReference Include="..\DockWindows.Infrastructure\DockWindows.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\app.zip" Condition="Exists('Resources\app.zip')" />
  </ItemGroup>

</Project>
